# PromptHouse Evo Studio — Production Environment
# Copy to .env and fill in your values

# ── Required ──
# NODE_ENV=production  # Vite automatically configures NODE_ENV during build/dev; do not set here to avoid warnings
PORT=3001
JWT_SECRET=change-me-to-a-random-string

# ── AI Provider ──
OPENAI_API_KEY=sk-...

# ── Commerce (optional) ──
STRIPE_SECRET_KEY=sk_live_...

# ── Deployment (optional) ──
VERCEL_TOKEN=...

# ── CORS Origins ──
# Comma-separated list of allowed frontend origins
# Example: https://prompthouse-evo-studio.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Auth (Phase C — Clerk) ──
# CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...

# ── Database ──
# DATA_DIR=/data  (for Render disk mount)
