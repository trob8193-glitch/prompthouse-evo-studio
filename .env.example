# ==========================================
# PROMPTHOUSE EVO STUDIO - PRODUCTION SECRETS
# Copy this file to .env and fill in values
# ==========================================

# NODE_ENV=production  # Vite automatically configures NODE_ENV during build/dev; do not set here to avoid warnings
BRIDGE_PORT=3001
ALLOWED_ORIGINS=https://your-frontend-domain.com
REQUIRE_AUTH=true
RATE_LIMIT_MAX=150

# 2. Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
JWT_SECRET=your_super_secret_jwt_key_here

# 3. Monetization (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 4. AI Engine Providers
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...

# 5. Edge Database (Turso / libSQL)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_token

# 6. Global Config
PH_EVO_MASTER_KEY=your_admin_master_key
