# PH Evo Studio — Environment Variables
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to version control!

# ── Bridge Server ────────────────────────────────────────────
BRIDGE_URL=http://127.0.0.1:3001
VITE_BRIDGE_URL=http://127.0.0.1:3001
BRIDGE_PORT=3001

# ── Authentication ───────────────────────────────────────────
PH_EVO_MASTER_KEY=your-master-key-here
JWT_SECRET=your-jwt-secret-here
STUDIO_GATEWAY_KEY=your-gateway-key-here
TRIBRAIN_APPROVAL_TOKEN=your-approval-token-here
REQUIRE_AUTH_MUTATIONS=true
PH_ENTERPRISE_LICENSE_KEY=your-license-key-here

# ── AI Provider Keys ────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=your-gemini-key-here

# ── Stripe (Commerce) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key-here

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Deployment ───────────────────────────────────────────────
DEPLOY_TARGET=local
DEPLOY_ALLOW_PRODUCTION=false
PH_EVO_LOCAL=false

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
