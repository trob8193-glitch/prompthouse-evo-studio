# ══════════════════════════════════════════════════════════════
# PROMPTHOUSE EVO STUDIO — COMPLETE ENVIRONMENT REFERENCE
# Copy this file to .env and fill in values
# Generated from full codebase scan: 110 variables across 1,007 files
# ══════════════════════════════════════════════════════════════

# ─── 1. CORE SERVER ──────────────────────────────────────────
# NODE_ENV=production        # Vite auto-sets this; do not set manually to avoid warnings
BRIDGE_PORT=3001             # PromptBridge server port (10 files)
BRIDGE_URL=http://127.0.0.1:3001  # Bridge URL for internal services (5 files)
HOST=0.0.0.0                # Server bind host
PORT=3001                   # Alias for BRIDGE_PORT
IS_BRIDGE_SERVER=true       # Flag to identify bridge server process (3 files)
CORS_ORIGINS=http://localhost:5173  # Comma-separated allowed origins (7 files)
CORS_CREDENTIALS=true       # Allow credentials in CORS
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── 2. AUTHENTICATION ───────────────────────────────────────
REQUIRE_AUTH=false           # Enable auth gate on API routes
REQUIRE_AUTH_MUTATIONS=false # Enable auth on mutation-only routes
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
JWT_SECRET=your_super_secret_jwt_key_here  # (5 files)
JWT_EXPIRES_IN=7d           # JWT token expiry duration
PH_EVO_MASTER_KEY=your_admin_master_key    # (7 files)
PH_EVO_PERSONAL_KEY=        # Personal API key for owner operations
PH_EVO_API_KEY=             # Evo platform API key (2 files)
PH_EVO_APPROVAL_REF=        # Approval reference token (4 files)
EVO_APPROVAL_TOKEN=         # Daemon approval token

# ─── 3. AI ENGINE PROVIDERS ──────────────────────────────────
OPENAI_API_KEY=sk-proj-...  # (43 files — primary AI provider)
OPENAI_MODEL=gpt-4o         # Default OpenAI model (7 files)
OPENAI_BUILD_MODEL=gpt-4o   # Model used for code generation builds
OPENAI_TIMEOUT=30000        # OpenAI request timeout in ms
GEMINI_API_KEY=AIzaSy...    # Google Gemini API key (8 files)
ANTHROPIC_API_KEY=sk-ant-...  # Anthropic Claude API key (6 files)

# ─── 4. LOCAL AI (OLLAMA) ────────────────────────────────────
OLLAMA_DAEMON_ACTIVE=true   # Enable Ollama hardware daemon (4 files)
SIMULATE_OLLAMA_OFFLINE=false  # Simulate Ollama being offline (testing)
SIMULATE_EVO_OFFLINE=false  # Simulate Evo network being offline (testing)

# ─── 5. MONETIZATION (STRIPE) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...   # (20 files)
STRIPE_WEBHOOK_SECRET=whsec_...
PROMPTHOUSE_PUBLIC_KEY=         # Public key for client-side Stripe (3 files)
PROMPTHOUSE_BILLING_PUBLIC_KEY= # Billing-specific public key (2 files)

# ─── 6. DATABASE ─────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_token
DB_PATH=.prompthouse-data/studio.db  # Local SQLite path
DB_VERBOSE=false            # Enable database query logging
DATA_DIR=.prompthouse-data  # Data directory for all local state

# ─── 7. DEPLOYMENT ───────────────────────────────────────────
VERCEL_TOKEN=               # Vercel deploy token (7 files)
DEPLOY_TARGET=preview       # Deploy target: preview | production
DEPLOY_ALLOW_PRODUCTION=false  # Safety gate for production deploys (7 files)
PUBLIC_APP_URL=https://your-app.vercel.app
VITE_PUBLIC_APP_URL=https://your-app.vercel.app
APP_BASE_URL=http://localhost:5173
APP_URL=http://localhost:5173

# ─── 8. FRONTEND ─────────────────────────────────────────────
VITE_BRIDGE_URL=http://localhost:3001  # Bridge URL for Vite frontend (6 files)
PROMPTBRIDGE_URL=http://localhost:3001
PROMPTENDS_BASE_URL=http://localhost:3001
VITE_PROMPTENDS_BASE_URL=http://localhost:3001
EVO_STUDIO_URL=http://localhost:5173

# ─── 9. AGENT MESH ───────────────────────────────────────────
AGENT_ID=                   # Unique agent identifier (5 files)
SWARM_IDS=                  # Comma-separated swarm agent IDs (3 files)
EVO_NETWORK_ALIAS=          # Network alias for this Evo instance
EVO_API_URL=http://localhost:3001  # Evo API endpoint (2 files)

# ─── 10. GLOBAL EVO HUB ──────────────────────────────────────
GLOBAL_EVO_HUB_URL=         # Central Evo Hub URL (2 files)
GLOBAL_EVO_HUB_TOKEN=       # Auth token for Evo Hub (2 files)

# ─── 11. EXTERNAL SERVICES ───────────────────────────────────
GITHUB_TOKEN=               # GitHub API token (2 files)
RIFT_URL=                   # Rift service URL
SOCIAL_WEBHOOK_URL=         # Social media webhook
X_API_KEY=                  # X/Twitter API key
TWITTER_BEARER_TOKEN=       # Twitter bearer token
RESEND_API_KEY=             # Resend email API key
SENDGRID_API_KEY=           # SendGrid email API key

# ─── 12. EVO LLM TRAINING ────────────────────────────────────
EVO_LLM_PROVIDER=ollama     # LLM provider: ollama | openai | gemini
EVO_LLM_BASE_MODEL=qwen3.6 # Base model for Evo LLM (2 files)
EVO_LLM_SIMULATE_TRAINING=false  # Simulate training without real calls
EVO_LLM_ALLOW_PROVIDER_TRAINING=false  # Allow provider-side training
EVO_LLM_MAX_TRAINING_BUDGET_USD=0  # Max training spend in USD

# ─── 13. RATE LIMITING ───────────────────────────────────────
RATE_LIMIT_MAX=150          # Max requests per window
RATE_LIMIT_ENABLED=true     # Enable rate limiting
RATE_LIMIT_MAX_REQUESTS=150 # Alias
RATE_LIMIT_WINDOW_MS=60000  # Rate limit window in ms

# ─── 14. LOGGING ─────────────────────────────────────────────
LOG_LEVEL=info              # Log level: debug | info | warn | error
LOG_FORMAT=json             # Log format: json | text

# ─── 15. FEATURE FLAGS ───────────────────────────────────────
FEATURE_DB=true             # Enable database features
FEATURE_AGENT=true          # Enable agent features
FEATURE_EXECUTION=true      # Enable code execution
FEATURE_MOBILE=true         # Enable mobile features

# ─── 16. DAEMON INTERVALS ────────────────────────────────────
HOLDING_COMPANY_INTERVAL_MS=300000   # Holding company daemon interval (5 min)
HOLDING_COMPANY_RUN_ONCE=false       # Run holding company daemon once then exit
LEAD_INTERVAL_MS=300000              # Lead generation daemon interval
LEADGEN_RUN_ONCE=false
MARKETING_INTERVAL_MS=300000         # Marketing daemon interval
MARKETING_RUN_ONCE=false
MOBILE_DAEMON_INTERVAL_MS=300000     # Mobile daemon interval
MOBILE_DAEMON_RUN_ONCE=false
SEED_DAEMON_INTERVAL_MS=300000       # Seed round daemon interval
SEED_DAEMON_RUN_ONCE=false
INVENTION_RUN_ONCE=false             # Self-invention daemon run once

# ─── 17. SIGNALS & CONNECTORS ────────────────────────────────
EVO_SIGNAL_TIMEOUT_MS=5000  # Signal timeout
EVO_SIGNAL_LEARNING_LIMIT=1000  # Max signal learning entries
EVO_SIGNAL_BOND_FILE=.prompthouse-data/signal_bond.json
EVO_APP_INTELLIGENCE_LIMIT=500  # App intelligence record limit (2 files)
EVO_WORK_MEMORY_LIMIT=100  # Work memory entry limit
PH_CONNECTOR_LIVE_SCOPES=   # Connector live scopes
PH_CONNECTOR_TIMEOUT_MS=5000  # Connector timeout
PH_PROVIDER_LIVE_SCOPE=     # Provider live scope (2 files)
PH_PROVIDER_LIVE_APPROVAL=  # Provider live approval (2 files)
PH_PROVIDER_LIVE_RECEIPT=   # Provider live receipt (2 files)
PH_BRIDGE_AUDIT_URL=        # Bridge audit URL
PH_ALLOW_NUCLEAR_EVOLUTION=false  # Allow nuclear evolution cycles
PH_NUCLEAR_EVOLUTION_COUNT=3     # Max nuclear evolution iterations

# ─── 18. MOBILE / SHELL ──────────────────────────────────────
PROMPTSHELL_DEVICE_ID=      # PromptShell device identifier
FLUTTER_DEVICE_ID=          # Flutter device ID
PROMPTSHELL_DEVICE_PROOF=   # Device proof hash
FLUTTER_DEVICE_PROOF=       # Flutter device proof hash
EVO_DESKTOP_SKIP_BRIDGE=false  # Skip bridge connection in desktop mode

# ─── 19. AUDIT DAEMON ────────────────────────────────────────
AUDIT_DAEMON_INTERVAL_MS=300000  # Audit daemon cycle interval (5 min)
AUDIT_DAEMON_RUN_ONCE=false      # Run audit daemon once then exit
