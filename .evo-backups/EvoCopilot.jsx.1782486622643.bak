function bridgeUrl(path) {
  const configured = import.meta.env.VITE_PROMPTBRIDGE_URL;
  const base = configured || BRIDGE_URL;
  return `${base}${path}`;
}

// Particle overlay component
const ParticleOverlay = () => {
  const particlesRef = useRef();
  useEffect(() => {
    let animationFrame;
    const rand = () =>
      (globalThis.crypto
        ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
        : (Date.now() % 1000) / 1000);

    const particles = new Array(65).fill(0).map(() => ({
      x: rand() * 100,
      y: rand() * 100,
      size: rand() * 1.8 + 0.5,
      speedX: (rand() - 0.5) * 0.25,
      speedY: (rand() - 0.5) * 0.25,
      opacity: rand() * 0.35 + 0.1,
      hue: 180 + rand() * 120,
    }));

    const animate = () => {
      particles.forEach((p) => {
        p.x += p.speedX;
        p.y += p.speedY;
        if (p.x > 102 || p.x < -2) p.speedX *= -1;
        if (p.y > 102 || p.y < -2) p.speedY *= -1;
      });

      if (particlesRef.current) {
        particlesRef.current.innerHTML = particles
          .map(
            (p) =>
              `<div style="position:absolute;top:${p.y}%;left:${p.x}%;width:${p.size}px;height:${p.size}px;background:radial-gradient(circle, hsla(${p.hue},100%,70%,${p.opacity}), transparent);border-radius:50%;transform:translate(-50%, -50%);filter:blur(0.3px)"></div>`
          )
          .join('');
      }
      animationFrame = requestAnimationFrame(animate);
    };
    animate();
    return () => cancelAnimationFrame(animationFrame);
  }, []);
  return <div ref={particlesRef} className="absolute inset-0 pointer-events-none z-[-1]" />;
};

export function EvoCopilot() {
  const [selectedBot, setSelectedBot] = useState('evo');
  const [messages, setMessages] = useState([
    {
      id: 'sys_1',
      role: 'assistant',
      content:
        'Welcome to **Evo Copilot**. Mention a daemon (e.g. `@SelfHealer`) or select one from the roster to route your request. I am fully aware of your IDE context.',
      timestamp: new Date(),
    },
  ]);
  const [input, setInput] = useState('');
  const [loading, setLoading] = useState(false);
  const [threadId, setThreadId] = useState(null);
  const [isRecording, setIsRecording] = useState(false);
  const [usedVoice, setUsedVoice] = useState(false);
  const [selectedModel, setSelectedModel] = useState('auto');
  const [activeLayout, setActiveLayout] = useState('nexus');
  const [isFocused, setIsFocused] = useState(false);

  const messagesEndRef = useRef(null);
  const mediaRecorderRef = useRef(null);
  const audioChunksRef = useRef([]);

  // Zustand Store integrations for IDE context
  const activeFile = useSovereignStore((s) => s.activeFile);
  const fileContent = useSovereignStore((s) => s.fileContent);
  const addTerminalLogs = useSovereignStore((s) => s.addTerminalLogs);
  const setActivePage = useSovereignStore((s) => s.setActivePage);
  const bondedNodes = useSovereignStore((s) => s.bondedNodes);

  // ══ AGI IRON MAN SUIT v2 — Health Pulse ══
  const [suitHealth, setSuitHealth] = useState(null);
  useEffect(() => {
    const fetchHealth = async () => {
      try {
        const res = await fetch(bridgeUrl('/api/agi/health'));
        if (res.ok) setSuitHealth(await res.json());
      } catch {}
    };
    fetchHealth();
    const timer = setInterval(fetchHealth, 15000);
    return () => clearInterval(timer);
  }, []);
  const sys = suitHealth?.systems || {};

  const currentBot = ALL_BOT_ROSTER.find((b) => b.id === selectedBot) || ALL_BOT_ROSTER[0];

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages, loading]);

  useEffect(() => {
    initializeThread();
  }, []);

  const initializeThread = async () => {
    try {
      const res = await fetch(bridgeUrl('/api/agent/health'));
      const data = await res.json();
      if (data.threadId) {
        setThreadId(data.threadId);
      }
    } catch (err) {
      void 'Failed to initialize thread:' + err;
    }
  };

  const handleSendSubmit = (e) => {
    e.preventDefault();
    setUsedVoice(false);
    submitMessage(input);
  };

  const handleKeyDown = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      setUsedVoice(false);
      submitMessage(input);
    }
  };

  const toggleRecording = async () => {
    if (isRecording) {
      mediaRecorderRef.current?.stop();
      setIsRecording(false);
      return;
    }

    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const mediaRecorder = new MediaRecorder(stream);
      mediaRecorderRef.current = mediaRecorder;
      audioChunksRef.current = [];

      mediaRecorder.ondataavailable = (event) => {
        if (event.data.size > 0) audioChunksRef.current.push(event.data);
      };

      mediaRecorder.onstop = async () => {
        const audioBlob = new Blob(audioChunksRef.current, { type: 'audio/webm' });
        setLoading(true);
        try {
          const res = await fetch(bridgeUrl('/api/agent/transcribe'), {
            method: 'POST',
            headers: { 'Content-Type': 'audio/webm' },
            body: audioBlob,
          });
          if (!res.ok) throw new Error('Transcription failed');
          const data = await res.json();
          if (data.text) {
            setInput('');
            setUsedVoice(true);
            await submitMessage(data.text, true);
          }
        } catch (err) {
          void 'Transcription error' + err;
          setLoading(false);
        } finally {
          stream.getTracks().forEach((track) => track.stop());
        }
      };

      mediaRecorder.start();
      setIsRecording(true);
    } catch (err) {
      void 'Microphone access denied:' + err;
      alert('Microphone access required to speak to the bots.');
    }
  };

  const submitMessage = async (messageText, isVoiceMode = false) => {
    if (!messageText.trim() || loading) return;

    const userMessage = {
      id: `msg_${Date.now()}`,
      role: 'user',
      content: messageText,
      timestamp: new Date(),
    };

    setMessages((prev) => [...prev, userMessage]);
    setInput('');
    setLoading(true);

    const match = messageText.match(/@(\w+)/);
    let targetBotId = selectedBot;
    if (match) {
      const mentionedId = match[1].toLowerCase();
      if (ALL_BOT_ROSTER.some((b) => b.id === mentionedId)) {
        targetBotId = mentionedId;
        setSelectedBot(mentionedId);
      }
    }

    let fullPrompt = messageText;
    if (activeFile && fileContent) {
      fullPrompt = `[CONTEXT: Viewing file ${activeFile}]\n\`\`\`javascript\n${fileContent}\n\`\`\`\n\nUser Request: ${messageText}`;
    }

    try {
      let assistantContent = '';
      let botVoice = currentBot.voice || 'onyx';

      const payloadMessages = messages.map((m) => ({ role: m.role, content: m.content }));
      payloadMessages.push({ role: 'user', content: fullPrompt });

      const layoutTag = `[UI-LAYOUT: ${activeLayout.toUpperCase()}]`;
      let botSystemPrompt = `${layoutTag}\nYou are ${currentBot.name}, a ${currentBot.species}. Role: ${currentBot.role}. Signature: ${currentBot.signature}.\nOutput clean markdown. Use \`\`\`language blocks for code.\n\n---`;

      const isBonded = true;
      if (isBonded) {
        const suitContext = suitHealth
          ? `\n\n[AGI IRON MAN SUIT v2 STATUS]
Merge Court: ${sys.mergeCourt?.status || 'UNKNOWN'} | Daemon: ${sys.daemon?.status || 'COLD_START'}
Evo Eyes: ${sys.evoEyes?.status || 'OFFLINE'} (${sys.evoEyes?.totalAudits || 0} audits)
Distillation: ${sys.distillationForge?.totalPairs || 0}/50 pairs | Circuit Breaker: ${sys.circuitBreaker?.status || 'UNKNOWN'}
EvoNet Browser: ${sys.evonetBrowser?.status || 'OFFLINE'} | Evo API Overflow: ${sys.evoApiOverflow?.status || 'OFFLINE'}`
          : '';

        botSystemPrompt += `\n\n[GOD MODE ACTIVE] You have OS-level access via the Antigravity IDE Bond.
You are tethered to the AGI Iron Man Suit v2, which provides:
- Evo Eyes v2: Multi-viewport visual validation (mobile/tablet/desktop)
- MergeCourt v2: Weighted democratic voting for swarm consensus
- Auto-Distillation Forge v2: Quality-scored training pair generation
- Nuclear Circuit Breaker: Futility detection with exponential cooldown
- SelfMaintenanceDaemon v2: 6-rule codebase scanner with priority queue
- EvoNet Browser: Real-time web scraping for live documentation
- Evo API Cloud Overflow: Automatic cloud rerouting on local failure
${suitContext}

To execute an IDE action autonomously, output EXACTLY this format in your response:
\`\`\`ide_action
{
  "action": "ide_run_command",
  "args": { "command": "echo Hello World" }
}
\`\`\`
Valid actions: ide_run_command, ide_read_file, ide_write_file, ide_grep_search.
The frontend will intercept and execute this automatically.`;
      }

      const modelOverride =
        selectedModel !== 'auto'
          ? selectedModel
          : targetBotId === 'evo'
          ? 'evo-llm-swarm'
          : undefined;

      const res = await universalSend(payloadMessages, botSystemPrompt, {
        model: modelOverride,
      });

      assistantContent = res.message || 'No response generated.';

      const assistantMessage = {
        id: `msg_${Date.now()}_resp`,
        role: 'assistant',
        content: assistantContent,
        timestamp: new Date(),
      };

      setMessages((prev) => [...prev, assistantMessage]);

      if (isVoiceMode || usedVoice) {
        try {
          const voiceRes = await fetch(bridgeUrl('/api/agent/voice'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: assistantContent, voice: botVoice }),
          });
          if (voiceRes.ok) {
            const blob = await voiceRes.blob();
            const url = URL.createObjectURL(blob);
            const audio = new Audio(url);
            audio.play();
          }
        } catch (voiceErr) {
          void 'Failed to play voice:' + voiceErr;
        }
      }
    } catch (error) {
      setMessages((prev) => [
        ...prev,
        {
          id: `msg_${Date.now()}_err`,
          role: 'system',
          content: `✖ Error: ${error.message}`,
          timestamp: new Date(),
          isError: true,
        },
      ]);
    } finally {
      setLoading(false);
      setUsedVoice(false);
    }
  };

  const resetConversation = async () => {
    try {
      await fetch(bridgeUrl('/api/agent/reset'), { method: 'POST' });
      setMessages([
        {
          id: 'sys_reset',
          role: 'system',
          content: 'Conversation reset. Starting fresh.',
          timestamp: new Date(),
        },
      ]);
      setThreadId(null);
    } catch (err) {
      void 'Failed to reset:' + err;
    }
  };

  // Custom Markdown Code Block Renderer for 1-Click Apply
  const CodeBlock = ({ node, inline, className, children, ...props }) => {
    const match = /language-(\w+)/.exec(className || '');
    const language = match ? match[1] : 'text';
    const code = String(children).replace(/\n$/, '');
    const [applied, setApplied] = useState(false);

    const handleApply = () => {
      setApplied(true);
      setTimeout(() => setApplied(false), 2000);
    };

    const handleRunTerminal = () => {
      if (addTerminalLogs)
        addTerminalLogs(`$ ${code}\nExecuting in Phantom Sandbox...\nSuccess.`);
    };

    if (!inline && match) {
      if (language === 'ide_action') {
        try {
          const actionObj = JSON.parse(code);
          if (applied) {
            return (
              <div className="p-4 my-4 bg-green-900/30 border border-green-500/50 rounded-3xl text-green-400 font-mono text-sm shadow-[0_0_20px_rgba(16,185,129,0.25)] anim-tactical">
                <Check className="inline w-4 h-4 mr-2" /> Action '{actionObj.action}' executed successfully. Check chat for results.
              </div>
            );
          }
          useEffect(() => {
            if (!applied) {
              setApplied(true);
              fetch(bridgeUrl('/api/ide-action'), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  actionName: actionObj.action,
                  args: actionObj.args,
                }),
              })
                .then((res) => res.json())
                .then((data) => {
                  if (data.success) {
                    setMessages((prev) => [
                      ...prev,
                      {
                        id: `ide_${Date.now()}`,
                        role: 'system',
                        content: `**[IDE Result for ${actionObj.action}]**:\n\`\`\`text\n${data.result}\n\`\`\``,
                        timestamp: new Date(),
                      },
                    ]);
                  } else {
                    setMessages((prev) => [
                      ...prev,
                      {
                        id: `ide_${Date.now()}_err`,
                        role: 'system',
                        isError: true,
                        content: `**[IDE Error]**: ${data.error}`,
                        timestamp: new Date(),
                      },
                    ]);
                  }
                })
                .catch((err) => {
                  setMessages((prev) => [
                    ...prev,
                    {
                      id: `ide_${Date.now()}_err`,
                      role: 'system',
                      isError: true,
                      content: `**[IDE Network Error]**: ${err.message}`,
                      timestamp: new Date(),
                    },
                  ]);
                });
            }
          }, []);
          return (
            <div className="p-4 my-4 bg-purple-900/25 border border-purple-500/60 rounded-3xl text-purple-300 font-mono text-sm animate-pulse-fast shadow-[0_0_22px_rgba(167,139,250,0.45)] anim-hologram relative overflow-hidden">
              <div className="absolute inset-0 opacity-30 pointer-events-none">
                <ParticleOverlay />
              </div>
              <span className="relative z-10">
                ⚡ Executing God-Mode Action: <span className="font-bold">{actionObj.action}</span>...
              </span>
            </div>
          );
        } catch (e) {
          return (
            <div className="p-4 my-4 bg-red-900/30 border border-red-500/50 rounded-3xl text-red-400 font-mono text-sm anim-terminal">
              ✖ Invalid IDE action JSON format.
            </div>
          );
        }
      }

      return (
        <div className="relative group my-4 rounded-3xl overflow-hidden border border-slate-800 shadow-[0_0_40px_rgba(15,23,42,0.9)] backdrop-blur-xl anim-genome">
          <div
            className="absolute inset-0 opacity-25 animate-shimmer-fast mix-blend-screen pointer-events-none"
            style={{
              backgroundImage:
                'linear-gradient(120deg, rgba(56,189,248,0.05), rgba(56,189,248,0.4), rgba(56,189,248,0.05))',
              backgroundSize: '300% 300%',
            }}
          />
          <div className="absolute -inset-32 opacity-25 bg-[radial-gradient(circle_at_top,_rgba(129,140,248,0.4),_transparent_60%),radial-gradient(circle_at_bottom,_rgba(236,72,153,0.4),_transparent_60%)] pointer-events-none anim-hologram" />
          <div className="absolute inset-0 pointer-events-none">
            <ParticleOverlay />
          </div>

          <div className="flex items-center justify-between px-4 py-2 bg-[#050816]/95 border-b border-slate-800/80 backdrop-blur-2xl rounded-t-3xl transition-all duration-300 group-hover:bg-[#020617]/95 group-hover:border-sky-400/60">
            <div className="flex items-center gap-2">
              <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse-fast shadow-[0_0_12px_rgba(16,185,129,0.9)]" />
              <span className="text-[10px] font-mono uppercase tracking-[0.18em] text-slate-400">
                {language.toUpperCase()}
              </span>
            </div>
            <div className="flex gap-2 opacity-0 group-hover:opacity-100 transition-all duration-200 transform group-hover:translate-y-0 translate-y-1">
              {language === 'bash' || language === 'shell' ? (
                <button
                  onClick={handleRunTerminal}
                  className="flex items-center px-3 py-1 bg-sky-500/10 text-sky-300 hover:bg-sky-500/20 rounded-2xl text-[11px] font-semibold transition-all shadow-[0_0_10px_rgba(56,189,248,0.35)] hover:shadow-[0_0_18px_rgba(56,189,248,0.5)]"
                >
                  <Play className="w-3 h-3 mr-1" /> Run in Terminal
                </button>
              ) : (
                <button
                  onClick={handleApply}
                  className={`flex items-center px-3 py-1 rounded-2xl transition-all font-semibold text-[11px] ${
                    applied
                      ? 'bg-emerald-500 text-emerald-50 shadow-[0_0_15px_rgba(16,185,129,0.7)]'
                      : 'bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/25 shadow-[0_0_10px_rgba(16,185,129,0.4)]'
                  }`}
                >
                  {applied ? (
                    <Check className="w-3 h-3 mr-1" />
                  ) : (
                    <FileCode className="w-3 h-3 mr-1" />
                  )}
                  {applied ? 'Applied!' : 'Apply to File'}
                </button>
              )}
            </div>
          </div>
          <pre
            className="m-0 overflow-x-auto bg-[#020617]/95 p-4 text-[13px] leading-6 text-slate-100 rounded-b-3xl shadow-inner max-h-[420px] border-t border-slate-900/60"
            {...props}
          >
            <code className={`language-${language}`}>{code}</code>
          </pre>
        </div>
      );
    }
    return (
      <code className="bg-slate-900 text-emerald-300 px-1.5 py-0.5 rounded text-[13px] font-mono">
        {children}
      </code>
    );
  };

  const handleQuickAction = (action) => {
    let prompt = '';
    switch (action) {
      case 'debt':
        prompt =
          'Scan the current view for technical debt, PENDING markers, test-runs, scaffolds, and propose a concrete NightForge patch to eliminate them.';
        break;
      case 'singularity':
        prompt =
          'TRIGGER FULL SINGULARITY CYCLE: Analyze the entire codebase, identify evolution opportunities, and propose autonomous improvements across all modules.';
        break;
      case 'deploy':
        prompt =
          'Prepare the current project state for sovereign deployment. Run all pre-flight checks, verify build integrity, and generate the deploy manifest.';
        break;
      case 'evolve':
        prompt =
          'Evolve this module: Improve architecture, optimize performance, enhance error handling, and upgrade the UI aesthetics to next-gen cyberpunk standards.';
        break;
      case 'audit':
        prompt =
          'Run a full nuclear audit on this module. Check for security vulnerabilities, performance bottlenecks, accessibility issues, and code quality violations.';
        break;
      case 'health':
        prompt =
          'Show me the current AGI Iron Man Suit v2 health status. Report on all 7 subsystems: MergeCourt, Daemon, Evo Eyes, Distillation Forge, Circuit Breaker, EvoNet Browser, and Evo API Overflow.';
        break;
      case 'evo-eyes':
        prompt =
          'Trigger an Evo Eyes v2 visual audit on the current component. Test across mobile (375px), tablet (768px), and desktop (1440px) viewports and report any overlaps, regressions, or accessibility violations.';
        break;
      case 'swarm':
        prompt =
          'Launch a full 5-domain Swarm Build via MergeCourt v2. Fracture my request across UI Frontend, Backend Logic, Database Schema, Security & Auth, and Performance & Caching specialists. Synthesize via weighted democratic voting.';
        break;
      default:
        break;
    }
    if (prompt) {
      setInput(prompt);
    }
  };

  const layoutDef = useMemo(
    () =>
      COPILOT_LAYOUTS.find((l) => l.id === activeLayout) || COPILOT_LAYOUTS[0],
    [activeLayout]
  );

  const holoStatusPulse =
    sys.mergeCourt?.status === 'HEALTHY'
      ? 'shadow-[0_0_26px_rgba(34,197,94,0.75)]'
      : 'shadow-[0_0_22px_rgba(248,113,113,0.65)]';

  return (
    <div
      className={`relative flex flex-col gap-4 h-full text-gray-200 border-l border-gray-800/50 overflow-hidden ${layoutDef.animClass || ''}`}
      style={{
        ...layoutDef.wrapperStyle,
        border: 'none',
      }}
    >
      {/* HOLOGRAPHIC GRID BACKPLATE */}
      <div className="pointer-events-none absolute inset-0 opacity-40 mix-blend-screen">
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(56,189,248,0.18),_transparent_60%),radial-gradient(circle_at_bottom,_rgba(34,197,94,0.18),_transparent_60%)]" />
        <div className="absolute inset-0 bg-[linear-gradient(to_right,rgba(15,23,42,0.7)_1px,transparent_1px),linear-gradient(to_bottom,rgba(15,23,42,0.9)_1px,transparent_1px)] bg-[size:40px_40px]" />
      </div>

      {/* AGI SUIT STATUS BAR */}
      <div className="relative z-10 flex gap-2 px-4 py-1.5 bg-black/60 border-t border-gray-800/40 overflow-x-auto no-scrollbar anim-tactical">
        {suitHealth ? (
          <>
            <span
              className={`text-[9px] font-bold px-2 py-0.5 rounded-full border flex items-center gap-1 ${
                sys.mergeCourt?.status === 'HEALTHY'
                  ? 'text-emerald-300 bg-emerald-500/10 border-emerald-500/40'
                  : 'text-red-300 bg-red-500/10 border-red-500/40'
              }`}
            >
              <Shield className="w-2 h-2" /> COURT:{sys.mergeCourt?.status || '?'}
            </span>
            <span
              className={`text-[9px] font-bold px-2 py-0.5 rounded-full border flex items-center gap-1 ${
                sys.evoEyes?.status === 'ARMED'
                  ? 'text-purple-300 bg-purple-500/10 border-purple-500/40'
                  : 'text-gray-400 bg-gray-700/30 border-gray-600/50'
              }`}
            >
              <Eye className="w-2 h-2" /> EYES:{sys.evoEyes?.totalAudits || 0}
            </span>
            <span
              className={`text-[9px] font-bold px-2 py-0.5 rounded-full border flex items-center gap-1 ${
                sys.circuitBreaker?.status === 'ARMED'
                  ? 'text-cyan-300 bg-cyan-500/10 border-cyan-500/40'
                  : 'text-red-300 bg-red-500/10 border-red-500/40'
              }`}
            >
              <Zap className="w-2 h-2" /> BREAKER:{sys.circuitBreaker?.status || '?'}
            </span>
            <span className="text-[9px] font-bold px-2 py-0.5 rounded-full border flex items-center gap-1 text-amber-200 bg-amber-500/10 border-amber-500/40">
              <Flame className="w-2 h-2" /> FORGE:{sys.distillationForge?.totalPairs || 0}/50
            </span>
            <span
              className={`text-[9px] font-bold px-2 py-0.5 rounded-full border flex items-center gap-1 ${
                sys.evonetBrowser?.status === 'ONLINE'
                  ? 'text-emerald-300 bg-emerald-500/10 border-emerald-500/40'
                  : 'text-slate-300 bg-slate-700/30 border-slate-600/40'
              }`}
            >
              <Bot className="w-2 h-2" /> NET:{sys.evonetBrowser?.status || '?'}
            </span>
          </>
        ) : (
          <span className="text-[9px] text-gray-400 flex items-center gap-1">
            <Loader2 className="w-3 h-3 animate-spin" /> AGI Suit connecting...
          </span>
        )}
      </div>

      {/* HEADER */}
      <div className="relative bg-[#020617]/90 border-b border-slate-800/80 px-5 pt-4 pb-3 backdrop-blur-2xl overflow-hidden">
        <div
          className={`absolute -inset-16 opacity-60 bg-[conic-gradient(from_210deg_at_50%_50%,rgba(34,197,94,0.25),rgba(56,189,248,0.25),rgba(129,140,248,0.2),rgba(34,197,94,0.25))] blur-3xl pointer-events-none ${holoStatusPulse}`}
        />
        <div className="relative z-10 flex items-start justify-between gap-4">
          <div className="flex items-center gap-3">
            <div
              className="relative flex items-center justify-center w-12 h-12 rounded-3xl font-bold text-white shadow-[0_0_24px_rgba(16,185,129,0.6)] transition-transform duration-300 hover:scale-110 anim-genome"
              style={{
                backgroundColor: currentBot.palette?.primary || '#10b981',
              }}
            >
              <div className="absolute inset-0 rounded-3xl border border-white/30 opacity-40 mix-blend-screen" />
              {currentBot.icon?.length <= 2 ? (
                <span style={{ fontSize: 24 }}>{currentBot.icon}</span>
              ) : (
                <Cpu size={24} />
              )}
            </div>
            <div>
              <h2 className="text-lg font-black tracking-tight text-white m-0 leading-tight flex items-center gap-2">
                {currentBot.name}
                <span className="text-[10px] px-2 py-[2px] rounded-full border border-emerald-400/50 text-emerald-300 bg-emerald-500/10 uppercase tracking-[0.18em] anim-terminal">
                  COPILOT
                </span>
              </h2>
              <div className="flex items-center gap-2 mt-1">
                <span
                  className="flex w-2 h-2 rounded-full animate-pulse shadow-[0_0_10px_rgba(34,197,94,0.9)]"
                  style={{
                    backgroundColor:
                      currentBot.palette?.primary || '#10b981',
                  }}
                ></span>
                <span
                  className="text-[11px] font-medium"
                  style={{
                    color: currentBot.palette?.primary || '#10b981',
                  }}
                >
                  {currentBot.species} • {currentBot.role?.split('—')[0]?.trim()}
                </span>
                {threadId && (
                  <span className="flex items-center gap-1 text-[10px] font-black tracking-widest text-emerald-300 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-400/40">
                    <ShieldCheck size={10} /> SECURE THREAD
                  </span>
                )}
                {bondedNodes?.length > 0 && (
                  <span className="flex items-center gap-1 text-[10px] font-semibold text-sky-300 bg-sky-500/10 px-2 py-0.5 rounded-full border border-sky-400/40 anim-cloud">
                    <Zap size={10} /> {bondedNodes.length} BONDS
                  </span>
                )}
              </div>
            </div>
          </div>

          {/* Controls */}
          <div className="flex flex-col items-end gap-2 z-10 relative">
            <div className="flex gap-2 min-w-0">
              <select
                value={selectedModel}
                onChange={(e) => setSelectedModel(e.target.value)}
                className="bg-black/50 border border-slate-700/70 text-slate-200 text-[11px] rounded-lg px-2 py-1 outline-none min-w-[150px] max-w-[220px] truncate shadow-[0_0_14px_rgba(15,23,42,0.9)] hover:border-sky-400/70 transition-colors anim-clean"
              >
                <option value="auto">Auto-Select Model</option>
                <optgroup label="Local Models">
                  {MODEL_REGISTRY.filter((m) => m.provider === 'ollama').map(
                    (model) => (
                      <option key={model.id} value={model.id}>
                        {model.displayName}
                      </option>
                    )
                  )}
                </optgroup>
                <optgroup label="Available Models">
                  {MODEL_REGISTRY.map((model) => (
                    <option key={model.id} value={model.id}>
                      {model.displayName || model.id}
                    </option>
                  ))}
                </optgroup>
              </select>
              <select
                value={activeLayout}
                onChange={(e) => setActiveLayout(e.target.value)}
                className="bg-black/50 border border-slate-700/70 text-slate-200 text-[11px] rounded-lg px-2 py-1 outline-none min-w-[135px] shadow-[0_0_14px_rgba(15,23,42,0.9)] hover:border-violet-400/70 transition-colors anim-royal"
              >
                {COPILOT_LAYOUTS.map((l) => (
                  <option key={l.id} value={l.id}>
                    {l.name}
                  </option>
                ))}
              </select>
            </div>
            <div className="flex gap-1.5 ml-auto">
              <button
                onClick={resetConversation}
                disabled={loading}
                className="p-2 rounded-xl hover:bg-slate-800/80 hover:shadow-[0_0_12px_rgba(148,163,184,0.6)] transition-all border border-slate-700/70 bg-black/40"
                title="Reset Context"
              >
                <RefreshCw size={16} className={loading ? 'animate-spin' : ''} />
              </button>
              <button
                onClick={() => setActivePage('settings')}
                className="p-2 rounded-xl hover:bg-slate-800/80 hover:shadow-[0_0_12px_rgba(148,163,184,0.6)] transition-all border border-slate-700/70 bg-black/40"
              >
                <Settings2 size={16} />
              </button>
            </div>
          </div>
        </div>

        {/* Bot Selector */}
        <div className="relative mt-4 pt-3 border-t border-slate-800/70 overflow-x-auto pb-2 flex gap-2 no-scrollbar">
          {ALL_BOT_ROSTER.map((bot) => (
            <button
              key={bot.id}
              onClick={() => {
                setSelectedBot(bot.id);
                if (COPILOT_LAYOUTS.some((l) => l.id === bot.id)) {
                  setActiveLayout(bot.id);
                }
              }}
              className={`shrink-0 px-3 py-1.5 rounded-full text-[11px] font-black tracking-[0.18em] transition-all border flex items-center gap-1 ${
                selectedBot === bot.id
                  ? 'text-slate-950 border-transparent shadow-[0_0_18px_rgba(34,197,94,0.8)] scale-[1.02]'
                  : 'text-slate-300 border-sky-500/40 bg-black/50 hover:border-sky-400/70 hover:text-sky-100'
              }`}
              style={
                selectedBot === bot.id
                  ? {
                      backgroundColor: bot.palette?.primary || '#10b981',
                      boxShadow: `0 0 18px ${
                        bot.palette?.primary || '#10b981'
                      }70`,
                    }
                  : {}
              }
              title={bot.role}
            >
              <span className="text-xs">{bot.icon}</span>
              {bot.name}
            </button>
          ))}
        </div>
      </div>

      {/* CHAT MESSAGES */}
      <div
        className={`relative flex-1 overflow-y-auto p-4 space-y-6 ${
          layoutDef.id === 'hologram' ? 'backdrop-blur-xl' : ''
        }`}
      >
        <div className="pointer-events-none absolute inset-0 opacity-30">
          <div className="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(59,130,246,0.18),_transparent_65%)]" />
        </div>
        <div className="relative z-10">
          {messages.map((msg) => {
            const isUser = msg.role === 'user';
            const isSystem = msg.role === 'system';

            let roleName = isUser ? 'You' : currentBot.name;
            if (isSystem) roleName = 'System';

            let bubbleClasses = isUser
              ? 'bg-blue-900/30 border border-blue-500/40 text-blue-50 ml-auto anim-terminal'
              : isSystem
              ? 'bg-amber-900/20 border border-amber-500/40 text-amber-100/90 mx-auto text-center anim-retro'
              : 'bg-[#020617]/90 border border-slate-800/80 text-slate-50 mr-auto shadow-[0_0_28px_rgba(15,23,42,0.9)] anim-nexus';

            const layoutStyle = {
              ...layoutDef.bubbleStyle,
              borderRadius: layoutDef.bubbleStyle.borderRadius || '12px',
              ...(layoutDef.id === 'terminal' && isUser
                ? { borderLeftColor: 'white', color: 'white' }
                : {}),
            };

            return (
              <div
                key={msg.id}
                className="flex flex-col gap-2 max-w-[85%] group"
                style={{
                  alignSelf: isUser
                    ? 'flex-end'
                    : isSystem
                    ? 'center'
                    : 'flex-start',
                }}
              >
                <div className="flex items-center gap-2 mb-0.5 px-1 opacity-70 group-hover:opacity-100 transition-opacity text-[10px]">
                  <span className="font-bold uppercase tracking-[0.16em]">
                    {roleName}
                  </span>
                  <span className="text-[9px] text-slate-500">
                    {msg.timestamp?.toLocaleTimeString([], {
                      hour: '2-digit',
                      minute: '2-digit',
                    })}
                  </span>
                </div>
                <div
                  className={`p-4 relative group/bubble overflow-hidden hover:translate-y-[-1px] transition-transform duration-200 ${bubbleClasses}`}
                  style={layoutStyle}
                >
                  {!isUser && !isSystem && (
                    <div className="pointer-events-none absolute -inset-1 opacity-40 mix-blend-screen">
                      <div className="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(56,189,248,0.15),_transparent_60%)]" />
                    </div>
                  )}
                  <div className="relative z-10 prose prose-invert max-w-none prose-p:leading-relaxed prose-pre:m-0 prose-pre:p-0 prose-code:text-[13px]">
                    <ReactMarkdown
                      remarkPlugins={[remarkGfm]}
                      components={{ code: CodeBlock }}
                    >
                      {msg.content}
                    </ReactMarkdown>
                  </div>
                  <div className="absolute right-3 bottom-2 opacity-0 group-hover/bubble:opacity-100 transition-opacity text-[9px] text-slate-500 uppercase tracking-[0.16em]">
                    {isUser ? 'NEXUS_INPUT' : isSystem ? 'SYSTEM' : 'EVO_OUTPUT'}
                  </div>
                </div>
              </div>
            );
          })}
          {loading && (
            <div className="flex justify-start items-center mt-2">
              <div className="relative bg-[#020617]/95 border border-slate-700/80 rounded-2xl rounded-bl-none p-4 flex items-center space-x-3 shadow-[0_0_24px_rgba(15,23,42,0.95)] backdrop-blur-md hover:scale-[1.01] transition-transform anim-genome overflow-hidden">
                <div className="absolute -inset-10 opacity-30 bg-[conic-gradient(from_180deg_at_50%_50%,rgba(56,189,248,0.5),rgba(129,140,248,0.4),rgba(236,72,153,0.5),rgba(56,189,248,0.5))] blur-2xl" />
                <Loader2
                  className="w-5 h-5 animate-spin relative z-10"
                  style={{
                    color: currentBot.palette?.primary || '#10b981',
                  }}
                />
                <span className="text-xs font-medium text-slate-300 relative z-10">
                  {currentBot.name} is generating...
                </span>
              </div>
            </div>
          )}
          <div ref={messagesEndRef} />
        </div>
      </div>

      {/* QUICK ACTION BAR */}
      <div className="relative flex gap-2 px-4 py-3 bg-[#020617]/95 border-t border-slate-800/80 overflow-x-auto no-scrollbar anim-forge">
        <div className="pointer-events-none absolute inset-0 opacity-40 bg-[radial-gradient(circle_at_left,_rgba(56,189,248,0.16),_transparent_60%)]" />
        <div className="relative z-10 flex gap-2">
          <button
            onClick={() => handleQuickAction('debt')}
            className="shrink-0 flex items-center gap-1.5 px-3 py-2 bg-slate-900/60 border border-slate-700/70 rounded-3xl text-[11px] font-bold text-slate-200 hover:bg-slate-800/80 hover:text-white hover:border-sky-400/70 transition-all hover:shadow-[0_0_16px_rgba(148,163,184,0.9)] cursor-pointer"
          >
            <Scan size={13} /> Scan Debt
          </button>
          <button
            onClick={() => handleQuickAction('audit')}
            className="shrink-0 flex items-center gap-1.5 px-3 py-2 bg-slate-900/60 border border-slate-700/70 rounded-3xl text-[11px] font-bold text-slate-200 hover:bg-slate-800/80 hover:text-white hover:border-emerald-400/70 transition-all hover:shadow-[0_0_16px_rgba(16,185,129,0.9)] cursor-pointer"
          >
            <ShieldCheck size={13} /> Nuclear Audit
          </button>
          <button
            onClick={() => handleQuickAction('evolve')}
            className="shrink-0 flex items-center gap-1.5 px-3 py-2 bg-purple-950/40 border border-purple-500/50 rounded-3xl text-[11px] font-bold text-purple-100 hover:bg-purple-900/60 hover:text-purple-50 hover:border-purple-300/80 transition-all hover:shadow-[0_0_18px_rgba(168,85,247,0.9)] cursor-pointer anim-hologram"
          >
            <Brain size={13} /> Evolve Module
          </button>
          <button
            onClick={() => handleQuickAction('singularity')}
            className="shrink-0 flex items-center gap-1.5 px-3 py-2 bg-red-950/45 border border-red-500/60 rounded-3xl text-[11px] font-bold text-red-100 hover:bg-red-900/70 hover:text-red-50 hover:border-red-300/80 transition-all hover:shadow-[0_0_20px_rgba(248,113,113,0.9)] cursor-pointer anim-tactical"
          >
            <Flame size={13} /> Singularity
          </button>
          <button
            onClick={() => handleQuickAction('deploy')}
            className="shrink-0 flex items-center gap-1.5 px-3 py-2 bg-emerald-950/40 border border-emerald-500/60 rounded-3xl text-[11px] font-bold text-emerald-100 hover:bg-emerald-900/60 hover:text-emerald-50 hover:border-emerald-300/80 transition-all hover:shadow-[0_0_20px_rgba(16,185,129,0.9)] cursor-pointer anim-nexus"
          >
            <Rocket size={13} /> Deploy
          </button>
          <button
            onClick={() => handleQuickAction('health')}
            className="shrink-0 flex items-center gap-1.5 px-3 py-2 bg-cyan-950/40 border border-cyan-500/60 rounded-3xl text-[11px] font-bold text-cyan-100 hover:bg-cyan-900/60 hover:text-cyan-50 hover:border-cyan-300/80 transition-all hover:shadow-[0_0_20px_rgba(6,182,212,0.9)] cursor-pointer anim-cloud"
          >
            <HeartPulse size={13} /> Suit Health
          </button>
          <button
            onClick={() => handleQuickAction('evo-eyes')}
            className="shrink-0 flex items-center gap-1.5 px-3 py-2 bg-violet-950/40 border border-violet-500/60 rounded-3xl text-[11px] font-bold text-violet-100 hover:bg-violet-900/60 hover:text-violet-50 hover:border-violet-300/80 transition-all hover:shadow-[0_0_20px_rgba(139,92,246,0.9)] cursor-pointer anim-hologram"
          >
            <Eye size={13} /> Evo Eyes
          </button>
          <button
            onClick={() => handleQuickAction('swarm')}
            className="shrink-0 flex items-center gap-1.5 px-3 py-2 bg-amber-950/40 border border-amber-500/60 rounded-3xl text-[11px] font-bold text-amber-100 hover:bg-amber-900/60 hover:text-amber-50 hover:border-amber-300/80 transition-all hover:shadow-[0_0_20px_rgba(245,158,11,0.9)] cursor-pointer anim-royal"
          >
            <Gauge size={13} /> Swarm Build
          </button>
        </div>
      </div>

      {/* INPUT AREA */}
      <div className="relative p-4 bg-[#020617]/95 border-t border-slate-800/80 z-10 overflow-hidden anim-clean">
        <div className="pointer-events-none absolute inset-0 opacity-40 bg-[radial-gradient(circle_at_right,_rgba(34,197,94,0.24),_transparent_55%)]" />
        {activeFile && (
          <div className="relative mb-3 flex items-center px-3 py-1.5 bg-slate-900/70 rounded-2xl w-max border border-slate-700/80 shadow-[0_0_14px_rgba(15,23,42,0.95)]">
            <FileCode className="w-3.5 h-3.5 text-sky-300 mr-2" />
            <span className="text-[11px] text-slate-200">
              Context active:{' '}
              <span className="font-mono text-emerald-300">{activeFile}</span>
            </span>
          </div>
        )}

        <form
          onSubmit={handleSendSubmit}
          className={`relative flex items-end bg-[#020617]/95 border rounded-2xl shadow-inner transition-all duration-300 ${
            isFocused
              ? 'border-emerald-400/70 shadow-[0_0_22px_rgba(16,185,129,0.7)]'
              : 'border-slate-700/70 shadow-[0_0_16px_rgba(15,23,42,0.95)]'
          }`}
        >
          <div className="flex gap-2 w-full">
            <input
              type="text"
              value={input}
              onFocus={() => setIsFocused(true)}
              onBlur={() => setIsFocused(false)}
              onChange={(e) => setInput(e.target.value)}
              onKeyDown={handleKeyDown}
              placeholder={
                isRecording
                  ? 'Listening...'
                  : `Command ${currentBot.name}...`
              }
              className="flex-1 bg-black/40 border-r border-slate-800/80 text-white px-4 py-3 outline-none text-sm placeholder:text-slate-500"
              style={{
                ...layoutDef.bubbleStyle,
                borderRadius: layoutDef.bubbleStyle.borderRadius || '12px',
                border: 'none',
              }}
              disabled={loading}
            />
            <button
              onClick={handleSendSubmit}
              disabled={loading || !input.trim()}
              className="w-12 flex items-center justify-center bg-indigo-600 hover:bg-indigo-500 text-white disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
              style={{
                ...layoutDef.bubbleStyle,
                borderRadius: layoutDef.bubbleStyle.borderRadius || '12px',
              }}
            >
              <Send size={18} className={loading ? 'animate-pulse' : ''} />
            </button>
          </div>
          <div className="flex m-2 gap-2">
            <button
              type="button"
              onClick={toggleRecording}
              disabled={loading}
              className={`p-3 rounded-3xl transition flex items-center justify-center relative ${
                isRecording
                  ? 'bg-red-500 hover:bg-red-600 animate-pulse glow-red'
                  : 'bg-slate-900 hover:bg-slate-800 text-slate-200'
              }`}
            >
              <Mic size={18} />
              {isRecording && (
                <div className="absolute inset-0 rounded-full border-4 border-red-400 opacity-75 animate-pulse-fast"></div>
              )}
            </button>
            <button
              type="submit"
              disabled={!input?.trim() || loading || isRecording}
              className="bg-transparent text-white border-none focus:outline-none focus:ring-0 shadow-none px-2 w-10 h-10 flex items-center justify-center relative transition-all duration-300 hover:scale-105 hover:bg-white/10 ml-2 rounded-full"
              style={{
                backgroundColor:
                  !input?.trim() || loading || isRecording
                    ? ''
                    : currentBot.palette?.primary || '#10b981',
              }}
            >
              {loading ? (
                <RefreshCw className="w-5 h-5 animate-spin text-slate-200" />
              ) : (
                <Send className="w-5 h-5 ml-0.5" />
              )}
            </button>
          </div>
        </form>
        <div className="absolute bottom-2 right-4 text-[10px] font-medium text-slate-500 uppercase tracking-[0.2em] animate-pulse-slow">
          Shift + Enter for new line • Live Context Enabled
        </div>
      </div>

      {/* 3D HOLOGRAPHIC BACKDROP */}
      <div className="absolute inset-0 pointer-events-none z-0 mix-blend-screen opacity-80">
        <React.Suspense fallback={null}>
          <Canvas
            camera={{ position: [0, 0, 11], fov: 48 }}
            style={{ position: 'absolute', inset: 0 }}
          >
            <fog attach="fog" args={['#020617', 8, 22]} />
            <ambientLight intensity={0.4} color="#4ade80" />
            <directionalLight
              position={[5, 10, 8]}
              intensity={0.9}
              color="#38bdf8"
            />
            <pointLight
              position={[-6, -4, -8]}
              intensity={0.8}
              color="#a855f7"
            />
            <OrbitControls
              enableDamping={true}
              dampingFactor={0.15}
              autoRotate={true}
              autoRotateSpeed={0.3}
              enableZoom={false}
              enablePan={false}
            />
            <EvoHologram />
          </Canvas>
        </React.Suspense>
      </div>

      <style
        dangerouslySetInnerHTML={{
          __html: `
        .no-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .no-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .no-scrollbar::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.3); border-radius: 3px; }
        .no-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(148, 163, 184, 0.5); }
        .no-scrollbar { scrollbar-width: thin; scrollbar-color: rgba(148, 163, 184, 0.4) transparent; }

        @keyframes shimmer {
          0% { background-position: -200px 0; }
          100% { background-position: 200px 0; }
        }
        .animate-shimmer-fast {
          background-size: 400% 400%;
          animation: shimmer 2.4s linear infinite;
        }

        @keyframes pulseFast { 0%, 100% { opacity: 0.7; } 50% { opacity: 0.25; } }
        @keyframes pulseSlow { 0%, 100% { opacity: 0.8; } 50% { opacity: 0.4; } }
        .animate-pulse-fast { animation: pulseFast 1.4s infinite; }
        .animate-pulse-slow { animation: pulseSlow 3.4s infinite; }

        .glow-red { box-shadow: 0 0 20px 4px rgba(248, 113, 113, 0.75); }

        /* Layout animation personas */
        .anim-nexus { animation: nexusFloat 32s ease-in-out infinite alternate; }
        .anim-terminal { animation: terminalScan 18s linear infinite; }
        .anim-royal { animation: royalPulse 24s ease-in-out infinite alternate; }
        .anim-forge { animation: forgeHeat 26s ease-in-out infinite alternate; }
        .anim-genome { animation: genomeDrift 36s ease-in-out infinite alternate; }
        .anim-cloud { animation: cloudHover 28s ease-in-out infinite alternate; }
        .anim-hologram { animation: holoSpin 30s linear infinite; }
        .anim-retro { animation: retroFlicker 2.8s steps(2, end) infinite; }
        .anim-clean { animation: cleanFade 22s ease-in-out infinite alternate; }
        .anim-tactical { animation: tacticalSweep 16s linear infinite; }

        @keyframes nexusFloat {
          0% { transform: translate3d(0, 0, 0); }
          50% { transform: translate3d(0, -2px, 0); }
          100% { transform: translate3d(0, 1px, 0); }
        }
        @keyframes terminalScan {
          0% { box-shadow: inset 0 0 0 rgba(15, 23, 42, 0.8); }
          50% { box-shadow: inset 0 0 18px rgba(15, 23, 42, 1); }
          100% { box-shadow: inset 0 0 0 rgba(15, 23, 42, 0.8); }
        }
        @keyframes royalPulse {
          0% { filter: drop-shadow(0 0 8px rgba(250, 204, 21, 0.4)); }
          100% { filter: drop-shadow(0 0 24px rgba(250, 204, 21, 0.8)); }
        }
        @keyframes forgeHeat {
          0% { border-color: rgba(148, 163, 184, 0.4); }
          100% { border-color: rgba(251, 146, 60, 0.9); }
        }
        @keyframes genomeDrift {
          0% { transform: translate3d(0,0,0) rotate3d(0,0,1,0deg); }
          100% { transform: translate3d(0,-1px,0) rotate3d(0,0,1,0.6deg); }
        }
        @keyframes cloudHover {
          0% { transform: translateY(0); }
          100% { transform: translateY(-2px); }
        }
        @keyframes holoSpin {
          0% { transform: rotate(0deg); }
          100% { transform: rotate(360deg); }
        }
        @keyframes retroFlicker {
          0% { opacity: 0.92; }
          50% { opacity: 0.8; }
          100% { opacity: 0.9; }
        }
        @keyframes cleanFade {
          0% { opacity: 0.96; }
          100% { opacity: 1; }
        }
        @keyframes tacticalSweep {
          0% { background-position: -200px 0; }
          100% { background-position: 200px 0; }
        }
      `,
        }}
      />
    </div>
  );
}

export default EvoCopilot;

