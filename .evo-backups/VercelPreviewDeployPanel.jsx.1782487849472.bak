import React, { useState, useEffect, useMemo } from 'react';
import { ExternalLink, Rocket, ShieldCheck, AlertCircle, RefreshCw, CheckCircle } from 'lucide-react';
import TruthBadge from './TruthBadge.jsx';
import OwnerApprovalPanel from './OwnerApprovalPanel.jsx';
import { getVercelPreviewStatus, requestVercelPreviewDeploy, getLatestPreviewDeploymentReceipt } from '../services/vercel-preview-client.js';

import { Log } from '../core/autonomy/SovereignLogger.js';

export default function VercelPreviewDeployPanel() {
  const [status, setStatus] = useState(null);
  const [loading, setLoading] = useState(true);
  const [deploying, setDeploying] = useState(false);
  const [approvalEnvelope, setApprovalEnvelope] = useState(null);
  const [result, setResult] = useState(null);
  const [latestReceipt, setLatestReceipt] = useState(null);
  const [hoverDeploy, setHoverDeploy] = useState(false);
  const [panelHovered, setPanelHovered] = useState(false);

  const fetchStatus = async () => {
    setLoading(true);
    try {
      const [statusRes, receiptRes] = await Promise.all([
        getVercelPreviewStatus(),
        getLatestPreviewDeploymentReceipt()
      ]);
      if (statusRes.ok) setStatus(statusRes.data);
      if (receiptRes.ok) setLatestReceipt(receiptRes.data);
    } catch (err) {
      Log.error('Failed to fetch Vercel status:', err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchStatus();
  }, []);

  const handleDeploy = async () => {
    if (!approvalEnvelope) return;
    setDeploying(true);
    setResult(null);
    try {
      const res = await requestVercelPreviewDeploy(approvalEnvelope);
      setResult(res);
      if (res.ok) {
        await fetchStatus();
      }
    } catch (err) {
      setResult({ ok: false, error: err.message, truthState: 'ERROR' });
    } finally {
      setDeploying(false);
    }
  };

  const { tokenStatus, previewReadiness, productionReadiness } = status || {};
  const isReady = previewReadiness?.ready;

  const readinessScore = useMemo(() => {
    let score = 0;
    if (tokenStatus?.configured) score += 0.4;
    if (previewReadiness?.ready) score += 0.4;
    if (productionReadiness?.ready) score += 0.2;
    return score;
  }, [tokenStatus, previewReadiness, productionReadiness]);

  const readinessLabel = useMemo(() => {
    if (readinessScore >= 0.9) return 'OPERATIONAL';
    if (readinessScore >= 0.6) return 'READY';
    if (readinessScore >= 0.3) return 'LIMITED';
    return 'BLOCKED';
  }, [readinessScore]);

  const readinessColor = useMemo(() => {
    if (readinessScore >= 0.9) return 'var(--accent-cyan, #22d3ee)';
    if (readinessScore >= 0.6) return 'var(--accent-green, #22c55e)';
    if (readinessScore >= 0.3) return 'var(--accent-orange, #fb923c)';
    return 'var(--accent-red, #f97373)';
  }, [readinessScore]);

  const basePanelStyle = {
    position: 'relative',
    background: 'radial-gradient(circle at 0 0, rgba(56, 189, 248, 0.18), transparent 55%), radial-gradient(circle at 100% 100%, rgba(94, 234, 212, 0.18), transparent 55%), linear-gradient(145deg, rgba(15,23,42,0.96), rgba(2,6,23,0.98))',
    borderRadius: '18px',
    padding: '20px',
    overflow: 'hidden',
    boxShadow: panelHovered
      ? '0 0 35px rgba(94, 234, 212, 0.4), 0 0 80px rgba(59, 130, 246, 0.35)'
      : '0 18px 40px rgba(15,23,42,0.8)',
    transition: 'box-shadow 260ms ease-out, transform 260ms ease-out, border-color 260ms ease-out, background 420ms ease-out',
    transform: panelHovered ? 'translateY(-2px) scale(1.01)' : 'translateY(0) scale(1)',
    border: panelHovered
      ? '1px solid rgba(59, 130, 246, 0.7)'
      : '1px solid rgba(148, 163, 184, 0.45)',
    backdropFilter: 'blur(22px)',
  };

  if (loading) {
    return (
      <div
        style={basePanelStyle}
        className="layout-hologram anim-nexus"
        id="vercel-preview-deploy-panel"
      >
        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            gap: '10px',
            fontSize: '12px',
            color: 'var(--text-dim, #94a3b8)',
          }}
        >
          <div
            style={{
              width: 18,
              height: 18,
              borderRadius: '999px',
              border: '2px solid rgba(56,189,248,0.6)',
              borderTopColor: 'transparent',
              animation: 'spin 900ms linear infinite',
            }}
          />
          <span>Scanning Vercel environment for deployment readiness…</span>
        </div>
      </div>
    );
  }

  return (
    <div
      style={basePanelStyle}
      className="layout-nexus layout-tactical anim-nexus anim-hologram"
      id="vercel-preview-deploy-panel"
      onMouseEnter={() => setPanelHovered(true)}
      onMouseLeave={() => setPanelHovered(false)}
    >
      {/* Holographic grid overlay */}
      <div
        className="anim-terminal"
        style={{
          pointerEvents: 'none',
          position: 'absolute',
          inset: 0,
          opacity: 0.35,
          mixBlendMode: 'screen',
          backgroundImage:
            'linear-gradient(rgba(30,64,175,0.22) 1px, transparent 1px), linear-gradient(90deg, rgba(22,163,74,0.22) 1px, transparent 1px)',
          backgroundSize: '26px 26px, 26px 26px',
          transform: 'translate3d(0,0,0)',
        }}
      />
      {/* Rotating aurora ring */}
      <div
        className="anim-genome"
        style={{
          position: 'absolute',
          width: '520px',
          height: '520px',
          borderRadius: '999px',
          background:
            'conic-gradient(from 140deg, rgba(56,189,248,0.15), transparent 45%, rgba(129,140,248,0.2), transparent 75%, rgba(45,212,191,0.16))',
          top: '-260px',
          right: '-220px',
          filter: 'blur(6px)',
          opacity: 0.85,
          animation: 'spin-slow 24s linear infinite',
        }}
      />

      {/* Header row */}
      <div
        style={{
          display: 'flex',
          alignItems: 'center',
          gap: '10px',
          marginBottom: '18px',
          justifyContent: 'space-between',
          position: 'relative',
          zIndex: 2,
        }}
      >
        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            gap: '10px',
          }}
        >
          <div
            className="anim-forge"
            style={{
              position: 'relative',
              width: 32,
              height: 32,
              borderRadius: '999px',
              background:
                'radial-gradient(circle at 30% 0%, rgba(251,191,36,0.35), transparent), radial-gradient(circle at 70% 100%, rgba(34,197,94,0.45), transparent), radial-gradient(circle at 50% 50%, rgba(56,189,248,0.85), rgba(15,23,42,0.95))',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              boxShadow:
                '0 0 18px rgba(56,189,248,0.7), 0 0 40px rgba(56,189,248,0.45), 0 0 64px rgba(59,130,246,0.45)',
              overflow: 'hidden',
            }}
          >
            <div
              style={{
                position: 'absolute',
                inset: 4,
                borderRadius: '999px',
                border: '1px solid rgba(148,163,184,0.45)',
                mixBlendMode: 'screen',
              }}
            />
            <Rocket
              size={18}
              color="#e5f8ff"
              style={{
                transform: deploying ? 'translateY(-1px)' : 'translateY(0)',
                transition: 'transform 160ms ease-out',
              }}
            />
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
            <span
              style={{
                fontWeight: 800,
                color: '#e5e7eb',
                fontSize: '13px',
                letterSpacing: '0.09em',
                textTransform: 'uppercase',
              }}
            >
              Vercel Preview Deploy Proof
            </span>
            <span
              style={{
                fontSize: '10px',
                color: 'rgba(148,163,184,0.9)',
                fontFamily: 'monospace',
                textTransform: 'uppercase',
                letterSpacing: '0.12em',
              }}
            >
              Nexus · Hologram · Tactical Fusion Layer
            </span>
          </div>
        </div>

        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            gap: 10,
          }}
        >
          {/* Global readiness capsule */}
          <div
            className="anim-royal"
            style={{
              position: 'relative',
              padding: '6px 10px',
              borderRadius: '999px',
              background:
                'linear-gradient(120deg, rgba(56, 189, 248, 0.24), rgba(34, 197, 94, 0.18))',
              boxShadow:
                '0 0 20px rgba(34,197,94,0.35), 0 0 30px rgba(56,189,248,0.45)',
              display: 'flex',
              alignItems: 'center',
              gap: 6,
            }}
          >
            <div
              style={{
                width: 9,
                height: 9,
                borderRadius: '999px',
                background:
                  'radial-gradient(circle at 30% 0%, #fef9c3, #22c55e)',
                boxShadow:
                  '0 0 10px rgba(34,197,94,0.9), 0 0 22px rgba(34,197,94,0.7)',
                animation: 'pulse-soft 1.6s ease-in-out infinite',
              }}
            />
            <span
              style={{
                fontSize: '10px',
                textTransform: 'uppercase',
                letterSpacing: '0.16em',
                fontWeight: 700,
                color: '#ecfeff',
              }}
            >
              {readinessLabel}
            </span>
            <span
              style={{
                fontSize: '9px',
                fontFamily: 'monospace',
                color: 'rgba(226,232,240,0.9)',
              }}
            >
              {(readinessScore * 100).toFixed(0)}%
            </span>
          </div>

          <TruthBadge state={previewReadiness?.truthState || 'UNKNOWN'} compact />
        </div>
      </div>

      {/* Content grid */}
      <div
        style={{
          display: 'grid',
          gridTemplateColumns: 'minmax(0, 1.25fr) minmax(0, 1.1fr)',
          gap: '16px',
          fontSize: '12px',
          position: 'relative',
          zIndex: 2,
        }}
      >
        {/* Left: status matrix */}
        <div
          className="layout-tactical anim-cloud"
          style={{
            display: 'flex',
            flexDirection: 'column',
            gap: '10px',
            borderRadius: '14px',
            padding: '10px 12px',
            background:
              'linear-gradient(135deg, rgba(15,23,42,0.9), rgba(8,47,73,0.9))',
            border: '1px solid rgba(148,163,184,0.5)',
            boxShadow: '0 16px 30px rgba(15,23,42,0.85)',
            position: 'relative',
            overflow: 'hidden',
          }}
        >
          <div
            style={{
              position: 'absolute',
              inset: 0,
              background:
                'radial-gradient(circle at 0 0, rgba(59,130,246,0.22), transparent 55%)',
              opacity: 0.7,
              mixBlendMode: 'screen',
              pointerEvents: 'none',
            }}
          />

          <div
            style={{
              display: 'grid',
              gridTemplateColumns: 'minmax(0,1.25fr) minmax(0,0.9fr)',
              rowGap: 6,
              columnGap: 12,
              alignItems: 'center',
            }}
          >
            {/* Vercel Token */}
            <span
              style={{
                color: 'rgba(148,163,184,0.95)',
                textTransform: 'uppercase',
                letterSpacing: '0.11em',
                fontSize: '10px',
                display: 'flex',
                alignItems: 'center',
                gap: 4,
              }}
            >
              <span
                style={{
                  width: 3,
                  height: 12,
                  borderRadius: '999px',
                  background:
                    tokenStatus?.configured
                      ? 'linear-gradient(to bottom, #22c55e, #16a34a)'
                      : 'linear-gradient(to bottom, #f97373, #f43f5e)',
                }}
              />
              Vercel Token
            </span>
            <span
              style={{
                fontWeight: 700,
                color: tokenStatus?.configured
                  ? 'var(--accent-green, #4ade80)'
                  : 'var(--accent-red, #f97373)',
                fontFamily: 'monospace',
                fontSize: 11,
                justifySelf: 'flex-end',
              }}
            >
              {tokenStatus?.configured
                ? `CONFIGURED · ${tokenStatus.redactedToken}`
                : 'MISSING'}
            </span>

            {/* Preview readiness */}
            <span
              style={{
                color: 'rgba(148,163,184,0.95)',
                textTransform: 'uppercase',
                letterSpacing: '0.11em',
                fontSize: '10px',
                display: 'flex',
                alignItems: 'center',
                gap: 4,
              }}
            >
              <span
                style={{
                  width: 3,
                  height: 12,
                  borderRadius: '999px',
                  background: isReady
                    ? 'linear-gradient(to bottom, #22d3ee, #0284c7)'
                    : 'linear-gradient(to bottom, #fb923c, #f97316)',
                }}
              />
              Preview Channel
            </span>
            <div
              style={{
                justifySelf: 'flex-end',
                display: 'flex',
                alignItems: 'center',
                gap: 6,
              }}
            >
              <span
                style={{
                  padding: '2px 7px',
                  borderRadius: '999px',
                  border: `1px solid ${isReady ? '#22d3ee' : '#fb923c'}`,
                  color: isReady ? '#7dd3fc' : '#fed7aa',
                  fontSize: '9px',
                  textTransform: 'uppercase',
                  letterSpacing: '0.16em',
                  fontWeight: 700,
                  background: isReady
                    ? 'radial-gradient(circle at 0 0, rgba(34,211,238,0.32), transparent)'
                    : 'radial-gradient(circle at 0 0, rgba(251,146,60,0.22), transparent)',
                }}
              >
                {isReady ? 'Preview Ready' : 'Preview Blocked'}
              </span>
            </div>

            {/* Production readiness */}
            <span
              style={{
                color: 'rgba(148,163,184,0.95)',
                textTransform: 'uppercase',
                letterSpacing: '0.11em',
                fontSize: '10px',
                display: 'flex',
                alignItems: 'center',
                gap: 4,
              }}
            >
              <span
                style={{
                  width: 3,
                  height: 12,
                  borderRadius: '999px',
                  background: productionReadiness?.ready
                    ? 'linear-gradient(to bottom, #a855f7, #6366f1)'
                    : 'linear-gradient(to bottom, #f97373, #ef4444)',
                }}
              />
              Production Deploy
            </span>
            <span
              style={{
                fontWeight: 800,
                color: productionReadiness?.ready
                  ? 'var(--accent-indigo, #818cf8)'
                  : 'var(--accent-red, #f97373)',
                textTransform: 'uppercase',
                fontSize: '11px',
                justifySelf: 'flex-end',
                letterSpacing: '0.11em',
              }}
            >
              {productionReadiness?.ready ? 'READY' : 'BLOCKED'}
            </span>
          </div>

          {/* Micro progress bar */}
          <div
            style={{
              marginTop: 8,
              position: 'relative',
              height: 4,
              borderRadius: '999px',
              background: 'rgba(15,23,42,0.85)',
              overflow: 'hidden',
            }}
          >
            <div
              style={{
                position: 'absolute',
                inset: 0,
                opacity: 0.6,
                backgroundImage:
                  'linear-gradient(120deg, rgba(148,163,184,0.25) 25%, transparent 30%, transparent 48%, rgba(148,163,184,0.25) 52%, transparent 55%, transparent 70%, rgba(148,163,184,0.3) 75%)',
                backgroundSize: '60px 100%',
                animation: 'slide-diagonal 2.4s linear infinite',
              }}
            />
            <div
              style={{
                position: 'relative',
                width: `${Math.max(6, readinessScore * 100)}%`,
                height: '100%',
                borderRadius: '999px',
                background: `linear-gradient(90deg, ${readinessColor}, rgba(56,189,248,0.95))`,
                boxShadow: `0 0 16px ${readinessColor}`,
              }}
            />
          </div>

          {/* Blockers, if any */}
          {previewReadiness?.blockers?.length > 0 && (
            <div
              className="anim-terminal"
              style={{
                marginTop: 10,
                color: 'var(--accent-orange, #fb923c)',
                padding: '10px 10px 9px',
                background:
                  'linear-gradient(120deg, rgba(30,64,175,0.65), rgba(180,83,9,0.22))',
                borderRadius: '10px',
                border: '1px solid rgba(251, 146, 60, 0.45)',
                boxShadow: '0 10px 28px rgba(15,23,42,0.9)',
              }}
            >
              <div
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: '6px',
                  fontWeight: 600,
                  marginBottom: '5px',
                  textTransform: 'uppercase',
                  letterSpacing: '0.14em',
                  fontSize: '10px',
                  color: '#fed7aa',
                }}
              >
                <AlertCircle size={14} /> Readiness Blockers
              </div>
              <ul
                style={{
                  margin: 0,
                  paddingLeft: '16px',
                  color: '#fee2e2',
                  fontSize: '11px',
                }}
              >
                {previewReadiness.blockers.map((b, i) => (
                  <li key={i}>{b}</li>
                ))}
              </ul>
            </div>
          )}
        </div>

        {/* Right: control & telemetry stack */}
        <div
          style={{
            display: 'flex',
            flexDirection: 'column',
            gap: '12px',
            position: 'relative',
            zIndex: 2,
          }}
        >
          {/* Owner approval rail */}
          <div
            className="layout-cloud anim-genome"
            style={{
              borderRadius: '12px',
              border: '1px solid rgba(148,163,184,0.55)',
              padding: '10px 11px',
              background:
                'linear-gradient(135deg, rgba(15,23,42,0.96), rgba(30,64,175,0.7))',
              boxShadow: '0 12px 25px rgba(15,23,42,0.9)',
            }}
          >
            <OwnerApprovalPanel
              scope="deploy"
              onApprovalGranted={setApprovalEnvelope}
              title="Vercel Deployment Gate"
            />
          </div>

          {/* Deploy button + live indicators */}
          <div
            className="layout-forge"
            style={{
              display: 'flex',
              flexDirection: 'column',
              gap: 8,
            }}
          >
            <button
              onClick={handleDeploy}
              onMouseEnter={() => setHoverDeploy(true)}
              onMouseLeave={() => setHoverDeploy(false)}
              disabled={!approvalEnvelope || deploying || !isReady}
              style={{
                width: '100%',
                padding: '11px 12px',
                borderRadius: '999px',
                marginTop: '2px',
                background:
                  !approvalEnvelope || !isReady
                    ? 'radial-gradient(circle at 0 0, rgba(15,23,42,0.95), rgba(15,23,42,0.98))'
                    : hoverDeploy
                    ? 'linear-gradient(120deg, #0ea5e9, #22c55e)'
                    : 'linear-gradient(120deg, #22c55e, #0ea5e9)',
                color:
                  !approvalEnvelope || !isReady ? 'var(--text-dim, #64748b)' : '#f9fafb',
                border:
                  !approvalEnvelope || !isReady
                    ? '1px solid rgba(75,85,99,0.9)'
                    : '1px solid rgba(240,249,255,0.7)',
                cursor:
                  !approvalEnvelope || !isReady ? 'not-allowed' : 'pointer',
                fontSize: '12px',
                fontWeight: 700,
                display: 'flex',
                justifyContent: 'center',
                alignItems: 'center',
                gap: '8px',
                letterSpacing: '0.12em',
                textTransform: 'uppercase',
                boxShadow:
                  !approvalEnvelope || !isReady
                    ? '0 0 0 rgba(59,130,246,0)'
                    : hoverDeploy
                    ? '0 0 35px rgba(56,189,248,0.9), 0 0 65px rgba(34,197,94,0.9)'
                    : '0 0 26px rgba(56,189,248,0.65), 0 0 44px rgba(34,197,94,0.7)',
                transform:
                  !approvalEnvelope || !isReady
                    ? 'translateY(0)'
                    : hoverDeploy
                    ? 'translateY(-1px) scale(1.01)'
                    : 'translateY(0)',
                transition:
                  'background 160ms ease-out, box-shadow 160ms ease-out, transform 160ms ease-out, border-color 160ms ease-out',
              }}
            >
              {deploying ? (
                <RefreshCw
                  size={16}
                  style={{
                    animation: 'spin 900ms linear infinite',
                  }}
                />
              ) : (
                <Rocket
                  size={16}
                  style={{
                    transform: hoverDeploy ? 'translateY(-1px)' : 'translateY(0)',
                    transition: 'transform 120ms ease-out',
                  }}
                />
              )}
              {deploying
                ? 'Deploying to Vercel…'
                : 'Run Vercel Preview Deploy Proof'}
            </button>

            {/* Live channel indicators */}
            <div
              style={{
                display: 'flex',
                justifyContent: 'space-between',
                alignItems: 'center',
                gap: 8,
              }}
            >
              <div
                className="layout-retro anim-terminal"
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: 6,
                  fontSize: 10,
                  color: '#cbd5f5',
                  fontFamily: 'monospace',
                }}
              >
                <div
                  style={{
                    position: 'relative',
                    width: 18,
                    height: 10,
                    borderRadius: 999,
                    border: '1px solid rgba(148,163,184,0.8)',
                    overflow: 'hidden',
                    background: 'rgba(15,23,42,0.9)',
                  }}
                >
                  <div
                    style={{
                      position: 'absolute',
                      inset: 0,
                      background: isReady
                        ? 'linear-gradient(90deg, #22c55e, #4ade80)'
                        : 'linear-gradient(90deg, #f97373, #f97316)',
                      transform: isReady
                        ? 'translateX(0)'
                        : 'translateX(-40%)',
                      boxShadow: isReady
                        ? '0 0 10px rgba(34,197,94,0.85)'
                        : '0 0 10px rgba(249,115,22,0.85)',
                      animation: isReady
                        ? 'slide-slow 2.4s ease-in-out infinite alternate'
                        : 'slide-slow 3s ease-in-out infinite alternate',
                    }}
                  />
                </div>
                <span>Preview Channel</span>
              </div>

              <div
                className="layout-clean anim-cloud"
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: 6,
                  fontSize: 10,
                  color: '#cbd5f5',
                  fontFamily: 'monospace',
                }}
              >
                <ShieldCheck
                  size={12}
                  color={
                    approvalEnvelope
                      ? '#22c55e'
                      : 'rgba(148,163,184,0.9)'
                  }
                />
                <span>
                  Owner Gate:{' '}
                  <span
                    style={{
                      color: approvalEnvelope
                        ? '#4ade80'
                        : 'rgba(148,163,184,0.9)',
                    }}
                  >
                    {approvalEnvelope ? 'Granted' : 'Awaiting'}
                  </span>
                </span>
              </div>
            </div>
          </div>

          {/* Result / latest receipt */}
          {result && (
            <div
              className="layout-hologram anim-nexus"
              style={{
                marginTop: '4px',
                padding: '11px 12px',
                borderRadius: '12px',
                fontSize: '11px',
                background: result.ok
                  ? 'linear-gradient(135deg, rgba(6,95,70,0.9), rgba(5,46,22,0.95))'
                  : 'linear-gradient(135deg, rgba(127,29,29,0.92), rgba(55,12,12,0.96))',
                border: `1px solid ${
                  result.ok
                    ? 'rgba(34, 197, 94, 0.7)'
                    : 'rgba(248, 113, 113, 0.7)'
                }`,
                boxShadow: result.ok
                  ? '0 12px 30px rgba(5,46,22,0.95)'
                  : '0 12px 30px rgba(55,12,12,0.95)',
              }}
            >
              <div
                style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  marginBottom: '6px',
                  alignItems: 'center',
                }}
              >
                <span
                  style={{
                    fontWeight: 700,
                    color: '#e5e7eb',
                    letterSpacing: '0.11em',
                    textTransform: 'uppercase',
                    fontSize: '10px',
                  }}
                >
                  Deployment Result
                </span>
                <TruthBadge state={result.truthState} compact />
              </div>
              {result.ok ? (
                <div>
                  <div
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: 6,
                      marginBottom: 6,
                    }}
                  >
                    <CheckCircle
                      size={13}
                      color="#4ade80"
                      style={{
                        filter: 'drop-shadow(0 0 6px rgba(34,197,94,0.9))',
                      }}
                    />
                    <p
                      style={{
                        color: '#bbf7d0',
                        margin: 0,
                        fontWeight: 600,
                      }}
                    >
                      Preview deploy successful.
                    </p>
                  </div>
                  <div
                    style={{
                      display: 'flex',
                      flexDirection: 'column',
                      gap: 4,
                    }}
                  >
                    <a
                      href={result.deploymentUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      style={{
                        color: '#bfdbfe',
                        fontWeight: 700,
                        display: 'inline-flex',
                        alignItems: 'center',
                        gap: '4px',
                        textDecoration: 'none',
                        fontSize: 11,
                      }}
                    >
                      <span
                        style={{
                          textDecoration: 'underline',
                        }}
                      >
                        Open Preview
                      </span>
                      <ExternalLink size={12} />
                    </a>
                    <span
                      style={{
                        fontSize: '10px',
                        color: '#d1fae5',
                        fontFamily: 'monospace',
                      }}
                    >
                      ID: {result.deploymentId}
                    </span>
                    <span
                      style={{
                        fontSize: '10px',
                        color: '#a7f3d0',
                        fontFamily: 'monospace',
                      }}
                    >
                      Receipt: {result.receiptId}
                    </span>
                  </div>
                </div>
              ) : (
                <div
                  style={{
                    color: '#fee2e2',
                    display: 'flex',
                    flexDirection: 'column',
                    gap: 4,
                  }}
                >
                  <span
                    style={{
                      fontWeight: 600,
                      letterSpacing: '0.08em',
                      textTransform: 'uppercase',
                      fontSize: 10,
                    }}
                  >
                    Deployment failed
                  </span>
                  <span>
                    {result.error || result.blockedReason || 'Unknown error.'}
                  </span>
                </div>
              )}
            </div>
          )}

          {!result && latestReceipt && (
            <div
              className="layout-retro anim-terminal"
              style={{
                marginTop: '4px',
                padding: '10px 11px',
                background:
                  'linear-gradient(145deg, rgba(15,23,42,0.97), rgba(15,23,42,0.94))',
                border: '1px solid rgba(148,163,184,0.7)',
                borderRadius: '10px',
                fontSize: '10.5px',
                color: '#cbd5f5',
                position: 'relative',
                overflow: 'hidden',
              }}
            >
              <div
                style={{
                  position: 'absolute',
                  inset: 0,
                  background:
                    'linear-gradient(120deg, transparent 0%, rgba(56,189,248,0.2) 50%, transparent 100%)',
                  opacity: 0.3,
                  mixBlendMode: 'screen',
                  pointerEvents: 'none',
                }}
              />
              <div
                style={{
                  color: 'rgba(148,163,184,1)',
                  marginBottom: '4px',
                  textTransform: 'uppercase',
                  letterSpacing: '0.11em',
                  fontWeight: 700,
                  fontSize: '10px',
                }}
              >
                Latest Preview Receipt
              </div>
              <div
                style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center',
                  marginBottom: 2,
                }}
              >
                <span
                  style={{
                    color: '#e2e8f0',
                  }}
                >
                  {new Date(latestReceipt.createdAt).toLocaleString()}
                </span>
                <TruthBadge state={latestReceipt.truthState} compact />
              </div>
              {latestReceipt.deploymentUrl && (
                <a
                  href={latestReceipt.deploymentUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  style={{
                    color: '#60a5fa',
                    display: 'inline-flex',
                    marginTop: '4px',
                    textDecoration: 'underline',
                    fontSize: 11,
                    alignItems: 'center',
                    gap: 4,
                  }}
                >
                  {latestReceipt.deploymentUrl}
                  <ExternalLink size={11} />
                </a>
              )}
            </div>
          )}
        </div>
      </div>

      {/* Floating particle specks */}
      <div
        className="anim-genome"
        style={{
          pointerEvents: 'none',
          position: 'absolute',
          inset: 0,
          overflow: 'hidden',
          opacity: 0.7,
        }}
      >
        {[...Array(16)].map((_, i) => (
          <div
            key={i}
            style={{
              position: 'absolute',
              width: 2,
              height: 2,
              borderRadius: '999px',
              background:
                i % 3 === 0
                  ? 'rgba(56,189,248,0.8)'
                  : i % 3 === 1
                  ? 'rgba(129,140,248,0.8)'
                  : 'rgba(34,197,94,0.8)',
              top: `${(i * 17) % 100}%`,
              left: `${(i * 29) % 100}%`,
              boxShadow: '0 0 10px rgba(248,250,252,0.8)',
              animation: `float-soft ${10 + i * 0.7}s ease-in-out infinite alternate`,
            }}
          />
        ))}
      </div>
    </div>
  );
}

