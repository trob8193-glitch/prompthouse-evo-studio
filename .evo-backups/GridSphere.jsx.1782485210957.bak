import React, { useRef, Suspense, useMemo, useEffect } from "react";
import { Canvas, useFrame, useLoader } from "@react-three/fiber";
import { Float } from "@react-three/drei";
import {
  TextureLoader,
  DoubleSide,
  AdditiveBlending,
  Vector3,
  BufferGeometry,
  BufferAttribute,
} from "three";

const TigerEye = ({ position, rotation }) => {
  return (
    <group position={position} rotation={rotation}>
      {/* Dark Outer Sclera (creates a shadow edge around the iris for realistic depth) */}
      <mesh scale={[2.0, 0.8, 0.35]} position={[0, 0, -0.01]}>
        <sphereGeometry args={[0.16, 32, 32]} />
        <meshBasicMaterial color="#020202" />
      </mesh>

      {/* Glowing Green/Gold Iris */}
      <mesh scale={[1.8, 0.7, 0.4]}>
        <sphereGeometry args={[0.15, 32, 32]} />
        <meshStandardMaterial
          color="#34d399"
          emissive="#10b981"
          emissiveIntensity={1.5}
          roughness={0.1}
          metalness={0.8}
        />
      </mesh>

      {/* Razor Sharp Solid Black Vertical Slit Pupil */}
      <mesh position={[0, 0, 0.055]} scale={[0.12, 1.1, 0.3]}>
        <sphereGeometry args={[0.1, 32, 32]} />
        <meshBasicMaterial color="#000000" />
      </mesh>

      {/* Specular Catchlight (makes the eye look wet, glassy, and alive) */}
      <mesh position={[-0.04, 0.04, 0.065]}>
        <sphereGeometry args={[0.012, 16, 16]} />
        <meshBasicMaterial color="#ffffff" />
      </mesh>
    </group>
  );
};

const LightningBolt = ({ color, radius }) => {
  const geoRef = useRef(null);
  const target = useRef(new Vector3());
  const points = useMemo(() => new Float32Array(15 * 3), []);

  useFrame(() => {
    if (geoRef.current && !geoRef.current.attributes.position) {
      geoRef.current.setAttribute("position", new BufferAttribute(points, 3));
    }

    if (
      ((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) > 0.6 &&
      geoRef.current &&
      geoRef.current.attributes.position
    ) {
      target.current
        .set(
          (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 2,
          (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 2,
          (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 2,
        )
        .normalize()
        .multiplyScalar(radius * (0.8 + ((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) * 0.4));

      let cx = 0,
        cy = 0,
        cz = 0;
      const steps = 15;
      const dx = target.current.x / steps;
      const dy = target.current.y / steps;
      const dz = target.current.z / steps;

      const pos = geoRef.current.attributes.position.array;
      for (let i = 0; i < steps; i++) {
        pos[i * 3] = cx;
        pos[i * 3 + 1] = cy;
        pos[i * 3 + 2] = cz;
        // high frequency branching/radiating jitter
        cx += dx + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 1.6;
        cy += dy + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 1.6;
        cz += dz + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 1.6;
      }
      pos[(steps - 1) * 3] = target.current.x;
      pos[(steps - 1) * 3 + 1] = target.current.y;
      pos[(steps - 1) * 3 + 2] = target.current.z;

      geoRef.current.attributes.position.needsUpdate = true;
    }
  });

  return (
    <line>
      <bufferGeometry ref={geoRef} />
      <lineBasicMaterial
        color={color}
        transparent
        opacity={0.9}
        blending={AdditiveBlending}
        depthWrite={false}
      />
    </line>
  );
};

const PlasmaArc = ({ radius, color }) => {
  const geoRef = useRef();
  const branchGeoRef = useRef();

  const [targets] = React.useState(() => {
    const theta = ((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) * Math.PI * 2;
    const phi = Math.acos(((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) * 2 - 1);
    const r = radius * (0.9 + ((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) * 0.1);

    const mainTarget = new Vector3(
      r * Math.sin(phi) * Math.cos(theta),
      r * Math.sin(phi) * Math.sin(theta),
      r * Math.cos(phi),
    );

    const axis = new Vector3(
      ((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)),
      ((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)),
      ((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)),
    ).normalize();
    const branchTarget = mainTarget
      .clone()
      .applyAxisAngle(axis, 0.4)
      .multiplyScalar(0.9);

    return { main: mainTarget, branch: branchTarget };
  });

  const [basePoints] = React.useState(() => {
    const pts = [];
    for (let i = 0; i <= 6; i++)
      pts.push(targets.main.clone().multiplyScalar(i / 6));
    return pts;
  });

  const [branchBasePoints] = React.useState(() => {
    const pts = [];
    const splitPoint = basePoints[3].clone();
    for (let i = 0; i <= 3; i++) {
      pts.push(splitPoint.clone().lerp(targets.branch, i / 3));
    }
    return pts;
  });

  const [positions] = React.useState(() => new Float32Array(21));
  const [branchPositions] = React.useState(() => new Float32Array(12));

  useFrame(() => {
    if (geoRef.current) {
      const pos = geoRef.current.attributes.position.array;
      const splitPos = new Vector3();

      for (let i = 0; i <= 6; i++) {
        if (i === 0) {
          pos[i * 3] = 0;
          pos[i * 3 + 1] = 0;
          pos[i * 3 + 2] = 0;
        } else if (i === 6) {
          pos[i * 3] = basePoints[i].x + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 0.4;
          pos[i * 3 + 1] = basePoints[i].y + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 0.4;
          pos[i * 3 + 2] = basePoints[i].z + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 0.4;
        } else {
          const jitter = 1.6 * (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5);
          pos[i * 3] = basePoints[i].x + jitter;
          pos[i * 3 + 1] = basePoints[i].y + jitter;
          pos[i * 3 + 2] = basePoints[i].z + jitter;
        }

        if (i === 3) {
          splitPos.set(pos[i * 3], pos[i * 3 + 1], pos[i * 3 + 2]);
        }
      }
      geoRef.current.attributes.position.needsUpdate = true;

      if (branchGeoRef.current) {
        const bPos = branchGeoRef.current.attributes.position.array;
        for (let i = 0; i <= 3; i++) {
          if (i === 0) {
            bPos[0] = splitPos.x;
            bPos[1] = splitPos.y;
            bPos[2] = splitPos.z;
          } else if (i === 3) {
            bPos[i * 3] = branchBasePoints[i].x + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 0.4;
            bPos[i * 3 + 1] =
              branchBasePoints[i].y + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 0.4;
            bPos[i * 3 + 2] =
              branchBasePoints[i].z + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 0.4;
          } else {
            const jitter = 1.2 * (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5);
            bPos[i * 3] = branchBasePoints[i].x + jitter;
            bPos[i * 3 + 1] = branchBasePoints[i].y + jitter;
            bPos[i * 3 + 2] = branchBasePoints[i].z + jitter;
          }
        }
        branchGeoRef.current.attributes.position.needsUpdate = true;
      }
    }
  });

  return (
    <group>
      <line>
        <bufferGeometry ref={geoRef}>
          <bufferAttribute
            attach="attributes-position"
            count={7}
            array={positions}
            itemSize={3}
          />
        </bufferGeometry>
        <lineBasicMaterial
          color={color}
          transparent
          opacity={0.05}
          blending={AdditiveBlending}
        />
      </line>
      <line>
        <bufferGeometry ref={branchGeoRef}>
          <bufferAttribute
            attach="attributes-position"
            count={4}
            array={branchPositions}
            itemSize={3}
          />
        </bufferGeometry>
        <lineBasicMaterial
          color={color}
          transparent
          opacity={0.04}
          blending={AdditiveBlending}
        />
      </line>
    </group>
  );
};

const ElectrifiedSphere = ({
  args,
  color,
  opacity,
  pulseSpeed = 0,
  pulseIntensity = 0,
}) => {
  const geoRef = useRef();
  const meshRef = useRef();
  const originalPos = useRef(null);

  useFrame((state) => {
    if (geoRef.current) {
      if (!originalPos.current && geoRef.current.attributes.position) {
        originalPos.current = new Float32Array(
          geoRef.current.attributes.position.array,
        );
      }
      if (originalPos.current) {
        const pos = geoRef.current.attributes.position.array;
        const orig = originalPos.current;
        for (let i = 0; i < pos.length; i++) {
          pos[i] = orig[i] + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 0.24;
        }
        geoRef.current.attributes.position.needsUpdate = true;
      }
    }

    if (pulseSpeed > 0 && meshRef.current) {
      // Create a sharp "heartbeat" double-throb
      const t = state.clock.elapsedTime * pulseSpeed;
      const throb =
        Math.pow(Math.sin(t), 8) + Math.pow(Math.sin(t + 0.3), 8) * 0.5;
      const scale = 1 + throb * pulseIntensity;
      meshRef.current.scale.set(scale, scale, scale);
    }
  });

  return (
    <mesh ref={meshRef}>
      <sphereGeometry args={args} ref={geoRef} />
      <meshBasicMaterial
        color={color}
        wireframe={true}
        transparent={true}
        opacity={opacity}
        depthWrite={false}
        side={DoubleSide}
      />
    </mesh>
  );
};

const ElectrifiedPlane = ({ args, color, alphaMap, opacity = 0.8 }) => {
  const geoRef = useRef();
  const originalPos = useRef(null);

  useFrame(() => {
    if (geoRef.current) {
      if (!originalPos.current && geoRef.current.attributes.position) {
        originalPos.current = new Float32Array(
          geoRef.current.attributes.position.array,
        );
      }
      if (originalPos.current) {
        const pos = geoRef.current.attributes.position.array;
        const orig = originalPos.current;
        for (let i = 0; i < pos.length; i++) {
          pos[i] = orig[i] + (((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) - 0.5) * 0.12;
        }
        geoRef.current.attributes.position.needsUpdate = true;
      }
    }
  });

  return (
    <mesh>
      <planeGeometry args={args} ref={geoRef} />
      <meshBasicMaterial
        color={color}
        wireframe={true}
        transparent={true}
        opacity={opacity}
        alphaMap={alphaMap}
        alphaTest={0.01} // Zero-tolerance: only pure #000000 black is hollowed
        blending={AdditiveBlending}
        depthWrite={false}
        side={DoubleSide}
      />
    </mesh>
  );
};

const SpinningGrid = ({ bot }) => {
  const groupRef = useRef();
  const holoMagentaRef = useRef();
  const holoBlueRef = useRef();
  
  const botIdStr = bot?.id || 'sovereignty';
  const botColor1 = bot?.palette?.primary || bot?.color || '#06b6d4';
  const botColor2 = '#ffffff'; // The secondary color can just be white for maximum contrast on the inner core

  const colorMap = useLoader(TextureLoader, `/bots/${botIdStr}_front.png`);
  const backColorMap = useLoader(TextureLoader, `/bots/${botIdStr}_back.png`);
  const frontMagentaLightRef = useRef();
  const frontBlueLightRef = useRef();
  const magentaLightRef = useRef();
  const blueLightRef = useRef();

  useEffect(() => {
    // Crop out the transparent empty space on the left and right sides of the textures
    // so the solid metal physically reaches all the way to the overlapping edges of the cylinders
    [colorMap, backColorMap].forEach((tex) => {
      tex.repeat.set(0.75, 1);
      tex.offset.set(0.125, 0);
      tex.needsUpdate = true;
    });
  }, [colorMap, backColorMap]);

  useFrame((state) => {
    const t = state.clock.elapsedTime;

    if (groupRef.current) {
      // Add organic idle micro-movements (saccades) so the bot looks alive and scanning
      const idleY = Math.sin(t * 1.5) * 0.08 + Math.sin(t * 0.4) * 0.15;
      const idleX = Math.cos(t * 1.2) * 0.05;

      // Smoothly rotate the entire 3D head based on mouse position + organic idle drift
      const maxPan = 75 * (Math.PI / 180); // 75 degrees Left/Right
      const maxTilt = 80 * (Math.PI / 180); // 80 degrees Up/Down

      // Scale pointer heavily to ensure they can easily reach the hard clamps
      const rawTargetY = state.pointer.x * (maxPan * 1.5) + idleY;
      const rawTargetX = -state.pointer.y * (maxTilt * 1.5) + idleX;

      // Strictly clamp to the requested degrees
      const targetY = Math.max(-maxPan, Math.min(maxPan, rawTargetY));
      const targetX = Math.max(-maxTilt, Math.min(maxTilt, rawTargetX));

      // Very slight vertical floating for breathability, shifted down slightly
      groupRef.current.position.y = -0.3 + Math.sin(t * 1.5) * 0.05;
      groupRef.current.rotation.y +=
        (targetY - groupRef.current.rotation.y) * 0.1;
      groupRef.current.rotation.x +=
        (targetX - groupRef.current.rotation.x) * 0.1;
    }

    // Power surge flickering on the environmental lights to make the metal reflections alive
    const flicker = ((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) > 0.85 ? ((globalThis.crypto?crypto.getRandomValues(new Uint32Array(1))[0]/4294967295:Date.now()%1000/1000)) * 0.5 + 0.5 : 1.0;
    if (magentaLightRef.current)
      magentaLightRef.current.intensity =
        20 * flicker * (1 + Math.sin(t * 2.1) * 0.2);
    if (blueLightRef.current)
      blueLightRef.current.intensity =
        20 * flicker * (1 + Math.cos(t * 2.4) * 0.2);
    if (frontMagentaLightRef.current)
      frontMagentaLightRef.current.intensity =
        25 + Math.sin(t * 18.0) * 15 * flicker;
    if (frontBlueLightRef.current)
      frontBlueLightRef.current.intensity =
        25 + Math.cos(t * 15.0) * 15 * flicker;
  });

  return (
    <>
      {/* Dynamic Lighting moved inside component for useFrame animation */}
      <pointLight
        position={[-4, 0, 3]}
        intensity={20}
        color={botColor1}
        ref={magentaLightRef}
      />
      <pointLight
        position={[4, 0, 3]}
        intensity={20}
        color={botColor2}
        ref={blueLightRef}
      />
      <pointLight
        position={[-2, 2, 5]}
        intensity={25}
        color={botColor1}
        ref={frontMagentaLightRef}
      />
      <pointLight
        position={[2, 2, 5]}
        intensity={25}
        color={botColor2}
        ref={frontBlueLightRef}
      />

      <group ref={groupRef} scale={0.45}>
        {/* 3D Rotating Electric Holosphere (Rounded side back, Flat grid side front) */}
        <group position={[0, 0, -0.2]}>
          {/* Rotating Group containing both the dome and the flat base */}
          <group ref={holoBlueRef}>
            {/* Group to perfectly center the masks over the wireframe spheres */}
            <group position={[0, 0, -0.2]}>
              {/* 3D Curved Tiger Faceplate (Stacked concentric layers to create physical armor thickness) */}
              {Array.from({ length: 20 }).map((_, i) => {
                const radius = 2.2 - i * 0.012; // Wider curve radius
                const isOuter = i === 0;
                const isInnerCore = i > 0 && i < 19;
                return (
                  <mesh key={`mask-layer-${i}`}>
                    <cylinderGeometry
                      args={[
                        radius,
                        radius,
                        4.5,
                        64,
                        64,
                        true,
                        -Math.PI * 0.6,
                        Math.PI * 1.2,
                      ]}
                    />
                    <meshPhysicalMaterial
                      map={colorMap}
                      emissiveMap={colorMap}
                      emissive="#ffffff"
                      emissiveIntensity={isOuter ? 0.8 : 1.6}
                      metalness={1.0}
                      roughness={0.05}
                      transparent={true}
                      depthWrite={false}
                      alphaMap={colorMap}
                      side={DoubleSide}
                    />
                  </mesh>
                );
              })}

              {/* 3D Curved Tiger Back Mask (Identical stacked concentric layers, pointing backwards) */}
              <group rotation={[0, Math.PI, 0]}>
                {Array.from({ length: 20 }).map((_, i) => {
                  const radius = 2.2 - i * 0.012; // Radius perfectly matches front mask so edges touch
                  const isOuter = i === 0;
                  return (
                    <mesh key={`back-mask-layer-${i}`}>
                      <cylinderGeometry
                        args={[
                          radius,
                          radius,
                          4.5,
                          64,
                          64,
                          true,
                          -Math.PI * 0.6,
                          Math.PI * 1.2,
                        ]}
                      />
                      <meshPhysicalMaterial
                        map={backColorMap}
                        emissiveMap={backColorMap}
                        emissive="#ffffff"
                        emissiveIntensity={isOuter ? 0.8 : 1.6}
                        metalness={1.0}
                        roughness={0.05}
                        transparent={true}
                        depthWrite={false}
                        alphaMap={backColorMap}
                        side={DoubleSide}
                      />
                    </mesh>
                  );
                })}
              </group>

              {/* Solid Pitch-Black Eye Blockers (Blocks internal lightning from bleeding through the hollow eye sockets) */}
              <mesh position={[0, 0.25, 0.4]}>
                <cylinderGeometry
                  args={[1.8, 1.8, 0.6, 32, 1, true, -0.6, 1.2]}
                />
                <meshBasicMaterial color="#000000" side={DoubleSide} />
              </mesh>
            </group>

            {/* Dual Color Electrified Inner Core */}
            <group position={[0, 0, -0.2]}>
              {/* Plasma Arcs radiating from the core */}
              {Array.from({ length: 200 }).map((_, i) => (
                <PlasmaArc key={`pm-${i}`} radius={1.85} color={botColor1} />
              ))}
              {Array.from({ length: 200 }).map((_, i) => (
                <PlasmaArc key={`pc-${i}`} radius={1.9} color={botColor2} />
              ))}

              {/* Volatile Wireframe Grid Sphere */}
              <ElectrifiedSphere
                args={[1.85, 24, 24]}
                color={botColor1}
                opacity={0.8}
                pulseSpeed={3}
                pulseIntensity={0.06}
              />
              <ElectrifiedSphere
                args={[1.9, 24, 24]}
                color={botColor2}
                opacity={1.0}
                pulseSpeed={3}
                pulseIntensity={0.08}
              />
            </group>
          </group>
        </group>
      </group>
    </>
  );
};

const BiomechanicalBotHead = ({ size = "100%", bot }) => {
  return (
    <div
      className="absolute inset-0 flex items-center justify-center pointer-events-none"
      style={{ width: size, height: size }}
    >
      <Canvas
        camera={{ position: [0, 0, 5.5], fov: 50 }}
        style={{ width: "100%", height: "100%", background: "transparent" }}
      >
        <ambientLight intensity={0.5} />
        <Suspense fallback={null}>
          {/* Global Floating Animation */}
          <Float speed={2.5} rotationIntensity={0.5} floatIntensity={1.2}>
            <SpinningGrid bot={bot} />
          </Float>
        </Suspense>
      </Canvas>
    </div>
  );
};

export default BiomechanicalBotHead;
