import React, { useState, useEffect } from 'react';
import { Shield, Key, Activity, Clock, AlertTriangle } from 'lucide-react';
import TruthBadge from './TruthBadge.jsx';
import { getProviderGateStatus, getProviderReceipts } from '../services/provider-status-client.js';

/**
 * PH EVO STUDIO — PROVIDER STATUS PANEL v2
 * Multi-layout fusion: Nexus x Terminal x Tactical x Hologram x Retro
 * - Animated gradients, holographic border, particle halo
 * - Micro-interactions on hover
 * - Live status pulses & activity streak bar
 */
export default function ProviderStatusPanel() {
  const [gates, setGates] = useState({});
  const [receipts, setReceipts] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [hoveredProvider, setHoveredProvider] = useState(null);
  const [activeFilter, setActiveFilter] = useState('all'); // all | good | warning | bad

  useEffect(() => {
    let cancelled = false;

    async function load() {
      setLoading(true);
      try {
        const [gateResult, receiptResult] = await Promise.all([
          getProviderGateStatus(),
          getProviderReceipts(20),
        ]);
        if (cancelled) return;
        setGates(gateResult.gates || {});
        setReceipts(receiptResult.receipts || []);
        setError(gateResult.ok ? null : gateResult.error);
      } catch (err) {
        if (!cancelled) setError(err.message);
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    load();
    return () => { cancelled = true; };
  }, []);

  const providers = Object.entries(gates);

  const truthToFilter = (truthState) => {
    if (!truthState) return 'warning';
    const s = String(truthState).toLowerCase();
    if (s.includes('bad') || s.includes('fail') || s.includes('false')) return 'bad';
    if (s.includes('warn') || s.includes('unknown')) return 'warning';
    return 'good';
  };

  const filteredProviders = providers.filter(([_, info]) => {
    if (activeFilter === 'all') return true;
    return truthToFilter(info.truthState) === activeFilter;
  });

  const allOk = !loading && !error && providers.length > 0 && providers.every(([, info]) => truthToFilter(info.truthState) === 'good');
  const anyBad = providers.some(([, info]) => truthToFilter(info.truthState) === 'bad');

  const statusLabel = loading
    ? 'Syncing gates...'
    : error
      ? 'Degraded'
      : allOk
        ? 'All clear'
        : anyBad
          ? 'Critical'
          : 'Mixed';

  const statusTone =
    loading ? 'terminal' :
    error ? 'forge' :
    allOk ? 'nexus' :
    anyBad ? 'tactical' :
    'royal';

  const statusColorMap = {
    nexus: 'var(--accent-cyan)',
    terminal: 'var(--accent-yellow)',
    royal: 'var(--accent-violet)',
    forge: 'var(--accent-red)',
    tactical: 'var(--accent-orange, #f97316)',
  };

  const statusColor = statusColorMap[statusTone] || 'var(--accent-cyan)';

  return (
    <div
      className={[
        'ph-panel',
        'layout-fusion',
        'anim-nexus',
        'anim-terminal',
        'anim-hologram',
        'anim-tactical',
      ].join(' ')}
      style={{
        position: 'relative',
        padding: '22px 22px 20px',
        background:
          'radial-gradient(circle at 0% 0%, rgba(56, 189, 248, 0.14), transparent 55%), ' +
          'radial-gradient(circle at 100% 0%, rgba(129, 140, 248, 0.16), transparent 55%), ' +
          'linear-gradient(145deg, rgba(12, 10, 24, 0.95), rgba(4, 7, 20, 0.98))',
        borderRadius: '18px',
        border: '1px solid rgba(148, 163, 184, 0.45)',
        boxShadow:
          '0 0 0 1px rgba(15, 23, 42, 0.9), ' +
          '0 0 35px rgba(56, 189, 248, 0.20), ' +
          '0 0 60px rgba(129, 140, 248, 0.18)',
        display: 'flex',
        flexDirection: 'column',
        gap: '20px',
        overflow: 'hidden',
        backdropFilter: 'blur(18px) saturate(140%)',
        transform: 'translateZ(0)',
      }}
    >
      {/* Holographic border sweep */}
      <div
        className="ph-holo-sweep anim-hologram"
        aria-hidden="true"
        style={{
          pointerEvents: 'none',
          position: 'absolute',
          inset: 0,
          borderRadius: 'inherit',
          background:
            'conic-gradient(from 210deg, transparent 0deg, rgba(59,130,246,0.0) 80deg, rgba(56,189,248,0.4) 140deg, rgba(129,140,248,0.35) 220deg, transparent 280deg)',
          opacity: 0.0,
          mixBlendMode: 'screen',
          animation: 'ph-holoOrbit 18s linear infinite',
        }}
      />

      {/* Particle halo */}
      <div
        className="ph-particle-halo anim-genome"
        aria-hidden="true"
        style={{
          position: 'absolute',
          top: '-35%',
          left: '-15%',
          width: '60%',
          height: '120%',
          background:
            'radial-gradient(circle at 20% 30%, rgba(56,189,248,0.20), transparent 60%), ' +
            'radial-gradient(circle at 60% 70%, rgba(129,140,248,0.16), transparent 65%)',
          opacity: 0.55,
          filter: 'blur(24px)',
          mixBlendMode: 'screen',
          pointerEvents: 'none',
        }}
      />

      {/* Retro scanline overlay */}
      <div
        className="ph-scanlines anim-retro"
        aria-hidden="true"
        style={{
          position: 'absolute',
          inset: 0,
          backgroundImage:
            'repeating-linear-gradient(to bottom, rgba(15,23,42,0.08) 0px, rgba(15,23,42,0.08) 1px, transparent 1px, transparent 2px)',
          opacity: 0.45,
          mixBlendMode: 'soft-light',
          pointerEvents: 'none',
        }}
      />

      {/* Panel header row */}
      <div
        style={{
          position: 'relative',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          gap: '14px',
          zIndex: 2,
        }}
      >
        {/* Left: Icon + title */}
        <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
          <div
            className="ph-icon-orbit anim-nexus"
            style={{
              position: 'relative',
              width: '40px',
              height: '40px',
              borderRadius: '14px',
              background:
                'radial-gradient(circle at 30% 10%, rgba(248,250,252,0.9), rgba(248,250,252,0.1)), ' +
                'linear-gradient(135deg, rgba(59,130,246,0.85), rgba(56,189,248,0.95), rgba(129,140,248,0.90))',
              boxShadow:
                '0 0 0 1px rgba(15,23,42,0.9), ' +
                '0 10px 30px rgba(56,189,248,0.40), ' +
                '0 0 25px rgba(129,140,248,0.45)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              overflow: 'hidden',
              transform: 'translateZ(0)',
            }}
          >
            {/* Inner rotating ring */}
            <div
              style={{
                position: 'absolute',
                width: '110%',
                height: '110%',
                borderRadius: '50%',
                border: '1px solid rgba(15,23,42,0.45)',
                boxShadow: '0 0 0 1px rgba(148,163,184,0.45) inset',
                mixBlendMode: 'soft-light',
                animation: 'ph-orbitRing 18s linear infinite',
              }}
            />
            {/* Status pulse behind icon */}
            <div
              style={{
                position: 'absolute',
                width: '145%',
                height: '145%',
                borderRadius: '999px',
                background: `radial-gradient(circle, ${statusColor} 0%, transparent 60%)`,
                opacity: 0.18,
                filter: 'blur(4px)',
                animation: 'ph-pulseSoft 3.8s ease-out infinite',
              }}
            />
            <Shield size={19} color="#020617" />
          </div>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '2px' }}>
            <div
              style={{
                fontSize: '15px',
                fontWeight: 800,
                letterSpacing: '0.04em',
                textTransform: 'uppercase',
                color: 'var(--text-primary)',
                display: 'flex',
                alignItems: 'center',
                gap: '6px',
              }}
            >
              Provider Gates
              <span
                className="anim-terminal"
                style={{
                  fontSize: '9px',
                  padding: '2px 6px',
                  borderRadius: '999px',
                  background: 'rgba(15,23,42,0.85)',
                  border: '1px solid rgba(148,163,184,0.55)',
                  color: 'var(--text-muted)',
                  textTransform: 'uppercase',
                  letterSpacing: '0.16em',
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: '4px',
                }}
              >
                <span
                  style={{
                    width: '6px',
                    height: '6px',
                    borderRadius: '999px',
                    background: loading
                      ? 'rgba(251,191,36,1)'
                      : error
                        ? 'rgba(239,68,68,1)'
                        : allOk
                          ? 'rgba(52,211,153,1)'
                          : anyBad
                            ? 'rgba(248,113,113,1)'
                            : 'rgba(56,189,248,1)',
                    boxShadow: `0 0 6px ${statusColor}`,
                  }}
                />
                LIVE
              </span>
            </div>
            <div
              style={{
                fontSize: '10px',
                fontWeight: 600,
                color: 'var(--text-muted)',
                textTransform: 'uppercase',
                letterSpacing: '0.18em',
                opacity: 0.9,
              }}
            >
              Credential Integrity • Truth Telemetry
            </div>
          </div>
        </div>

        {/* Right: Status pill + mini activity bar */}
        <div
          className="ph-status-cluster anim-tactical"
          style={{
            display: 'flex',
            flexDirection: 'column',
            alignItems: 'flex-end',
            gap: '8px',
            minWidth: '160px',
          }}
        >
          <div
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: '6px',
              padding: '4px 10px',
              borderRadius: '999px',
              background:
                'linear-gradient(135deg, rgba(15,23,42,0.95), rgba(15,23,42,0.7))',
              border: `1px solid ${statusColor}`,
              boxShadow: `0 0 14px rgba(56,189,248,0.35)`,
              fontSize: '10px',
              textTransform: 'uppercase',
              letterSpacing: '0.16em',
              fontWeight: 700,
              color: 'var(--text-secondary)',
            }}
          >
            <span
              className="anim-genome"
              style={{
                position: 'relative',
                width: '8px',
                height: '8px',
                borderRadius: '999px',
                backgroundColor: statusColor,
                boxShadow: `0 0 12px ${statusColor}`,
                overflow: 'hidden',
              }}
            >
              <span
                style={{
                  position: 'absolute',
                  inset: '-40%',
                  borderRadius: 'inherit',
                  background:
                    'conic-gradient(from 0deg, rgba(248,250,252,0.9), transparent 80deg, transparent 200deg, rgba(248,250,252,0.9) 340deg)',
                  opacity: 0.8,
                  animation: 'ph-orbitFast 2.5s linear infinite',
                }}
              />
            </span>
            <span>{statusLabel}</span>
          </div>

          {/* Activity streak bar */}
          <div
            className="ph-activity-bar anim-forge"
            style={{
              position: 'relative',
              width: '100%',
              height: '8px',
              borderRadius: '999px',
              background:
                'linear-gradient(90deg, rgba(15,23,42,0.9), rgba(15,23,42,0.8))',
              border: '1px solid rgba(30,64,175,0.7)',
              overflow: 'hidden',
            }}
          >
            <div
              style={{
                position: 'absolute',
                inset: 0,
                opacity: 0.3,
                background:
                  'linear-gradient(90deg, rgba(56,189,248,0), rgba(56,189,248,0.8), rgba(129,140,248,0.7), rgba(56,189,248,0))',
                transform: 'translateX(-30%)',
                animation: 'ph-scan 9s linear infinite',
              }}
            />
            <div
              style={{
                position: 'absolute',
                inset: 1,
                borderRadius: 'inherit',
                background:
                  'repeating-linear-gradient(90deg, rgba(37,99,235,0.9) 0px, rgba(56,189,248,0.95) 6px, rgba(15,23,42,0.9) 8px)',
                opacity: 0.18,
                mixBlendMode: 'screen',
              }}
            />
          </div>
        </div>
      </div>

      {/* Filter + meta row */}
      <div
        style={{
          position: 'relative',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          gap: '12px',
          fontSize: '11px',
          color: 'var(--text-muted)',
          zIndex: 2,
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
          <span
            style={{
              fontFamily: 'var(--font-mono)',
              fontSize: '10px',
              letterSpacing: '0.14em',
              textTransform: 'uppercase',
              opacity: 0.85,
            }}
          >
            {providers.length} Gate{providers.length === 1 ? '' : 's'} • {receipts.length} Receipt
            {receipts.length === 1 ? '' : 's'}
          </span>
          <span
            style={{
              width: '1px',
              height: '14px',
              background:
                'linear-gradient(to bottom, transparent, rgba(148,163,184,0.6), transparent)',
              opacity: 0.7,
            }}
          />
          {hoveredProvider && (
            <span
              className="anim-clean"
              style={{
                fontFamily: 'var(--font-mono)',
                fontSize: '10px',
                color: 'var(--accent-cyan)',
                textTransform: 'uppercase',
                letterSpacing: '0.18em',
              }}
            >
              ↑ Focus: {hoveredProvider}
            </span>
          )}
        </div>

        {/* Filter pills */}
        <div
          className="ph-filter-pills anim-royal"
          style={{
            display: 'inline-flex',
            alignItems: 'center',
            gap: '4px',
            padding: '3px',
            borderRadius: '999px',
            background:
              'linear-gradient(135deg, rgba(15,23,42,0.9), rgba(15,23,42,0.7))',
            border: '1px solid rgba(51,65,85,0.9)',
          }}
        >
          {[
            { id: 'all', label: 'All' },
            { id: 'good', label: 'Trusted' },
            { id: 'warning', label: 'Review' },
            { id: 'bad', label: 'Critical' },
          ].map((f) => {
            const active = activeFilter === f.id;
            const palette =
              f.id === 'good'
                ? 'var(--accent-emerald, #22c55e)'
                : f.id === 'warning'
                  ? 'var(--accent-yellow, #eab308)'
                  : f.id === 'bad'
                    ? 'var(--accent-red, #ef4444)'
                    : 'var(--accent-cyan)';
            return (
              <button
                key={f.id}
                type="button"
                onClick={() => setActiveFilter(f.id)}
                className="ph-filter-pill"
                style={{
                  position: 'relative',
                  border: 'none',
                  outline: 'none',
                  cursor: 'pointer',
                  padding: '3px 9px',
                  borderRadius: '999px',
                  fontSize: '10px',
                  fontWeight: 600,
                  letterSpacing: '0.14em',
                  textTransform: 'uppercase',
                  background: active
                    ? `radial-gradient(circle at 0% 0%, rgba(248,250,252,0.24), rgba(248,250,252,0.04)), linear-gradient(135deg, ${palette}, rgba(15,23,42,0.9))`
                    : 'transparent',
                  color: active ? '#0b1120' : 'var(--text-muted)',
                  boxShadow: active
                    ? `0 0 0 1px rgba(15,23,42,1), 0 0 12px ${palette}`
                    : 'none',
                  transition:
                    'background 160ms ease-out, color 160ms ease-out, box-shadow 160ms ease-out, transform 160ms ease-out',
                  transform: active ? 'translateY(-1px)' : 'translateY(0)',
                }}
              >
                {f.label}
              </button>
            );
          })}
        </div>
      </div>

      {/* Loading state */}
      {loading && (
        <div
          className="ph-loading anim-terminal"
          style={{
            position: 'relative',
            padding: '26px 18px 22px',
            borderRadius: '14px',
            border: '1px dashed rgba(148,163,184,0.65)',
            background:
              'linear-gradient(135deg, rgba(15,23,42,0.85), rgba(15,23,42,0.95))',
            color: 'var(--text-dim)',
            fontSize: '12px',
            overflow: 'hidden',
          }}
        >
          <div
            style={{
              position: 'absolute',
              inset: 0,
              background:
                'repeating-linear-gradient(90deg, rgba(15,23,42,0.8) 0, rgba(15,23,42,0.8) 2px, rgba(51,65,85,0.22) 3px)',
              opacity: 0.35,
              mixBlendMode: 'soft-light',
              pointerEvents: 'none',
            }}
          />
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: '10px',
              position: 'relative',
              zIndex: 1,
            }}
          >
            <div
              style={{
                width: '16px',
                height: '16px',
                borderRadius: '999px',
                border: '2px solid rgba(148,163,184,0.8)',
                borderTopColor: 'rgba(56,189,248,0.95)',
                animation: 'ph-spin 0.9s linear infinite',
              }}
            />
            <div style={{ display: 'flex', flexDirection: 'column', gap: '2px' }}>
              <span
                style={{
                  fontFamily: 'var(--font-mono)',
                  fontSize: '11px',
                  letterSpacing: '0.1em',
                  textTransform: 'uppercase',
                }}
              >
                Syncing provider status…
              </span>
              <span
                style={{
                  fontFamily: 'var(--font-mono)',
                  fontSize: '10px',
                  color: 'var(--text-muted)',
                  opacity: 0.9,
                }}
              >
                Establishing secure tunnel • Verifying receipts • Calibrating truth orbits
              </span>
            </div>
          </div>
        </div>
      )}

      {/* Error state */}
      {error && !loading && (
        <div
          className="ph-error anim-forge"
          style={{
            position: 'relative',
            padding: '14px 16px',
            background:
              'radial-gradient(circle at 0% 0%, rgba(248,113,113,0.24), rgba(15,23,42,0.95))',
            border: '1px solid rgba(239,68,68,0.6)',
            borderRadius: '14px',
            display: 'flex',
            alignItems: 'center',
            gap: '9px',
            color: 'var(--accent-red)',
            fontSize: '12px',
            boxShadow:
              '0 0 24px rgba(239,68,68,0.5), 0 0 0 1px rgba(15,23,42,1) inset',
            overflow: 'hidden',
          }}
        >
          <div
            style={{
              position: 'absolute',
              inset: '-40%',
              background:
                'radial-gradient(circle, rgba(239,68,68,0.45), transparent 55%)',
              opacity: 0.3,
              filter: 'blur(16px)',
              pointerEvents: 'none',
            }}
          />
          <AlertTriangle size={14} />
          <div style={{ display: 'flex', flexDirection: 'column', gap: '2px' }}>
            <div
              style={{
                fontWeight: 700,
                letterSpacing: '0.08em',
                textTransform: 'uppercase',
                fontSize: '10px',
              }}
            >
              Bridge status: degraded
            </div>
            <div style={{ fontFamily: 'var(--font-mono)', fontSize: '11px' }}>
              {error}
            </div>
          </div>
        </div>
      )}

      {/* Provider gates */}
      {!loading && !error && providers.length > 0 && (
        <div
          style={{
            position: 'relative',
            display: 'grid',
            gridTemplateColumns: 'minmax(0, 1.1fr) minmax(0, 1fr)',
            gap: '18px',
            alignItems: 'flex-start',
            zIndex: 2,
          }}
        >
          {/* Left: credentials list */}
          <div
            className="ph-cred-column anim-cloud"
            style={{
              display: 'flex',
              flexDirection: 'column',
              gap: '9px',
            }}
          >
            <div
              style={{
                fontSize: '10px',
                fontWeight: 800,
                color: 'var(--text-muted)',
                textTransform: 'uppercase',
                letterSpacing: '0.16em',
                marginBottom: '2px',
                display: 'flex',
                alignItems: 'center',
                gap: '8px',
              }}
            >
              <span>Credentials</span>
              <span
                style={{
                  flex: 1,
                  height: '1px',
                  background:
                    'linear-gradient(to right, rgba(51,65,85,0.8), transparent)',
                  opacity: 0.7,
                }}
              />
            </div>

            <div
              style={{
                display: 'flex',
                flexDirection: 'column',
                gap: '8px',
                maxHeight: '240px',
                overflow: 'auto',
                paddingRight: '4px',
              }}
            >
              {filteredProviders.map(([label, info]) => {
                const truthClass = truthToFilter(info.truthState);
                const baseGlow =
                  truthClass === 'good'
                    ? 'rgba(52,211,153,0.45)'
                    : truthClass === 'warning'
                      ? 'rgba(234,179,8,0.45)'
                      : truthClass === 'bad'
                        ? 'rgba(239,68,68,0.6)'
                        : 'rgba(56,189,248,0.45)';

                return (
                  <div
                    key={label}
                    className={[
                      'ph-cred-row',
                      'anim-tactical',
                      truthClass === 'bad' ? 'anim-forge' : '',
                    ].join(' ')}
                    onMouseEnter={() => setHoveredProvider(label)}
                    onMouseLeave={() => setHoveredProvider(null)}
                    style={{
                      position: 'relative',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'space-between',
                      padding: '9px 13px',
                      background:
                        'radial-gradient(circle at 0% 0%, rgba(15,23,42,0.9), rgba(15,23,42,0.95))',
                      borderRadius: '12px',
                      border: '1px solid rgba(51,65,85,0.9)',
                      boxShadow:
                        hoveredProvider === label
                          ? `0 0 0 1px rgba(15,23,42,1), 0 0 22px ${baseGlow}`
                          : `0 0 0 1px rgba(15,23,42,1), 0 0 10px rgba(15,23,42,0.9)`,
                      fontSize: '12px',
                      cursor: 'default',
                      overflow: 'hidden',
                      transition:
                        'box-shadow 160ms ease-out, transform 160ms ease-out, border-color 160ms ease-out, background 160ms ease-out',
                      transform:
                        hoveredProvider === label
                          ? 'translateY(-1px) translateZ(0)'
                          : 'translateY(0) translateZ(0)',
                    }}
                  >
                    {/* Glow overlay when focused */}
                    <div
                      aria-hidden="true"
                      style={{
                        position: 'absolute',
                        inset: '-40%',
                        background: `radial-gradient(circle, ${baseGlow}, transparent 55%)`,
                        opacity: hoveredProvider === label ? 0.34 : 0.12,
                        filter: 'blur(18px)',
                        pointerEvents: 'none',
                        transition: 'opacity 160ms ease-out',
                      }}
                    />

                    <div
                      style={{
                        position: 'relative',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '9px',
                        zIndex: 1,
                      }}
                    >
                      <div
                        style={{
                          position: 'relative',
                          width: '18px',
                          height: '18px',
                          borderRadius: '999px',
                          background:
                            'radial-gradient(circle at 30% 20%, rgba(248,250,252,0.9), rgba(248,250,252,0.08))',
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'center',
                          boxShadow:
                            '0 0 0 1px rgba(30,64,175,0.7), 0 5px 12px rgba(15,23,42,0.9)',
                        }}
                      >
                        <Key size={11} color="#020617" />
                        <span
                          style={{
                            position: 'absolute',
                            inset: '-50%',
                            borderRadius: 'inherit',
                            border: '1px solid rgba(148,163,184,0.7)',
                            opacity: 0.4,
                            mixBlendMode: 'soft-light',
                          }}
                        />
                      </div>
                      <div
                        style={{
                          display: 'flex',
                          flexDirection: 'column',
                          gap: '0px',
                        }}
                      >
                        <span
                          style={{
                            fontWeight: 700,
                            color: 'var(--text-secondary)',
                            textTransform: 'capitalize',
                            letterSpacing: '0.04em',
                          }}
                        >
                          {label}
                        </span>
                        {info.redacted && (
                          <span
                            style={{
                              fontFamily: 'var(--font-mono)',
                              fontSize: '10px',
                              color: 'var(--text-muted)',
                              letterSpacing: '0.06em',
                            }}
                          >
                            {info.redacted}
                          </span>
                        )}
                      </div>
                    </div>

                    <div
                      style={{
                        position: 'relative',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '8px',
                        zIndex: 1,
                      }}
                    >
                      {/* Tiny vertical spark line indicator */}
                      <div
                        className="ph-sparkline anim-genome"
                        aria-hidden="true"
                        style={{
                          width: '22px',
                          height: '10px',
                          borderRadius: '999px',
                          background:
                            'linear-gradient(90deg, rgba(15,23,42,1), rgba(15,23,42,1))',
                          border: '1px solid rgba(30,64,175,0.9)',
                          overflow: 'hidden',
                          opacity: 0.7,
                        }}
                      >
                        <div
                          style={{
                            width: '200%',
                            height: '100%',
                            background:
                              'repeating-linear-gradient(90deg, rgba(56,189,248,0.9) 0, rgba(56,189,248,0.9) 2px, transparent 4px)',
                            transform: 'translateX(-35%)',
                            animation: 'ph-sparkDrift 7s linear infinite',
                          }}
                        />
                      </div>
                      <TruthBadge state={info.truthState} compact />
                    </div>
                  </div>
                );
              })}

              {filteredProviders.length === 0 && (
                <div
                  style={{
                    padding: '18px 14px',
                    borderRadius: '12px',
                    border: '1px dashed rgba(148,163,184,0.5)',
                    background:
                      'linear-gradient(145deg, rgba(15,23,42,0.9), rgba(15,23,42,0.95))',
                    fontSize: '11px',
                    color: 'var(--text-dim)',
                    textAlign: 'center',
                  }}
                >
                  No providers in this filter window. Adjust the filter above to see more gates.
                </div>
              )}
            </div>
          </div>

          {/* Right: recent receipts */}
          {receipts.length > 0 && (
            <div
              className="ph-receipts-column anim-hologram"
              style={{
                display: 'flex',
                flexDirection: 'column',
                gap: '9px',
              }}
            >
              <div
                style={{
                  fontSize: '10px',
                  fontWeight: 800,
                  color: 'var(--text-muted)',
                  textTransform: 'uppercase',
                  letterSpacing: '0.16em',
                  marginBottom: '2px',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '8px',
                }}
              >
                <span>Recent Receipts</span>
                <span
                  style={{
                    flex: 1,
                    height: '1px',
                    background:
                      'linear-gradient(to right, rgba(51,65,85,0.8), transparent)',
                    opacity: 0.7,
                  }}
                />
              </div>

              <div
                style={{
                  display: 'flex',
                  flexDirection: 'column',
                  gap: '7px',
                  maxHeight: '240px',
                  overflow: 'auto',
                  paddingRight: '4px',
                }}
              >
                {receipts.slice(0, 10).map((r, idx) => (
                  <div
                    key={r.id}
                    className="ph-receipt-row anim-royal"
                    style={{
                      position: 'relative',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'space-between',
                      padding: '8px 12px',
                      background:
                        'radial-gradient(circle at 100% 0%, rgba(30,64,175,0.55), rgba(15,23,42,0.98))',
                      borderRadius: '11px',
                      border: '1px solid rgba(30,64,175,0.9)',
                      fontSize: '11px',
                      boxShadow:
                        '0 0 0 1px rgba(15,23,42,1), 0 8px 14px rgba(15,23,42,0.9)',
                      overflow: 'hidden',
                      transform: 'translateZ(0)',
                      transition: 'transform 150ms ease-out, box-shadow 150ms ease-out',
                    }}
                  >
                    {/* Quick hover lift via group hover in CSS, simulated inline */}
                    <div
                      style={{
                        position: 'absolute',
                        inset: '-40%',
                        background:
                          'radial-gradient(circle, rgba(56,189,248,0.21), transparent 60%)',
                        opacity: 0.22,
                        filter: 'blur(14px)',
                        pointerEvents: 'none',
                      }}
                    />
                    <div
                      style={{
                        position: 'relative',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '9px',
                        zIndex: 1,
                      }}
                    >
                      <div
                        style={{
                          position: 'relative',
                          width: '16px',
                          height: '16px',
                          borderRadius: '999px',
                          background:
                            'radial-gradient(circle at 20% 20%, rgba(248,250,252,0.85), rgba(248,250,252,0.08))',
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'center',
                          boxShadow:
                            '0 0 0 1px rgba(30,64,175,0.9), 0 6px 14px rgba(15,23,42,0.9)',
                        }}
                      >
                        <Activity size={10} color="#020617" />
                      </div>
                      <div
                        style={{
                          display: 'flex',
                          flexDirection: 'column',
                          gap: '1px',
                        }}
                      >
                        <span
                          style={{
                            fontWeight: 700,
                            color: 'var(--text-secondary)',
                            letterSpacing: '0.03em',
                          }}
                        >
                          {r.provider}
                        </span>
                        <span
                          style={{
                            color: 'var(--text-dim)',
                            fontFamily: 'var(--font-mono)',
                            fontSize: '10px',
                          }}
                        >
                          {r.action}
                        </span>
                      </div>
                    </div>

                    <div
                      style={{
                        position: 'relative',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '8px',
                        zIndex: 1,
                      }}
                    >
                      <TruthBadge state={r.truthState} compact />
                      <span
                        style={{
                          fontFamily: 'var(--font-mono)',
                          fontSize: '9px',
                          color: 'var(--text-muted)',
                          display: 'inline-flex',
                          alignItems: 'center',
                          gap: '3px',
                        }}
                      >
                        <Clock size={9} />
                        {new Date(r.createdAt).toLocaleTimeString()}
                      </span>
                      <span
                        style={{
                          fontFamily: 'var(--font-mono)',
                          fontSize: '9px',
                          color: 'var(--text-muted)',
                          opacity: 0.7,
                        }}
                      >
                        #{String(idx + 1).padStart(2, '0')}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      {/* Empty state */}
      {!loading && providers.length === 0 && !error && (
        <div
          className="ph-empty anim-clean"
          style={{
            position: 'relative',
            padding: '22px 18px 18px',
            textAlign: 'center',
            color: 'var(--text-dim)',
            fontSize: '13px',
            borderRadius: '14px',
            border: '1px dashed rgba(148,163,184,0.6)',
            background:
              'radial-gradient(circle at 50% 0%, rgba(56,189,248,0.12), rgba(15,23,42,0.96))',
            overflow: 'hidden',
          }}
        >
          <div
            style={{
              position: 'absolute',
              inset: '-40%',
              background:
                'radial-gradient(circle, rgba(148,163,184,0.35), transparent 60%)',
              opacity: 0.24,
              filter: 'blur(14px)',
              pointerEvents: 'none',
            }}
          />
          <div
            style={{
              fontFamily: 'var(--font-mono)',
              fontSize: '11px',
              letterSpacing: '0.14em',
              textTransform: 'uppercase',
              marginBottom: '4px',
            }}
          >
            No provider gates available
          </div>
          <div
            style={{
              fontFamily: 'var(--font-mono)',
              fontSize: '11px',
              color: 'var(--text-muted)',
            }}
          >
            Bridge may be offline or not yet initialized for this workspace.
          </div>
        </div>
      )}
    </div>
  );
}

/* Local animation keyframes injected into the runtime CSS-in-JS context.
   In a real system, these should live in a shared CSS file, but we inline
   them here to keep the component self-contained. */
if (typeof document !== 'undefined' && !document.getElementById('ph-provider-status-keyframes')) {
  const style = document.createElement('style');
  style.id = 'ph-provider-status-keyframes';
  style.innerHTML = `
    @keyframes ph-holoOrbit {
      0% { transform: rotate(0deg); opacity: 0.1; }
      40% { opacity: 0.25; }
      100% { transform: rotate(360deg); opacity: 0.1; }
    }
    @keyframes ph-orbitRing {
      0% { transform: rotate(0deg) scale(1); }
      50% { transform: rotate(180deg) scale(1.03); }
      100% { transform: rotate(360deg) scale(1); }
    }
    @keyframes ph-pulseSoft {
      0% { transform: scale(0.95); opacity: 0.18; }
      50% { transform: scale(1.05); opacity: 0.32; }
      100% { transform: scale(0.95); opacity: 0.18; }
    }
    @keyframes ph-orbitFast {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    @keyframes ph-scan {
      0% { transform: translateX(-80%); }
      100% { transform: translateX(60%); }
    }
    @keyframes ph-sparkDrift {
      0% { transform: translateX(-40%); }
      100% { transform: translateX(0%); }
    }
    @keyframes ph-spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  `;
  document.head.appendChild(style);
}

