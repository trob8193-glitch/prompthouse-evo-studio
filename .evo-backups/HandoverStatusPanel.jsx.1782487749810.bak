import React, { useState, useEffect } from 'react';
import TruthBadge from './TruthBadge.jsx';
import { getHandoverStatus } from '../services/handover-client.js';
import { TRUTH_STATES } from '../constants/truth-states.js';
import { AlertCircle, FileText, CheckCircle2, ShieldAlert } from 'lucide-react';

export default function HandoverStatusPanel() {
  const [status, setStatus] = useState(null);
  const [loading, setLoading] = useState(true);
  const [pulse, setPulse] = useState(false);

  useEffect(() => {
    let mounted = true;
    const fetchStatus = async () => {
      try {
        const res = await getHandoverStatus();
        if (mounted) {
          setStatus(res);
          setLoading(false);
          setPulse(true);
          setTimeout(() => setPulse(false), 800);
        }
      } catch (e) {
        if (mounted) {
          setStatus({ truthState: TRUTH_STATES.ERROR, data: null });
          setLoading(false);
        }
      }
    };
    fetchStatus();
    const interval = setInterval(fetchStatus, 5000);
    return () => {
      mounted = false;
      clearInterval(interval);
    };
  }, []);

  // Compute signal style
  const signalColor =
    status?.truthState === TRUTH_STATES.TRUE
      ? 'var(--accent-green)'
      : status?.truthState === TRUTH_STATES.WARNING
      ? 'var(--accent-orange)'
      : status?.truthState === TRUTH_STATES.ERROR
      ? 'var(--accent-red)'
      : 'var(--accent-cyan)';

  const signalLabel =
    status?.truthState === TRUTH_STATES.TRUE
      ? 'SYNCHRONIZED'
      : status?.truthState === TRUTH_STATES.WARNING
      ? 'DEGRADED'
      : status?.truthState === TRUTH_STATES.ERROR
      ? 'DISCONNECTED'
      : 'DISCOVERING';

  const lastUpdated =
    status?.data?.lastChecked ||
    (status ? new Date().toLocaleTimeString() : '—');

  if (loading) {
    return (
      <div
        className="proof-panel loading anim-cloud anim-hologram"
        style={{
          position: 'relative',
          padding: '20px',
          borderRadius: 'var(--radius-md)',
          overflow: 'hidden',
          background:
            'radial-gradient(circle at 0% 0%, rgba(56,189,248,0.16), transparent 55%), radial-gradient(circle at 100% 100%, rgba(147,51,234,0.18), transparent 60%), rgba(5,10,25,0.92)',
          border: '1px solid rgba(148,163,184,0.45)',
          boxShadow:
            '0 0 0 1px rgba(56,189,248,0.18), 0 18px 45px rgba(15,23,42,0.95)',
          backdropFilter: 'blur(16px)',
        }}
      >
        {/* Holographic scan sweep */}
        <div
          className="anim-nexus"
          style={{
            position: 'absolute',
            inset: 0,
            background:
              'linear-gradient(120deg, transparent 0%, rgba(56,189,248,0.12) 50%, transparent 100%)',
            mixBlendMode: 'screen',
            opacity: 0.4,
            pointerEvents: 'none',
            animation: 'ph-scan-sweep 2.4s linear infinite',
          }}
        />

        {/* Particle noise layer */}
        <div
          className="anim-genome"
          style={{
            position: 'absolute',
            inset: -30,
            backgroundImage:
              'radial-gradient(circle at 10% 20%, rgba(56,189,248,0.18) 0, transparent 55%), radial-gradient(circle at 80% 10%, rgba(236,72,153,0.18) 0, transparent 55%), radial-gradient(circle at 20% 90%, rgba(34,197,94,0.16) 0, transparent 60%)',
            opacity: 0.55,
            filter: 'blur(20px)',
            pointerEvents: 'none',
          }}
        />

        <div
          style={{
            position: 'relative',
            display: 'flex',
            alignItems: 'center',
            gap: '12px',
          }}
        >
          <div
            className="anim-terminal"
            style={{
              width: 18,
              height: 18,
              borderRadius: '999px',
              border: '2px solid rgba(148,163,184,0.7)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              position: 'relative',
              overflow: 'visible',
            }}
          >
            <div
              style={{
                width: 8,
                height: 8,
                borderRadius: '999px',
                background:
                  'conic-gradient(from 180deg, var(--accent-cyan), var(--accent-indigo), var(--accent-cyan))',
                boxShadow:
                  '0 0 12px rgba(56,189,248,0.7), 0 0 24px rgba(129,140,248,0.5)',
                animation: 'ph-core-pulse 1s ease-in-out infinite',
              }}
            />
            <div
              className="anim-royal"
              style={{
                position: 'absolute',
                inset: -8,
                borderRadius: 999,
                background:
                  'radial-gradient(circle, rgba(56,189,248,0.4), transparent 60%)',
                opacity: 0.55,
                filter: 'blur(4px)',
                animation: 'ph-orbit 1.6s linear infinite',
              }}
            />
          </div>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
            <span
              style={{
                fontSize: 13,
                letterSpacing: '0.18em',
                textTransform: 'uppercase',
                color: 'rgba(148,163,184,0.95)',
              }}
            >
              Handover Link
            </span>
            <span
              style={{
                fontSize: 13,
                color: 'var(--text-primary)',
                display: 'flex',
                alignItems: 'center',
                gap: 8,
              }}
            >
              Initializing Evo Studio Handover Status
              <span
                className="anim-terminal"
                style={{
                  width: 42,
                  height: 2,
                  borderRadius: 999,
                  background:
                    'linear-gradient(90deg, transparent, rgba(56,189,248,0.9), transparent)',
                  animation: 'ph-loading-bar 1.3s ease-in-out infinite',
                }}
              />
            </span>
          </div>
        </div>
      </div>
    );
  }

  if (!status || status.truthState === TRUTH_STATES.ERROR) {
    return (
      <div
        className="proof-panel error anim-forge anim-tactical"
        style={{
          position: 'relative',
          padding: '20px',
          borderRadius: 'var(--radius-md)',
          background:
            'linear-gradient(135deg, rgba(127,29,29,0.35), rgba(9,9,11,0.98))',
          border:
            '1px solid rgba(248,113,113,0.6), 1px solid rgba(127,29,29,0.9)',
          boxShadow:
            '0 0 0 1px rgba(127,29,29,0.8), 0 16px 40px rgba(15,23,42,0.95)',
          overflow: 'hidden',
        }}
      >
        {/* Tactical grid overlay */}
        <div
          className="anim-terminal"
          style={{
            position: 'absolute',
            inset: 0,
            backgroundImage:
              'linear-gradient(rgba(248,113,113,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(248,113,113,0.10) 1px, transparent 1px)',
            backgroundSize: '22px 22px',
            mixBlendMode: 'soft-light',
            opacity: 0.36,
            pointerEvents: 'none',
          }}
        />

        {/* Corner glows */}
        <div
          className="anim-hologram"
          style={{
            position: 'absolute',
            width: 120,
            height: 120,
            borderRadius: '100%',
            background:
              'radial-gradient(circle, rgba(248,113,113,0.7), transparent 60%)',
            top: -60,
            right: -40,
            opacity: 0.35,
            filter: 'blur(4px)',
            pointerEvents: 'none',
          }}
        />

        <div
          style={{
            position: 'relative',
            display: 'flex',
            justifyContent: 'space-between',
            alignItems: 'center',
            marginBottom: '15px',
          }}
        >
          <h3
            style={{
              margin: 0,
              display: 'flex',
              alignItems: 'center',
              gap: '8px',
              color: 'var(--accent-red)',
              textShadow: '0 0 8px rgba(248,113,113,0.8)',
            }}
          >
            <span
              style={{
                position: 'relative',
                display: 'inline-flex',
                alignItems: 'center',
                justifyContent: 'center',
              }}
            >
              <AlertCircle size={18} />
              <span
                className="anim-nexus"
                style={{
                  position: 'absolute',
                  inset: -8,
                  borderRadius: '999px',
                  border: '1px solid rgba(248,113,113,0.7)',
                  boxShadow: '0 0 12px rgba(248,113,113,0.7)',
                  opacity: 0.7,
                  animation: 'ph-alert-pulse 1.4s ease-out infinite',
                }}
              />
            </span>
            Evo Studio Handover Status
          </h3>
          <TruthBadge state={TRUTH_STATES.ERROR} />
        </div>

        <p
          style={{
            margin: 0,
            color: 'var(--text-secondary)',
            fontSize: '13px',
            lineHeight: 1.5,
          }}
        >
          Unable to fetch handover status. Ensure the backend bridge is running
          and reachable from the PromptHouse Evo Studio environment.
        </p>

        <div
          className="anim-terminal"
          style={{
            marginTop: 14,
            paddingTop: 10,
            borderTop: '1px dashed rgba(248,113,113,0.45)',
            display: 'flex',
            justifyContent: 'space-between',
            fontSize: 11,
            textTransform: 'uppercase',
            letterSpacing: '0.12em',
            color: 'rgba(248,250,252,0.65)',
          }}
        >
          <span>Bridge Status: OFFLINE</span>
          <span>Retry Loop: ACTIVE</span>
        </div>
      </div>
    );
  }

  const { data } = status;

  const allSafe =
    data.reportGenerated &&
    data.productionDeployBlocked &&
    data.liveBillingBlocked &&
    (!data.blockers || data.blockers.length === 0);

  const holoBorder =
    allSafe && status.truthState === TRUTH_STATES.TRUE
      ? 'linear-gradient(120deg, rgba(34,197,94,0.8), rgba(56,189,248,0.9), rgba(129,140,248,0.8))'
      : 'linear-gradient(120deg, rgba(56,189,248,0.7), rgba(236,72,153,0.7))';

  return (
    <div
      className={`proof-panel anim-hologram anim-nexus anim-royal ${
        pulse ? 'anim-genome' : ''
      }`}
      style={{
        position: 'relative',
        padding: '20px',
        borderRadius: '16px',
        background:
          'radial-gradient(circle at 0% 0%, rgba(56,189,248,0.12), transparent 55%), radial-gradient(circle at 90% 10%, rgba(236,72,153,0.12), transparent 55%), radial-gradient(circle at 15% 100%, rgba(129,140,248,0.14), transparent 55%), rgba(5,10,25,0.96)',
        border: '1px solid rgba(148,163,184,0.55)',
        boxShadow:
          '0 0 0 1px rgba(15,23,42,1), 0 18px 60px rgba(15,23,42,0.95), 0 0 45px rgba(56,189,248,0.28)',
        overflow: 'hidden',
        backdropFilter: 'blur(18px) saturate(1.6)',
        transition:
          'transform 220ms ease-out, box-shadow 220ms ease-out, border-color 220ms ease-out',
      }}
    >
      {/* Holographic border ring */}
      <div
        className="anim-cloud"
        style={{
          position: 'absolute',
          inset: -1,
          borderRadius: 16,
          padding: 1,
          backgroundImage: holoBorder,
          opacity: allSafe ? 0.95 : 0.45,
          mixBlendMode: 'screen',
          pointerEvents: 'none',
          mask:
            'linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0)',
          WebkitMask:
            'linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0)',
          WebkitMaskComposite: 'xor',
          maskComposite: 'exclude',
        }}
      />

      {/* Retro scanline overlay */}
      <div
        className="anim-retro"
        style={{
          position: 'absolute',
          inset: 0,
          backgroundImage:
            'linear-gradient(rgba(15,23,42,0.3) 1px, transparent 1px)',
          backgroundSize: '100% 2px',
          opacity: 0.35,
          mixBlendMode: 'soft-light',
          pointerEvents: 'none',
        }}
      />

      {/* Floating particles */}
      <div
        className="anim-genome"
        style={{
          position: 'absolute',
          inset: -40,
          backgroundImage:
            'radial-gradient(circle at 10% 20%, rgba(56,189,248,0.2) 0, transparent 56%), radial-gradient(circle at 80% 80%, rgba(34,197,94,0.18) 0, transparent 58%), radial-gradient(circle at 30% 90%, rgba(236,72,153,0.16) 0, transparent 60%)',
          opacity: 0.6,
          filter: 'blur(20px)',
          pointerEvents: 'none',
        }}
      />

      {/* 3D depth grid */}
      <div
        className="anim-tactical"
        style={{
          position: 'absolute',
          inset: 0,
          backgroundImage:
            'linear-gradient(rgba(15,23,42,0.95), rgba(15,23,42,0.95)), radial-gradient(circle at 10% 0%, rgba(56,189,248,0.12), transparent 60%)',
          mixBlendMode: 'multiply',
          opacity: 0.9,
          pointerEvents: 'none',
        }}
      />

      <div
        style={{
          position: 'relative',
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          marginBottom: '15px',
        }}
      >
        <h3
          style={{
            margin: 0,
            display: 'flex',
            alignItems: 'center',
            gap: '10px',
            color: 'var(--text-primary)',
            fontWeight: 600,
            letterSpacing: '0.06em',
            textTransform: 'uppercase',
            fontSize: 12,
          }}
        >
          <span
            className="anim-terminal"
            style={{
              position: 'relative',
              width: 26,
              height: 26,
              borderRadius: 999,
              background:
                'radial-gradient(circle at 30% 0%, rgba(129,140,248,0.8), rgba(15,23,42,0.95))',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              boxShadow:
                '0 0 14px rgba(129,140,248,0.75), 0 0 30px rgba(56,189,248,0.45)',
              overflow: 'hidden',
            }}
          >
            <FileText size={16} color="#e5e7eb" />
            <div
              className="anim-nexus"
              style={{
                position: 'absolute',
                insetInline: -24,
                height: 2,
                top: '50%',
                transform: 'translateY(-50%) rotate(-12deg)',
                background:
                  'linear-gradient(90deg, transparent, rgba(56,189,248,0.85), transparent)',
                opacity: 0.9,
                mixBlendMode: 'screen',
                animation: 'ph-holo-sweep 1.1s linear infinite',
              }}
            />
          </span>
          <span style={{ opacity: 0.85 }}>Evo Studio Handover Status</span>
        </h3>

        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            gap: 10,
          }}
        >
          {/* Live status capsule */}
          <div
            className="anim-cloud"
            style={{
              position: 'relative',
              padding: '4px 8px 4px 6px',
              borderRadius: 999,
              border: '1px solid rgba(148,163,184,0.6)',
              background:
                'linear-gradient(90deg, rgba(15,23,42,0.9), rgba(15,23,42,0.4))',
              display: 'flex',
              alignItems: 'center',
              gap: 6,
              fontSize: 10,
              textTransform: 'uppercase',
              letterSpacing: '0.16em',
              color: 'rgba(226,232,240,0.9)',
            }}
          >
            <span
              style={{
                position: 'relative',
                width: 8,
                height: 8,
                borderRadius: 999,
                background: signalColor,
                boxShadow: `0 0 10px ${signalColor}`,
              }}
            >
              <span
                className="anim-genome"
                style={{
                  position: 'absolute',
                  inset: -4,
                  borderRadius: 999,
                  border: `1px solid ${signalColor}`,
                  opacity: 0.8,
                  animation: 'ph-signal-ping 1.5s ease-out infinite',
                }}
              />
            </span>
            <span>{signalLabel}</span>
          </div>
          <TruthBadge state={status.truthState} />
        </div>
      </div>

      {/* Meta info row */}
      <div
        className="anim-clean"
        style={{
          position: 'relative',
          marginBottom: 14,
          paddingBottom: 10,
          borderBottom: '1px solid rgba(15,23,42,0.95)',
          display: 'flex',
          justifyContent: 'space-between',
          gap: 12,
          fontSize: 11,
          color: 'rgba(148,163,184,0.92)',
        }}
      >
        <div
          style={{
            display: 'flex',
            gap: 8,
            alignItems: 'center',
            flexWrap: 'wrap',
          }}
        >
          <span
            style={{
              padding: '2px 8px',
              borderRadius: 999,
              background: 'rgba(15,23,42,0.9)',
              border: '1px solid rgba(51,65,85,0.85)',
              display: 'inline-flex',
              alignItems: 'center',
              gap: 6,
            }}
          >
            <span
              style={{
                width: 3,
                height: 12,
                borderRadius: 999,
                background:
                  status.truthState === TRUTH_STATES.TRUE
                    ? 'linear-gradient(to-b, #22c55e, #16a34a)'
                    : status.truthState === TRUTH_STATES.WARNING
                    ? 'linear-gradient(to-b, #f97316, #c2410c)'
                    : 'linear-gradient(to-b, #ef4444, #b91c1c)',
              }}
            />
            <span>Channel: Handover Control Plane</span>
          </span>
          <span
            style={{
              padding: '2px 8px',
              borderRadius: 999,
              border: '1px dashed rgba(75,85,99,0.8)',
              background: 'rgba(15,23,42,0.8)',
            }}
          >
            Last Sync: {lastUpdated}
          </span>
        </div>
        <span
          style={{
            opacity: 0.8,
            fontFamily: 'var(--font-mono, ui-monospace, SFMono-Regular)',
          }}
        >
          NODE: <span style={{ color: 'rgba(248,250,252,0.9)' }}>PH-SG-01</span>
        </span>
      </div>

      {/* Main content grid */}
      <div
        style={{
          position: 'relative',
          display: 'grid',
          gridTemplateColumns: 'minmax(0, 1.1fr) minmax(0, 0.95fr)',
          gap: 12,
          alignItems: 'flex-start',
        }}
      >
        {/* Left column */}
        <div
          style={{
            display: 'flex',
            flexDirection: 'column',
            gap: 10,
          }}
        >
          {/* Report Generation Status */}
          <div
            className="anim-cloud anim-retro"
            style={{
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              padding: '10px 11px',
              background:
                'radial-gradient(circle at 0% 0%, rgba(56,189,248,0.24), transparent 60%), rgba(15,23,42,0.95)',
              borderRadius: '10px',
              border: '1px solid rgba(51,65,85,0.9)',
              boxShadow:
                '0 0 0 1px rgba(15,23,42,1), 0 10px 24px rgba(15,23,42,0.9)',
              cursor: 'default',
              transition: 'transform 160ms ease-out, box-shadow 160ms ease-out',
            }}
          >
            <span
              style={{
                fontSize: '12px',
                color: 'var(--text-secondary)',
                display: 'flex',
                alignItems: 'center',
                gap: 6,
              }}
            >
              <span
                style={{
                  width: 4,
                  height: 18,
                  borderRadius: 999,
                  background:
                    'linear-gradient(to-b, rgba(148,163,184,0.3), rgba(148,163,184,0.9))',
                  boxShadow: '0 0 8px rgba(148,163,184,0.8)',
                }}
              />
              Handover Report
            </span>
            {data.reportGenerated ? (
              <span
                style={{
                  fontSize: '12px',
                  color: 'var(--accent-green)',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '6px',
                  fontWeight: 500,
                }}
              >
                <span
                  className="anim-genome"
                  style={{
                    position: 'relative',
                    width: 18,
                    height: 18,
                    borderRadius: 999,
                    background:
                      'radial-gradient(circle at 30% 0%, rgba(34,197,94,0.9), rgba(21,128,61,0.9))',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    boxShadow:
                      '0 0 10px rgba(34,197,94,0.9), 0 0 24px rgba(21,128,61,0.7)',
                  }}
                >
                  <CheckCircle2 size={12} />
                  <span
                    style={{
                      position: 'absolute',
                      inset: -4,
                      borderRadius: 999,
                      border: '1px solid rgba(34,197,94,0.7)',
                      opacity: 0.7,
                      animation: 'ph-success-ping 1.4s ease-out infinite',
                    }}
                  />
                </span>
                Generated
              </span>
            ) : (
              <span
                style={{
                  fontSize: '12px',
                  color: 'var(--accent-orange)',
                  display: 'flex',
                  flexDirection: 'column',
                  alignItems: 'flex-end',
                  gap: 2,
                }}
              >
                <span>Missing</span>
                <span
                  style={{
                    fontSize: 10,
                    color: 'rgba(252,211,77,0.9)',
                    fontFamily:
                      'var(--font-mono, ui-monospace, SFMono-Regular)',
                  }}
                >
                  Run: npm run handover:report
                </span>
              </span>
            )}
          </div>

          {/* Security Gates Summary */}
          <div
            className="anim-tactical anim-forge"
            style={{
              display: 'flex',
              flexDirection: 'column',
              gap: '8px',
              padding: '12px',
              background:
                'radial-gradient(circle at 0% 0%, rgba(56,189,248,0.25), transparent 62%), radial-gradient(circle at 100% 100%, rgba(15,23,42,0.95), rgba(15,23,42,0.98))',
              borderRadius: '10px',
              border: '1px solid rgba(51,65,85,0.9)',
              boxShadow:
                '0 0 0 1px rgba(15,23,42,1), 0 14px 32px rgba(15,23,42,0.95)',
              position: 'relative',
              overflow: 'hidden',
            }}
          >
            <div
              style={{
                position: 'absolute',
                inset: 0,
                backgroundImage:
                  'linear-gradient(rgba(30,64,175,0.14) 1px, transparent 1px), linear-gradient(90deg, rgba(30,64,175,0.12) 1px, transparent 1px)',
                backgroundSize: '20px 20px',
                mixBlendMode: 'soft-light',
                opacity: 0.25,
              }}
            />
            <div
              style={{
                position: 'relative',
                display: 'flex',
                alignItems: 'center',
                gap: '6px',
                fontSize: '11px',
                fontWeight: 600,
                color: 'rgba(148,163,184,0.95)',
                textTransform: 'uppercase',
                letterSpacing: '0.12em',
              }}
            >
              <ShieldAlert size={14} /> Security Mandates
            </div>
            <div
              style={{
                position: 'relative',
                display: 'grid',
                gridTemplateColumns: 'minmax(0, 1.1fr) minmax(0, 1.1fr)',
                gap: 6,
                marginTop: 6,
              }}
            >
              <SecurityRow
                label="Production Deploy"
                active={data.productionDeployBlocked}
              />
              <SecurityRow
                label="Live Billing"
                active={data.liveBillingBlocked}
              />
            </div>
          </div>
        </div>

        {/* Right column */}
        <div
          style={{
            display: 'flex',
            flexDirection: 'column',
            gap: 10,
          }}
        >
          {/* Blockers */}
          {data.blockers && data.blockers.length > 0 && (
            <div
              className="anim-terminal anim-retro"
              style={{
                position: 'relative',
                padding: '12px',
                background:
                  'linear-gradient(145deg, rgba(251,146,60,0.12), rgba(24,20,11,0.96))',
                border: '1px solid rgba(251,146,60,0.7)',
                borderRadius: '10px',
                boxShadow:
                  '0 0 0 1px rgba(15,23,42,1), 0 14px 34px rgba(15,23,42,0.9), 0 0 24px rgba(251,146,60,0.3)',
                overflow: 'hidden',
              }}
            >
              <div
                className="anim-nexus"
                style={{
                  position: 'absolute',
                  inset: 0,
                  background:
                    'radial-gradient(circle at 0% 0%, rgba(251,146,60,0.3), transparent 60%)',
                  opacity: 0.6,
                  mixBlendMode: 'soft-light',
                  pointerEvents: 'none',
                }}
              />
              <div
                style={{
                  position: 'relative',
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  marginBottom: '6px',
                }}
              >
                <div
                  style={{
                    fontSize: '11px',
                    fontWeight: 600,
                    color: 'var(--accent-orange)',
                    textTransform: 'uppercase',
                    letterSpacing: '0.12em',
                    display: 'flex',
                    alignItems: 'center',
                    gap: 6,
                  }}
                >
                  <span
                    style={{
                      width: 10,
                      height: 10,
                      borderRadius: 999,
                      border: '1px solid rgba(251,146,60,0.9)',
                      boxShadow: '0 0 8px rgba(251,146,60,0.9)',
                      position: 'relative',
                    }}
                  >
                    <span
                      style={{
                        position: 'absolute',
                        inset: 2,
                        borderRadius: 999,
                        background: 'rgba(251,146,60,0.9)',
                      }}
                    />
                  </span>
                  Remaining Blockers
                </div>
                <span
                  style={{
                    fontSize: 10,
                    color: 'rgba(254,243,199,0.9)',
                    fontFamily:
                      'var(--font-mono, ui-monospace, SFMono-Regular)',
                  }}
                >
                  {data.blockers.length.toString().padStart(2, '0')} ACTIVE
                </span>
              </div>
              <ul
                style={{
                  position: 'relative',
                  margin: 0,
                  paddingLeft: '18px',
                  color: 'var(--text-secondary)',
                  fontSize: '12px',
                  display: 'flex',
                  flexDirection: 'column',
                  gap: '4px',
                }}
              >
                {data.blockers.map((b, i) => (
                  <li
                    key={i}
                    style={{
                      listStyle: 'none',
                      display: 'flex',
                      gap: 6,
                    }}
                  >
                    <span
                      style={{
                        width: 6,
                        height: 6,
                        borderRadius: 999,
                        marginTop: 5,
                        background:
                          'radial-gradient(circle, #f97316, #c2410c)',
                        boxShadow: '0 0 8px rgba(249,115,22,0.65)',
                      }}
                    />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Next Actions */}
          {data.nextSafeActions && data.nextSafeActions.length > 0 && (
            <div
              className="anim-cloud anim-clean"
              style={{
                position: 'relative',
                padding: '12px',
                background:
                  'radial-gradient(circle at 100% 0%, rgba(56,189,248,0.24), transparent 60%), rgba(6,15,30,0.98)',
                borderRadius: '10px',
                border: '1px solid rgba(59,130,246,0.8)',
                boxShadow:
                  '0 0 0 1px rgba(15,23,42,1), 0 16px 36px rgba(15,23,42,0.96), 0 0 30px rgba(59,130,246,0.45)',
                overflow: 'hidden',
              }}
            >
              <div
                className="anim-nexus"
                style={{
                  position: 'absolute',
                  inset: 0,
                  background:
                    'conic-gradient(from 220deg, rgba(56,189,248,0.35), transparent 40%, rgba(129,140,248,0.4), transparent 80%, rgba(56,189,248,0.5))',
                  opacity: 0.32,
                  mixBlendMode: 'screen',
                  pointerEvents: 'none',
                  transform: 'translate3d(0,0,0)',
                }}
              />
              <div
                style={{
                  position: 'relative',
                  fontSize: '11px',
                  fontWeight: 600,
                  color: 'rgba(191,219,254,0.95)',
                  marginBottom: '8px',
                  textTransform: 'uppercase',
                  letterSpacing: '0.12em',
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                }}
              >
                <span>Next Safe Actions</span>
                <span
                  style={{
                    fontSize: 10,
                    padding: '2px 6px',
                    borderRadius: 999,
                    border: '1px solid rgba(148,163,184,0.8)',
                    background: 'rgba(15,23,42,0.9)',
                    fontFamily:
                      'var(--font-mono, ui-monospace, SFMono-Regular)',
                    textTransform: 'uppercase',
                  }}
                >
                  Guided
                </span>
              </div>
              <ul
                style={{
                  position: 'relative',
                  margin: 0,
                  paddingLeft: '18px',
                  color: 'var(--text-dim)',
                  fontSize: '12px',
                  display: 'flex',
                  flexDirection: 'column',
                  gap: '6px',
                }}
              >
                {data.nextSafeActions.map((a, i) => (
                  <li
                    key={i}
                    style={{
                      listStyle: 'none',
                      display: 'flex',
                      gap: 8,
                    }}
                  >
                    <span
                      style={{
                        width: 10,
                        height: 10,
                        borderRadius: 3,
                        marginTop: 3,
                        background:
                          'linear-gradient(135deg, rgba(59,130,246,0.95), rgba(56,189,248,0.95))',
                        boxShadow:
                          '0 0 8px rgba(59,130,246,0.9), 0 0 16px rgba(56,189,248,0.7)',
                      }}
                    />
                    <span>{a}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

function SecurityRow({ label, active }) {
  const color = active ? 'var(--accent-green)' : 'var(--accent-red)';
  const text = active ? 'BLOCKED' : 'ALLOWED';
  const accentBg = active
    ? 'linear-gradient(135deg, rgba(34,197,94,0.95), rgba(22,163,74,0.9))'
    : 'linear-gradient(135deg, rgba(239,68,68,0.95), rgba(185,28,28,0.9))';

  return (
    <div
      className="anim-terminal"
      style={{
        display: 'flex',
        justifyContent: 'space-between',
        alignItems: 'center',
        padding: '7px 9px',
        background:
          'linear-gradient(140deg, rgba(15,23,42,0.96), rgba(15,23,42,0.7))',
        borderRadius: 8,
        border: '1px solid rgba(55,65,81,0.9)',
        fontSize: 12,
      }}
    >
      <span
        style={{
          color: 'var(--text-secondary)',
          display: 'flex',
          alignItems: 'center',
          gap: 6,
        }}
      >
        <span
          style={{
            width: 4,
            height: 14,
            borderRadius: 999,
            background:
              'linear-gradient(to-b, rgba(148,163,184,0.25), rgba(148,163,184,0.9))',
          }}
        />
        {label}
      </span>
      <span
        style={{
          color,
          fontWeight: 600,
          display: 'flex',
          alignItems: 'center',
          gap: 6,
          textTransform: 'uppercase',
          letterSpacing: '0.14em',
          fontSize: 10,
        }}
      >
        <span
          style={{
            position: 'relative',
            width: 18,
            height: 18,
            borderRadius: 999,
            background: accentBg,
            boxShadow:
              active && text === 'BLOCKED'
                ? '0 0 10px rgba(34,197,94,0.9)'
                : '0 0 10px rgba(239,68,68,0.9)',
          }}
        >
          <span
            style={{
              position: 'absolute',
              inset: 4,
              borderRadius: 999,
              background: 'rgba(15,23,42,0.95)',
            }}
          />
          <span
            style={{
              position: 'absolute',
              inset: 6,
              borderRadius: 999,
              background: accentBg,
            }}
          />
        </span>
        {text} {active ? '✅' : '❌'}
      </span>
    </div>
  );
}

