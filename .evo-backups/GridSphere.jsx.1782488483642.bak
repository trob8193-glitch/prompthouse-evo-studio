import React, { useRef, Suspense, useMemo, useEffect, useState } from "react";
import { Canvas, useFrame, useLoader } from "@react-three/fiber";
import { Float } from "@react-three/drei";
import {
  TextureLoader,
  DoubleSide,
  AdditiveBlending,
  Vector3,
  BufferGeometry,
  BufferAttribute,
  Color,
} from "three";

const TigerEye = ({ position, rotation }) => {
  return (
    <group position={position} rotation={rotation}>
      {/* Dark Outer Sclera */}
      <mesh scale={[2.0, 0.8, 0.35]} position={[0, 0, -0.01]}>
        <sphereGeometry args={[0.16, 32, 32]} />
        <meshBasicMaterial color="#020202" />
      </mesh>

      {/* Glowing Green/Gold Iris */}
      <mesh scale={[1.8, 0.7, 0.4]}>
        <sphereGeometry args={[0.15, 32, 32]} />
        <meshStandardMaterial
          color="#34d399"
          emissive="#10b981"
          emissiveIntensity={1.8}
          roughness={0.08}
          metalness={0.9}
        />
      </mesh>

      {/* Vertical Slit Pupil */}
      <mesh position={[0, 0, 0.055]} scale={[0.12, 1.1, 0.3]}>
        <sphereGeometry args={[0.1, 32, 32]} />
        <meshBasicMaterial color="#000000" />
      </mesh>

      {/* Catchlight */}
      <mesh position={[-0.04, 0.04, 0.07]}>
        <sphereGeometry args={[0.012, 16, 16]} />
        <meshBasicMaterial color="#ffffff" />
      </mesh>

      {/* Holographic Eye Ring */}
      <mesh rotation={[0, 0, 0]} scale={[1.25, 1.25, 1.25]}>
        <torusGeometry args={[0.21, 0.01, 32, 64]} />
        <meshBasicMaterial
          color="#22c55e"
          transparent
          opacity={0.6}
          blending={AdditiveBlending}
        />
      </mesh>
    </group>
  );
};

const LightningBolt = ({ color, radius }) => {
  const geoRef = useRef(null);
  const target = useRef(new Vector3());
  const points = useMemo(() => new Float32Array(15 * 3), []);

  useFrame(() => {
    if (geoRef.current && !geoRef.current.attributes.position) {
      geoRef.current.setAttribute("position", new BufferAttribute(points, 3));
    }

    if (
      ((globalThis.crypto
        ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
        : (Date.now() % 1000) / 1000) > 0.6) &&
      geoRef.current &&
      geoRef.current.attributes.position
    ) {
      target.current
        .set(
          ((globalThis.crypto
            ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
            : (Date.now() % 1000) / 1000) -
            0.5) *
            2,
          ((globalThis.crypto
            ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
            : (Date.now() % 1000) / 1000) -
            0.5) *
            2,
          ((globalThis.crypto
            ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
            : (Date.now() % 1000) / 1000) -
            0.5) *
            2
        )
        .normalize()
        .multiplyScalar(
          radius *
            (0.8 +
              (globalThis.crypto
                ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
                : (Date.now() % 1000) / 1000) *
                0.4)
        );

      let cx = 0,
        cy = 0,
        cz = 0;
      const steps = 15;
      const dx = target.current.x / steps;
      const dy = target.current.y / steps;
      const dz = target.current.z / steps;

      const pos = geoRef.current.attributes.position.array;
      for (let i = 0; i < steps; i++) {
        pos[i * 3] = cx;
        pos[i * 3 + 1] = cy;
        pos[i * 3 + 2] = cz;
        cx +=
          dx +
          ((globalThis.crypto
            ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
            : (Date.now() % 1000) / 1000) -
            0.5) *
            1.6;
        cy +=
          dy +
          ((globalThis.crypto
            ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
            : (Date.now() % 1000) / 1000) -
            0.5) *
            1.6;
        cz +=
          dz +
          ((globalThis.crypto
            ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
            : (Date.now() % 1000) / 1000) -
            0.5) *
            1.6;
      }
      pos[(steps - 1) * 3] = target.current.x;
      pos[(steps - 1) * 3 + 1] = target.current.y;
      pos[(steps - 1) * 3 + 2] = target.current.z;

      geoRef.current.attributes.position.needsUpdate = true;
    }
  });

  return (
    <line>
      <bufferGeometry ref={geoRef} />
      <lineBasicMaterial
        color={color}
        transparent
        opacity={0.9}
        blending={AdditiveBlending}
        depthWrite={false}
      />
    </line>
  );
};

const PlasmaArc = ({ radius, color }) => {
  const geoRef = useRef();
  const branchGeoRef = useRef();

  const [targets] = React.useState(() => {
    const theta =
      (globalThis.crypto
        ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
        : (Date.now() % 1000) / 1000) *
      Math.PI *
      2;
    const phi = Math.acos(
      (globalThis.crypto
        ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
        : (Date.now() % 1000) / 1000) *
        2 -
        1
    );
    const r =
      radius *
      (0.9 +
        (globalThis.crypto
          ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
          : (Date.now() % 1000) / 1000) *
          0.1);

    const mainTarget = new Vector3(
      r * Math.sin(phi) * Math.cos(theta),
      r * Math.sin(phi) * Math.sin(theta),
      r * Math.cos(phi)
    );

    const axis = new Vector3(
      globalThis.crypto
        ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
        : (Date.now() % 1000) / 1000,
      globalThis.crypto
        ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
        : (Date.now() % 1000) / 1000,
      globalThis.crypto
        ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
        : (Date.now() % 1000) / 1000
    ).normalize();
    const branchTarget = mainTarget
      .clone()
      .applyAxisAngle(axis, 0.4)
      .multiplyScalar(0.9);

    return { main: mainTarget, branch: branchTarget };
  });

  const [basePoints] = React.useState(() => {
    const pts = [];
    for (let i = 0; i <= 6; i++)
      pts.push(targets.main.clone().multiplyScalar(i / 6));
    return pts;
  });

  const [branchBasePoints] = React.useState(() => {
    const pts = [];
    const splitPoint = basePoints[3].clone();
    for (let i = 0; i <= 3; i++) {
      pts.push(splitPoint.clone().lerp(targets.branch, i / 3));
    }
    return pts;
  });

  const [positions] = React.useState(() => new Float32Array(21));
  const [branchPositions] = React.useState(() => new Float32Array(12));

  useFrame(() => {
    if (geoRef.current) {
      const pos = geoRef.current.attributes.position.array;
      const splitPos = new Vector3();

      for (let i = 0; i <= 6; i++) {
        if (i === 0) {
          pos[i * 3] = 0;
          pos[i * 3 + 1] = 0;
          pos[i * 3 + 2] = 0;
        } else if (i === 6) {
          pos[i * 3] =
            basePoints[i].x +
            ((globalThis.crypto
              ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
              : (Date.now() % 1000) / 1000) -
              0.5) *
              0.4;
          pos[i * 3 + 1] =
            basePoints[i].y +
            ((globalThis.crypto
              ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
              : (Date.now() % 1000) / 1000) -
              0.5) *
              0.4;
          pos[i * 3 + 2] =
            basePoints[i].z +
            ((globalThis.crypto
              ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
              : (Date.now() % 1000) / 1000) -
              0.5) *
              0.4;
        } else {
          const jitter =
            1.6 *
            ((globalThis.crypto
              ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
              : (Date.now() % 1000) / 1000) -
              0.5);
          pos[i * 3] = basePoints[i].x + jitter;
          pos[i * 3 + 1] = basePoints[i].y + jitter;
          pos[i * 3 + 2] = basePoints[i].z + jitter;
        }

        if (i === 3) {
          splitPos.set(pos[i * 3], pos[i * 3 + 1], pos[i * 3 + 2]);
        }
      }
      geoRef.current.attributes.position.needsUpdate = true;

      if (branchGeoRef.current) {
        const bPos = branchGeoRef.current.attributes.position.array;
        for (let i = 0; i <= 3; i++) {
          if (i === 0) {
            bPos[0] = splitPos.x;
            bPos[1] = splitPos.y;
            bPos[2] = splitPos.z;
          } else if (i === 3) {
            bPos[i * 3] =
              branchBasePoints[i].x +
              ((globalThis.crypto
                ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
                : (Date.now() % 1000) / 1000) -
                0.5) *
                0.4;
            bPos[i * 3 + 1] =
              branchBasePoints[i].y +
              ((globalThis.crypto
                ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
                : (Date.now() % 1000) / 1000) -
                0.5) *
                0.4;
            bPos[i * 3 + 2] =
              branchBasePoints[i].z +
              ((globalThis.crypto
                ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
                : (Date.now() % 1000) / 1000) -
                0.5) *
                0.4;
          } else {
            const jitter =
              1.2 *
              ((globalThis.crypto
                ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
                : (Date.now() % 1000) / 1000) -
                0.5);
            bPos[i * 3] = branchBasePoints[i].x + jitter;
            bPos[i * 3 + 1] = branchBasePoints[i].y + jitter;
            bPos[i * 3 + 2] = branchBasePoints[i].z + jitter;
          }
        }
        branchGeoRef.current.attributes.position.needsUpdate = true;
      }
    }
  });

  return (
    <group>
      <line>
        <bufferGeometry ref={geoRef}>
          <bufferAttribute
            attach="attributes-position"
            count={7}
            array={positions}
            itemSize={3}
          />
        </bufferGeometry>
        <lineBasicMaterial
          color={color}
          transparent
          opacity={0.09}
          blending={AdditiveBlending}
        />
      </line>
      <line>
        <bufferGeometry ref={branchGeoRef}>
          <bufferAttribute
            attach="attributes-position"
            count={4}
            array={branchPositions}
            itemSize={3}
          />
        </bufferGeometry>
        <lineBasicMaterial
          color={color}
          transparent
          opacity={0.08}
          blending={AdditiveBlending}
        />
      </line>
    </group>
  );
};

const ElectrifiedSphere = ({
  args,
  color,
  opacity,
  pulseSpeed = 0,
  pulseIntensity = 0,
}) => {
  const geoRef = useRef();
  const meshRef = useRef();
  const originalPos = useRef(null);

  useFrame((state) => {
    if (geoRef.current) {
      if (!originalPos.current && geoRef.current.attributes.position) {
        originalPos.current = new Float32Array(
          geoRef.current.attributes.position.array
        );
      }
      if (originalPos.current) {
        const pos = geoRef.current.attributes.position.array;
        const orig = originalPos.current;
        for (let i = 0; i < pos.length; i++) {
          pos[i] =
            orig[i] +
            ((globalThis.crypto
              ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
              : (Date.now() % 1000) / 1000) -
              0.5) *
              0.24;
        }
        geoRef.current.attributes.position.needsUpdate = true;
      }
    }

    if (pulseSpeed > 0 && meshRef.current) {
      const t = state.clock.elapsedTime * pulseSpeed;
      const throb =
        Math.pow(Math.sin(t), 8) + Math.pow(Math.sin(t + 0.3), 8) * 0.5;
      const scale = 1 + throb * pulseIntensity;
      meshRef.current.scale.set(scale, scale, scale);
      meshRef.current.rotation.y += 0.002 * (1 + throb * 3);
      meshRef.current.rotation.x += 0.0015 * (1 + throb * 2);
    }
  });

  return (
    <mesh ref={meshRef}>
      <sphereGeometry args={args} ref={geoRef} />
      <meshBasicMaterial
        color={color}
        wireframe={true}
        transparent={true}
        opacity={opacity}
        depthWrite={false}
        side={DoubleSide}
      />
    </mesh>
  );
};

const ElectrifiedPlane = ({ args, color, alphaMap, opacity = 0.8 }) => {
  const geoRef = useRef();
  const originalPos = useRef(null);

  useFrame((state) => {
    if (geoRef.current) {
      if (!originalPos.current && geoRef.current.attributes.position) {
        originalPos.current = new Float32Array(
          geoRef.current.attributes.position.array
        );
      }
      if (originalPos.current) {
        const t = state.clock.elapsedTime;
        const pos = geoRef.current.attributes.position.array;
        const orig = originalPos.current;
        for (let i = 0; i < pos.length; i += 3) {
          const wave =
            Math.sin(t * 3 + orig[i] * 4 + orig[i + 1] * 3) * 0.02 +
            (((globalThis.crypto
              ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
              : (Date.now() % 1000) / 1000) -
              0.5) *
              0.04);
          pos[i] = orig[i] + wave;
          pos[i + 1] = orig[i + 1] + wave * 0.5;
          pos[i + 2] = orig[i + 2] + wave * 0.8;
        }
        geoRef.current.attributes.position.needsUpdate = true;
      }
    }
  });

  return (
    <mesh>
      <planeGeometry args={args} ref={geoRef} />
      <meshBasicMaterial
        color={color}
        wireframe={true}
        transparent={true}
        opacity={opacity}
        alphaMap={alphaMap}
        alphaTest={0.01}
        blending={AdditiveBlending}
        depthWrite={false}
        side={DoubleSide}
      />
    </mesh>
  );
};

const HologramHalo = ({ innerColor, outerColor }) => {
  const groupRef = useRef();
  useFrame((state) => {
    const t = state.clock.elapsedTime;
    if (groupRef.current) {
      groupRef.current.rotation.z = t * 0.35;
      groupRef.current.rotation.x = Math.sin(t * 0.4) * 0.15;
      groupRef.current.rotation.y = Math.cos(t * 0.3) * 0.1;
    }
  });

  return (
    <group ref={groupRef} position={[0, -0.8, 0]}>
      <mesh>
        <torusGeometry args={[2.6, 0.02, 64, 256]} />
        <meshBasicMaterial
          color={innerColor}
          transparent
          opacity={0.5}
          blending={AdditiveBlending}
        />
      </mesh>
      <mesh scale={[1.1, 1.1, 1.1]}>
        <torusGeometry args={[2.6, 0.035, 64, 256]} />
        <meshBasicMaterial
          color={outerColor}
          transparent
          opacity={0.28}
          blending={AdditiveBlending}
        />
      </mesh>
      {/* Tactical radial spokes */}
      {Array.from({ length: 16 }).map((_, i) => {
        const angle = (i / 16) * Math.PI * 2;
        const x = Math.cos(angle) * 2.6;
        const y = Math.sin(angle) * 2.6;
        return (
          <line key={`tactical-spoke-${i}`}>
            <bufferGeometry
              attach="geometry"
              setFromPoints={[
                new Vector3(x * 0.7, y * 0.7, 0),
                new Vector3(x, y, 0),
              ]}
            />
            <lineBasicMaterial
              attach="material"
              color={innerColor}
              transparent
              opacity={0.6}
              blending={AdditiveBlending}
            />
          </line>
        );
      })}
    </group>
  );
};

const NexusParticleField = ({ colorA, colorB }) => {
  const pointsRef = useRef();
  const count = 800;
  const positions = useMemo(() => {
    const arr = new Float32Array(count * 3);
    for (let i = 0; i < count; i++) {
      const r = 4 + Math.random() * 3;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(Math.random() * 2 - 1);
      arr[i * 3] = r * Math.sin(phi) * Math.cos(theta);
      arr[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
      arr[i * 3 + 2] = r * Math.cos(phi) * 0.4;
    }
    return arr;
  }, [count]);

  useFrame((state) => {
    if (!pointsRef.current) return;
    const t = state.clock.elapsedTime;
    pointsRef.current.rotation.y = t * 0.03;
    pointsRef.current.rotation.x = Math.sin(t * 0.2) * 0.1;

    const geo = pointsRef.current.geometry;
    const arr = geo.attributes.position.array;
    for (let i = 0; i < count; i++) {
      const idx = i * 3;
      const wobble =
        Math.sin(t * 2 + arr[idx] * 0.3 + arr[idx + 1] * 0.2) * 0.01;
      arr[idx + 2] += wobble;
    }
    geo.attributes.position.needsUpdate = true;
  });

  const color = new Color(colorA);
  const color2 = new Color(colorB);
  const blended = color.clone().lerp(color2, 0.4);

  return (
    <points ref={pointsRef}>
      <bufferGeometry>
        <bufferAttribute
          attach="attributes-position"
          count={count}
          array={positions}
          itemSize={3}
        />
      </bufferGeometry>
      <pointsMaterial
        size={0.02}
        color={blended}
        transparent
        opacity={0.45}
        depthWrite={false}
        blending={AdditiveBlending}
      />
    </points>
  );
};

const StatusRing = ({ colorPrimary, colorSecondary }) => {
  const ringRef = useRef();
  const pulseRef = useRef();
  useFrame((state) => {
    const t = state.clock.elapsedTime;
    if (ringRef.current) {
      ringRef.current.rotation.z = t * 0.6;
      ringRef.current.rotation.y = Math.sin(t * 0.5) * 0.3;
    }
    if (pulseRef.current) {
      const intensity = Math.pow(Math.sin(t * 3.4), 4);
      const scale = 1 + intensity * 0.16;
      pulseRef.current.scale.set(scale, scale, scale);
      pulseRef.current.material.opacity = 0.2 + intensity * 0.45;
    }
  });

  return (
    <group position={[0, 0.4, 0]}>
      <mesh ref={ringRef}>
        <torusGeometry args={[2.1, 0.012, 32, 256]} />
        <meshBasicMaterial
          color={colorSecondary}
          transparent
          opacity={0.35}
          blending={AdditiveBlending}
        />
      </mesh>
      <mesh ref={pulseRef}>
        <ringGeometry args={[2.0, 2.2, 64]} />
        <meshBasicMaterial
          color={colorPrimary}
          transparent
          opacity={0.35}
          blending={AdditiveBlending}
          side={DoubleSide}
        />
      </mesh>
    </group>
  );
};

const TacticalScanLines = ({ color }) => {
  const groupRef = useRef();
  useFrame((state) => {
    const t = state.clock.elapsedTime;
    if (!groupRef.current) return;
    groupRef.current.position.y = -0.4 + Math.sin(t * 1.6) * 0.05;
  });

  return (
    <group ref={groupRef} position={[0, -0.4, 0]}>
      {Array.from({ length: 5 }).map((_, i) => {
        const offset = (i - 2) * 0.1;
        return (
          <mesh key={`scan-line-${i}`} position={[0, offset, 0]}>
            <planeGeometry args={[3.6, 0.01, 1, 1]} />
            <meshBasicMaterial
              color={color}
              transparent
              opacity={0.18}
              blending={AdditiveBlending}
            />
          </mesh>
        );
      })}
    </group>
  );
};

const SpinningGrid = ({ bot }) => {
  const groupRef = useRef();
  const holoMagentaRef = useRef();
  const holoBlueRef = useRef();

  const botIdStr = bot?.id || "sovereignty";
  const botColor1 = bot?.palette?.primary || bot?.color || "#06b6d4";
  const botColor2 = "#ffffff";

  const colorMap = useLoader(TextureLoader, `/bots/${botIdStr}_front.png`);
  const backColorMap = useLoader(TextureLoader, `/bots/${botIdStr}_back.png`);
  const frontMagentaLightRef = useRef();
  const frontBlueLightRef = useRef();
  const magentaLightRef = useRef();
  const blueLightRef = useRef();
  const headGlowRef = useRef();

  const [charge, setCharge] = useState(0.5);

  useEffect(() => {
    [colorMap, backColorMap].forEach((tex) => {
      tex.repeat.set(0.75, 1);
      tex.offset.set(0.125, 0);
      tex.needsUpdate = true;
    });
  }, [colorMap, backColorMap]);

  useFrame((state) => {
    const t = state.clock.elapsedTime;

    if (groupRef.current) {
      const idleY = Math.sin(t * 1.5) * 0.08 + Math.sin(t * 0.4) * 0.15;
      const idleX = Math.cos(t * 1.2) * 0.05;

      const maxPan = 75 * (Math.PI / 180);
      const maxTilt = 80 * (Math.PI / 180);

      const rawTargetY = state.pointer.x * (maxPan * 1.5) + idleY;
      const rawTargetX = -state.pointer.y * (maxTilt * 1.5) + idleX;

      const targetY = Math.max(-maxPan, Math.min(maxPan, rawTargetY));
      const targetX = Math.max(-maxTilt, Math.min(maxTilt, rawTargetX));

      groupRef.current.position.y = -0.3 + Math.sin(t * 1.5) * 0.05;
      groupRef.current.rotation.y +=
        (targetY - groupRef.current.rotation.y) * 0.12;
      groupRef.current.rotation.x +=
        (targetX - groupRef.current.rotation.x) * 0.12;
      groupRef.current.rotation.z = Math.sin(t * 0.6) * 0.03;
    }

    const flicker =
      (globalThis.crypto
        ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
        : (Date.now() % 1000) / 1000) > 0.82
        ? (globalThis.crypto
            ? crypto.getRandomValues(new Uint32Array(1))[0] / 4294967295
            : (Date.now() % 1000) / 1000) *
            0.6 +
          0.4
        : 1.0;
    if (magentaLightRef.current)
      magentaLightRef.current.intensity =
        20 * flicker * (1 + Math.sin(t * 2.1) * 0.2);
    if (blueLightRef.current)
      blueLightRef.current.intensity =
        20 * flicker * (1 + Math.cos(t * 2.4) * 0.2);
    if (frontMagentaLightRef.current)
      frontMagentaLightRef.current.intensity =
        26 + Math.sin(t * 18.0) * 16 * flicker;
    if (frontBlueLightRef.current)
      frontBlueLightRef.current.intensity =
        26 + Math.cos(t * 15.0) * 16 * flicker;

    const chargeLevel =
      0.5 +
      0.25 * Math.sin(t * 1.4) +
      0.25 * Math.sin(t * 3.1 + Math.PI / 4);
    setCharge(chargeLevel);

    if (headGlowRef.current) {
      headGlowRef.current.material.opacity = 0.25 + chargeLevel * 0.55;
      headGlowRef.current.scale.set(
        1 + chargeLevel * 0.12,
        1 + chargeLevel * 0.12,
        1 + chargeLevel * 0.12
      );
    }

    if (holoMagentaRef.current) {
      holoMagentaRef.current.rotation.y = t * 0.4;
    }
    if (holoBlueRef.current) {
      holoBlueRef.current.rotation.y = -t * 0.25;
    }
  });

  const primaryColor = new Color(botColor1);
  const secondaryColor = new Color(botColor2);

  return (
    <>
      {/* Layout Fusion Lights (Nexus + Tactical + Hologram) */}
      <pointLight
        position={[-4, 0, 3]}
        intensity={22}
        color={botColor1}
        ref={magentaLightRef}
      />
      <pointLight
        position={[4, 0, 3]}
        intensity={22}
        color={botColor2}
        ref={blueLightRef}
      />
      <pointLight
        position={[-2, 2, 5]}
        intensity={28}
        color={botColor1}
        ref={frontMagentaLightRef}
      />
      <pointLight
        position={[2, 2, 5]}
        intensity={28}
        color={botColor2}
        ref={frontBlueLightRef}
      />

      {/* Ambient tactical rim */}
      <hemisphereLight
        skyColor={primaryColor}
        groundColor={secondaryColor}
        intensity={0.25}
      />

      {/* Holographic environment layers */}
      <NexusParticleField colorA={botColor1} colorB={botColor2} />
      <HologramHalo innerColor={botColor1} outerColor={botColor2} />
      <StatusRing colorPrimary={botColor1} colorSecondary={botColor2} />
      <TacticalScanLines color={botColor1} />

      <group ref={groupRef} scale={0.45}>
        {/* Reactive aura shell (Royal + Hologram theme) */}
        <mesh ref={headGlowRef} scale={[2.9, 2.9, 2.9]}>
          <sphereGeometry args={[2.0, 32, 32]} />
          <meshBasicMaterial
            color={botColor1}
            transparent
            opacity={0.35}
            blending={AdditiveBlending}
            depthWrite={false}
          />
        </mesh>

        {/* 3D Rotating Electric Holosphere */}
        <group position={[0, 0, -0.2]}>
          {/* Rotating front/back armor */}
          <group ref={holoBlueRef}>
            <group position={[0, 0, -0.2]}>
              {/* Front faceplate layering (Forge + Genome) */}
              {Array.from({ length: 20 }).map((_, i) => {
                const radius = 2.2 - i * 0.012;
                const isOuter = i === 0;
                const intensity = isOuter ? 0.9 : 1.7;
                return (
                  <mesh key={`mask-layer-${i}`}>
                    <cylinderGeometry
                      args={[
                        radius,
                        radius,
                        4.5,
                        64,
                        64,
                        true,
                        -Math.PI * 0.6,
                        Math.PI * 1.2,
                      ]}
                    />
                    <meshPhysicalMaterial
                      map={colorMap}
                      emissiveMap={colorMap}
                      emissive="#ffffff"
                      emissiveIntensity={intensity}
                      metalness={1.0}
                      roughness={0.04}
                      transparent={true}
                      depthWrite={false}
                      alphaMap={colorMap}
                      side={DoubleSide}
                    />
                  </mesh>
                );
              })}

              {/* Tactical contour ring on front edge */}
              <mesh position={[0, 0, 2.1]}>
                <torusGeometry args={[2.2, 0.015, 32, 128]} />
                <meshBasicMaterial
                  color={botColor1}
                  transparent
                  opacity={0.4}
                  blending={AdditiveBlending}
                />
              </mesh>

              {/* Back mask stack (Retro + Cloud polished) */}
              <group rotation={[0, Math.PI, 0]}>
                {Array.from({ length: 20 }).map((_, i) => {
                  const radius = 2.2 - i * 0.012;
                  const isOuter = i === 0;
                  return (
                    <mesh key={`back-mask-layer-${i}`}>
                      <cylinderGeometry
                        args={[
                          radius,
                          radius,
                          4.5,
                          64,
                          64,
                          true,
                          -Math.PI * 0.6,
                          Math.PI * 1.2,
                        ]}
                      />
                      <meshPhysicalMaterial
                        map={backColorMap}
                        emissiveMap={backColorMap}
                        emissive="#ffffff"
                        emissiveIntensity={isOuter ? 0.9 : 1.7}
                        metalness={1.0}
                        roughness={0.04}
                        transparent={true}
                        depthWrite={false}
                        alphaMap={backColorMap}
                        side={DoubleSide}
                      />
                    </mesh>
                  );
                })}
              </group>

              {/* Back tactical edge ring */}
              <mesh position={[0, 0, -2.1]}>
                <torusGeometry args={[2.2, 0.015, 32, 128]} />
                <meshBasicMaterial
                  color={botColor2}
                  transparent
                  opacity={0.3}
                  blending={AdditiveBlending}
                />
              </mesh>

              {/* Eye blockers */}
              <mesh position={[0, 0.25, 0.4]}>
                <cylinderGeometry
                  args={[1.8, 1.8, 0.6, 32, 1, true, -0.6, 1.2]}
                />
                <meshBasicMaterial color="#000000" side={DoubleSide} />
              </mesh>

              {/* Internal living eyes (Hologram + Royal) */}
              <group position={[0, 0.16, 0.45]}>
                <TigerEye position={[-0.45, 0, 0]} rotation={[0, 0, 0.03]} />
                <TigerEye position={[0.45, 0, 0]} rotation={[0, 0, -0.03]} />
              </group>
            </group>

            {/* Inner plasma core */}
            <group position={[0, 0, -0.2]} ref={holoMagentaRef}>
              {/* Plasma arcs */}
              {Array.from({ length: 180 }).map((_, i) => (
                <PlasmaArc
                  key={`pm-${i}`}
                  radius={1.9}
                  color={primaryColor
                    .clone()
                    .lerp(secondaryColor, (i % 10) / 10)
                    .getStyle()}
                />
              ))}
              {Array.from({ length: 180 }).map((_, i) => (
                <PlasmaArc
                  key={`pc-${i}`}
                  radius={2.0}
                  color={secondaryColor
                    .clone()
                    .lerp(primaryColor, (i % 10) / 10)
                    .getStyle()}
                />
              ))}

              {/* Inner electrified spheres */}
              <ElectrifiedSphere
                args={[1.85, 32, 32]}
                color={botColor1}
                opacity={0.82}
                pulseSpeed={3.3}
                pulseIntensity={0.09}
              />
              <ElectrifiedSphere
                args={[1.95, 32, 32]}
                color={botColor2}
                opacity={1.0}
                pulseSpeed={3.6}
                pulseIntensity={0.12}
              />

              {/* Central tactical energy disc (Terminal + Tactical) */}
              <mesh rotation={[Math.PI / 2, 0, 0]} position={[0, 0, 0]}>
                <ringGeometry args={[0.4, 0.8, 64]} />
                <meshBasicMaterial
                  color={botColor2}
                  transparent
                  opacity={0.5}
                  blending={AdditiveBlending}
                  side={DoubleSide}
                />
              </mesh>
            </group>
          </group>
        </group>
      </group>
    </>
  );
};

const BiomechanicalBotHead = ({ size = "100%", bot }) => {
  const containerRef = useRef(null);

  useEffect(() => {
    if (!containerRef.current) return;
    const el = containerRef.current;
    el.classList.add(
      "anim-nexus",
      "anim-terminal",
      "anim-royal",
      "anim-forge",
      "anim-genome",
      "anim-cloud",
      "anim-hologram",
      "anim-retro",
      "anim-clean",
      "anim-tactical"
    );
    el.style.position = "relative";
    el.style.overflow = "visible";
    el.style.transition =
      "box-shadow 260ms ease-out, transform 260ms ease-out, border 260ms ease-out";
    el.style.borderRadius = "22px";
    el.style.border = "1px solid rgba(148, 163, 184, 0.4)";
    el.style.boxShadow =
      "0 0 0 1px rgba(148,163,184,0.25), 0 22px 60px rgba(15,23,42,0.9)";
    el.style.background =
      "radial-gradient(circle at 0% 0%, rgba(96,165,250,0.18), transparent 55%), radial-gradient(circle at 100% 100%, rgba(45,212,191,0.18), transparent 55%), radial-gradient(circle at 50% 120%, rgba(129,140,248,0.26), rgba(15,23,42,0.98))";

    const handleEnter = () => {
      el.style.transform = "translateY(-3px) scale(1.01)";
      el.style.boxShadow =
        "0 0 0 1px rgba(129,140,248,0.6), 0 28px 80px rgba(15,23,42,0.95)";
      el.style.border = "1px solid rgba(129,140,248,0.7)";
    };
    const handleLeave = () => {
      el.style.transform = "translateY(0) scale(1)";
      el.style.boxShadow =
        "0 0 0 1px rgba(148,163,184,0.4), 0 22px 60px rgba(15,23,42,0.9)";
      el.style.border = "1px solid rgba(148,163,184,0.4)";
    };

    el.addEventListener("mouseenter", handleEnter);
    el.addEventListener("mouseleave", handleLeave);
    return () => {
      el.removeEventListener("mouseenter", handleEnter);
      el.removeEventListener("mouseleave", handleLeave);
    };
  }, []);

  return (
    <div
      ref={containerRef}
      className="absolute inset-0 flex items-center justify-center pointer-events-auto"
      style={{
        width: size,
        height: size,
        cursor: "pointer",
        backdropFilter: "blur(18px)",
      }}
    >
      {/* Holographic UI overlay grid (Clean + Terminal) */}
      <div
        style={{
          position: "absolute",
          inset: "10%",
          borderRadius: "18px",
          border: "1px solid rgba(148,163,184,0.25)",
          boxShadow:
            "0 0 20px rgba(59,130,246,0.35), inset 0 0 18px rgba(15,23,42,0.85)",
          background:
            "linear-gradient(135deg, rgba(15,23,42,0.75), rgba(10,16,30,0.9))",
          pointerEvents: "none",
        }}
      >
        <div
          style={{
            position: "absolute",
            inset: "0",
            backgroundImage:
              "linear-gradient(rgba(148,163,184,0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,184,0.12) 1px, transparent 1px)",
            backgroundSize: "32px 32px",
            opacity: 0.6,
            mixBlendMode: "soft-light",
          }}
        />
        {/* Retro scan header */}
        <div
          style={{
            position: "absolute",
            top: "10px",
            left: "16px",
            right: "16px",
            height: "22px",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            fontSize: "10px",
            letterSpacing: "0.18em",
            textTransform: "uppercase",
            color: "rgba(226,232,240,0.8)",
            fontFamily:
              'system-ui, -apple-system, BlinkMacSystemFont, "SF Mono", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace',
          }}
        >
          <span>HOLOGRAM · NEXUS-FORGE</span>
          <span
            style={{
              padding: "0 6px",
              borderRadius: "999px",
              border: "1px solid rgba(94,234,212,0.7)",
              background:
                "radial-gradient(circle at 0 0, rgba(94,234,212,0.25), transparent 55%)",
              boxShadow:
                "0 0 12px rgba(34,211,238,0.9), 0 0 24px rgba(6,182,212,0.9)",
            }}
          >
            ONLINE
          </span>
        </div>
        {/* Tactical footer */}
        <div
          style={{
            position: "absolute",
            bottom: "10px",
            left: "16px",
            right: "16px",
            height: "16px",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            fontSize: "9px",
            textTransform: "uppercase",
            letterSpacing: "0.24em",
            color: "rgba(148,163,184,0.9)",
          }}
        >
          <span>MODE: AUTONOMOUS</span>
          <span>GRID: HYBRID · TACTICAL</span>
        </div>
      </div>

      <Canvas
        camera={{ position: [0, 0, 5.5], fov: 50 }}
        style={{
          width: "100%",
          height: "100%",
          background: "transparent",
          borderRadius: "22px",
        }}
      >
        <ambientLight intensity={0.7} />
        <Suspense fallback={null}>
          <Float speed={2.5} rotationIntensity={0.5} floatIntensity={1.2}>
            <SpinningGrid bot={bot} />
          </Float>
        </Suspense>
      </Canvas>
    </div>
  );
};

export default BiomechanicalBotHead;

