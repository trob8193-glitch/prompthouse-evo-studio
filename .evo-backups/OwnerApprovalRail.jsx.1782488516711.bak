import React, { useState, useEffect } from 'react';
import { ShieldAlert, Check, X } from 'lucide-react';
import { safeFetchBridge } from '../config/bridge-config.js';
import { useSovereignStore } from '../store.js';

export const OwnerApprovalRail = () => {
  const globalTheme = useSovereignStore((s) => s.globalTheme);
  const extensionTheme = globalTheme?.extension || 'alpha';
  const pipelineTheme = globalTheme?.pipeline || 'alpha';
  const [pendingApproval, setPendingApproval] = useState(null);
  const [processing, setProcessing] = useState(false);
  const [hoverDecision, setHoverDecision] = useState(null);
  const [intensity, setIntensity] = useState(0);

  // Soft pulsating intensity for hologram / glow
  useEffect(() => {
    let frame;
    let tStart = performance.now();
    const loop = (t) => {
      const dt = (t - tStart) / 1000;
      setIntensity((Math.sin(dt * 2) + 1) / 2); // 0..1 heartbeat
      frame = requestAnimationFrame(loop);
    };
    frame = requestAnimationFrame(loop);
    return () => cancelAnimationFrame(frame);
  }, []);

  // Poll for suspended workflows awaiting approval
  useEffect(() => {
    const checkKernel = async () => {
      try {
        const res = await safeFetchBridge('/api/intelligence/execute', {
          method: 'POST',
          body: JSON.stringify({
            module: 'Terminal',
            action: 'run',
            payload: { command: 'evo kernel status' }
          })
        });

        if (res.ok && res.data?.result?.output?.includes('Suspended Executions: 1')) {
          if (!pendingApproval) {
            setPendingApproval({
              id: 'exec_vercel_deploy_01',
              action: 'Vercel Orchestrator Deployment',
              risk: 'HIGH',
              costEstimate: '$0.00',
              description:
                'The agent is requesting permission to push the "SaaS Scaffold" directly to a live Vercel production URL using your vaulted token.'
            });
          }
        } else {
          setPendingApproval(null);
        }
      } catch (e) {
        // Ignore polling errors
      }
    };

    const interval = setInterval(checkKernel, 5000);
    return () => clearInterval(interval);
  }, [pendingApproval]);

  const handleDecision = async (approved) => {
    if (!pendingApproval) return;
    setProcessing(true);
    try {
      if (approved) {
        await safeFetchBridge('/api/deploy/vercel', {
          method: 'POST',
          body: JSON.stringify({ executionId: pendingApproval.id })
        });
      }
      setPendingApproval(null);
    } catch (e) {
      console.error('Approval resolution failed', e);
    } finally {
      setProcessing(false);
      setHoverDecision(null);
    }
  };

  if (!pendingApproval) return null;

  const isOmega = pipelineTheme === 'omega';
  const isSigma = pipelineTheme === 'sigma';
  const isGamma = extensionTheme === 'gamma';
  const isZeta = extensionTheme === 'zeta';

  // Dynamic gradients fused from Nexus / Royal / Hologram / Tactical
  const shellGradient = isOmega
    ? `conic-gradient(from 210deg at 50% 50%, rgba(255,0,72,0.35), rgba(255,170,0,0.15), rgba(255,0,72,0.45))`
    : isSigma
    ? `radial-gradient(circle at 10% 0, rgba(196,181,253,0.25), transparent 55%), 
       radial-gradient(circle at 90% 100%, rgba(56,189,248,0.22), transparent 55%), 
       linear-gradient(135deg, rgba(30,64,175,0.95), rgba(8,47,73,0.98))`
    : isGamma
    ? `radial-gradient(circle at 0 0, rgba(251,113,133,0.45), transparent 60%), 
       radial-gradient(circle at 100% 100%, rgba(129,140,248,0.45), transparent 55%), 
       linear-gradient(135deg, #020617, #020617)`
    : isZeta
    ? `linear-gradient(135deg, #020617, #0b1120)`
    : `radial-gradient(circle at 50% 0, rgba(56,189,248,0.32), transparent 60%), 
       linear-gradient(135deg, #020617, #020617)`;

  const borderColorPrimary = isOmega
    ? `rgba(248,113,113,${0.7 + intensity * 0.3})`
    : isSigma
    ? `rgba(196,181,253,${0.7 + intensity * 0.3})`
    : isGamma
    ? `rgba(248,113,113,${0.7 + intensity * 0.3})`
    : isZeta
    ? `rgba(15,23,42,${0.9})`
    : `rgba(248,113,113,${0.7 + intensity * 0.3})`;

  const auraGlow = `0 0 35px rgba(248,113,113,${0.25 + intensity * 0.35}), 
                    0 0 80px rgba(59,130,246,${0.35 * intensity})`;

  const railScale = 1 + intensity * 0.02;

  return (
    <div
      className={`fixed inset-0 z-[99998] anim-hologram anim-nexus`}
      style={{
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        background:
          'radial-gradient(circle at top, rgba(15,23,42,0.92), rgba(15,23,42,0.97) 40%, rgba(15,23,42,1) 80%)',
        backdropFilter: 'blur(14px) saturate(1.4)',
        WebkitBackdropFilter: 'blur(14px) saturate(1.4)'
      }}
    >
      {/* Tactical grid / hologram matrix */}
      <div
        className="pointer-events-none absolute inset-0 mix-blend-screen anim-tactical"
        aria-hidden="true"
        style={{
          opacity: 0.25 + intensity * 0.15,
          backgroundImage:
            'linear-gradient(rgba(148,163,184,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,184,0.08) 1px, transparent 1px)',
          backgroundSize: '28px 28px',
          maskImage:
            'radial-gradient(circle at center, rgba(0,0,0,1) 0, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0) 75%)'
        }}
      />

      {/* Floating particles */}
      <div
        className="pointer-events-none absolute inset-0 anim-cloud"
        aria-hidden="true"
        style={{
          backgroundImage:
            'radial-gradient(circle at 20% 20%, rgba(56,189,248,0.22) 0, transparent 40%), radial-gradient(circle at 80% 70%, rgba(244,114,182,0.18) 0, transparent 45%)',
          opacity: 0.35 * intensity
        }}
      />

      <div
        className={`relative anim-royal anim-genome`}
        style={{
          width: 560,
          maxWidth: '92vw',
          transform: `scale(${railScale}) translateY(${(1 - intensity) * -4}px)`,
          transition: 'transform 220ms cubic-bezier(0.3, 0.7, 0.4, 1)'
        }}
      >
        {/* Outer hologram shell */}
        <div
          className="relative overflow-hidden"
          style={{
            borderRadius: isOmega || isZeta ? 0 : 18,
            padding: 1,
            backgroundImage: shellGradient,
            boxShadow: auraGlow,
            position: 'relative'
          }}
        >
          {/* Holographic scan lines */}
          <div
            aria-hidden="true"
            className="pointer-events-none absolute inset-0 anim-terminal"
            style={{
              backgroundImage:
                'linear-gradient(to bottom, rgba(15,23,42,0.06) 1px, transparent 1px)',
              backgroundSize: '100% 3px',
              mixBlendMode: 'screen',
              opacity: 0.45
            }}
          />

          {/* Inner core panel */}
          <div
            className="relative overflow-hidden anim-clean"
            style={{
              background:
                'radial-gradient(circle at 0 0, rgba(248,250,252,0.03), transparent 55%), #020617',
              borderRadius: isOmega || isZeta ? 0 : 16,
              border: `1px solid ${borderColorPrimary}`,
              boxShadow:
                '0 18px 55px rgba(15,23,42,0.95), inset 0 0 0 1px rgba(15,23,42,0.85)'
            }}
          >
            {/* Neon perimeter */}
            <div
              aria-hidden="true"
              className="pointer-events-none absolute inset-[1px] anim-nexus"
              style={{
                borderRadius: isOmega || isZeta ? 0 : 14,
                border: `1px dashed rgba(148,163,184,0.35)`,
                boxShadow:
                  'inset 0 0 32px rgba(30,64,175,0.5), inset 0 0 48px rgba(248,113,113,0.25)',
                opacity: 0.6 + intensity * 0.25
              }}
            />

            {/* Top status rail */}
            <div
              className="relative flex items-center justify-between px-5 py-3 anim-terminal"
              style={{
                borderBottom: '1px solid rgba(51,65,85,0.9)',
                backdropFilter: 'blur(10px)',
                WebkitBackdropFilter: 'blur(10px)',
                background:
                  'linear-gradient(to right, rgba(15,23,42,0.96), rgba(15,23,42,0.92))'
              }}
            >
              <div className="flex items-center gap-3">
                <div
                  className="relative flex items-center justify-center"
                  style={{
                    width: 42,
                    height: 42,
                    borderRadius: 999,
                    background:
                      'radial-gradient(circle at 30% 0, rgba(248,113,113,0.85), rgba(127,29,29,0.95))',
                    boxShadow:
                      '0 0 18px rgba(248,113,113,0.7), 0 0 38px rgba(248,113,113,0.5)',
                    transform: `scale(${1 + intensity * 0.04})`,
                    transition: 'transform 220ms ease-out'
                  }}
                >
                  <div
                    className="absolute inset-[3px] rounded-full"
                    style={{
                      border: '1px solid rgba(254,249,195,0.55)',
                      boxShadow:
                        'inset 0 0 12px rgba(239,68,68,0.9), 0 0 12px rgba(254,240,138,0.9)'
                    }}
                  />
                  <ShieldAlert size={22} className="relative text-yellow-100" />
                  <div
                    className="absolute -inset-[2px] rounded-full anim-genome"
                    style={{
                      border: '1px solid rgba(248,250,252,0.35)',
                      opacity: 0.4 + intensity * 0.4
                    }}
                  />
                </div>
                <div className="flex flex-col">
                  <span
                    style={{
                      fontSize: 11,
                      letterSpacing: '0.22em',
                      textTransform: 'uppercase',
                      color: 'rgba(148,163,184,0.85)'
                    }}
                  >
                    OWNER OVERRIDE CHANNEL
                  </span>
                  <span
                    style={{
                      fontSize: 19,
                      letterSpacing: '0.08em',
                      textTransform: 'uppercase',
                      color: '#fefce8'
                    }}
                  >
                    Approval Required
                  </span>
                </div>
              </div>

              {/* Status cluster */}
              <div className="flex flex-col items-end gap-1 anim-tactical">
                <div className="flex items-center gap-2">
                  <span
                    style={{
                      fontSize: 10,
                      textTransform: 'uppercase',
                      letterSpacing: '0.18em',
                      color: 'rgba(148,163,184,0.9)'
                    }}
                  >
                    KERNEL STATE
                  </span>
                  <div
                    className="relative flex items-center gap-1 px-2.5 py-[3px] rounded-full"
                    style={{
                      background:
                        'linear-gradient(to right, rgba(248,113,113,0.08), rgba(248,113,113,0.22))',
                      boxShadow:
                        '0 0 10px rgba(248,113,113,0.4), inset 0 0 0 1px rgba(127,29,29,0.9)'
                    }}
                  >
                    <span
                      className="inline-flex h-[9px] w-[9px] rounded-full"
                      style={{
                        background:
                          intensity > 0.5
                            ? 'radial-gradient(circle, #fef9c3 0, #f97316 55%, #b91c1c 100%)'
                            : 'radial-gradient(circle, #fee2e2 0, #f97316 55%, #7f1d1d 100%)',
                        boxShadow:
                          '0 0 10px rgba(253,224,71,0.9), 0 0 20px rgba(248,113,113,0.9)',
                        transform: `scale(${0.9 + intensity * 0.25})`,
                        transition: 'transform 200ms ease-out'
                      }}
                    />
                    <span
                      style={{
                        fontSize: 11,
                        letterSpacing: '0.16em',
                        textTransform: 'uppercase',
                        color: '#fee2e2'
                      }}
                    >
                      Suspended
                    </span>
                  </div>
                </div>
                <div className="flex items-center gap-2">
                  <span
                    style={{
                      fontSize: 9,
                      letterSpacing: '0.22em',
                      textTransform: 'uppercase',
                      color: 'rgba(148,163,184,0.85)'
                    }}
                  >
                    CHANNEL
                  </span>
                  <span
                    style={{
                      fontSize: 11,
                      letterSpacing: '0.2em',
                      textTransform: 'uppercase',
                      color: 'rgba(59,130,246,0.9)'
                    }}
                  >
                    Vercel / Forge
                  </span>
                </div>
              </div>
            </div>

            {/* Warning banner */}
            <div
              className="relative px-5 py-2.5 anim-retro"
              style={{
                background:
                  'linear-gradient(90deg, rgba(127,29,29,0.65), rgba(124,45,18,0.9))',
                borderBottom: '1px solid rgba(254,202,202,0.4)',
                boxShadow:
                  '0 12px 32px rgba(15,23,42,1), inset 0 1px 0 rgba(254,249,195,0.3)'
              }}
            >
              <div className="flex items-center justify-between gap-3">
                <div className="flex items-center gap-2.5">
                  <div
                    className="flex h-[18px] w-[18px] items-center justify-center rounded-sm bg-black/40"
                    style={{
                      boxShadow: '0 0 0 1px rgba(248,250,252,0.4)',
                      fontSize: 10,
                      letterSpacing: '0.1em',
                      textTransform: 'uppercase',
                      color: '#fef9c3'
                    }}
                  >
                    !
                  </div>
                  <span
                    style={{
                      fontSize: 11,
                      letterSpacing: '0.18em',
                      textTransform: 'uppercase',
                      color: '#fef9c3'
                    }}
                  >
                    HIGH-RISK EXECUTION REQUESTED
                  </span>
                </div>
                <span
                  style={{
                    fontSize: 11,
                    letterSpacing: '0.16em',
                    textTransform: 'uppercase',
                    color: 'rgba(254,242,242,0.8)'
                  }}
                >
                  Manual Approval Only
                </span>
              </div>
            </div>

            {/* Core content */}
            <div className="relative px-5 pt-4 pb-4">
              {/* Holographic overlay */}
              <div
                aria-hidden="true"
                className="pointer-events-none absolute inset-0 anim-hologram"
                style={{
                  backgroundImage:
                    'radial-gradient(circle at top, rgba(59,130,246,0.12), transparent 55%)',
                  mixBlendMode: 'screen',
                  opacity: 0.75
                }}
              />

              {/* Card contents */}
              <div className="relative">
                {/* Top metrics row */}
                <div
                  className="mb-4 grid grid-cols-3 gap-3 text-xs anim-tactical"
                  style={{
                    fontFamily:
                      '"JetBrains Mono", "SF Mono", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace'
                  }}
                >
                  {/* ACTION */}
                  <div
                    className="rounded-md border border-slate-800/90 bg-slate-950/60 px-3 py-2 shadow-[0_0_0_1px_rgba(15,23,42,1)] anim-clean"
                    style={{
                      boxShadow:
                        '0 0 0 1px rgba(15,23,42,1), 0 18px 30px rgba(0,0,0,0.9)'
                    }}
                  >
                    <div className="flex items-center justify-between mb-1">
                      <span
                        style={{
                          fontSize: 10,
                          letterSpacing: '0.18em',
                          textTransform: 'uppercase',
                          color: 'rgba(148,163,184,0.9)'
                        }}
                      >
                        Action
                      </span>
                      <span
                        style={{
                          fontSize: 9,
                          letterSpacing: '0.2em',
                          textTransform: 'uppercase',
                          color: 'rgba(59,130,246,0.9)'
                        }}
                      >
                        Channel · Nexus
                      </span>
                    </div>
                    <div
                      className="line-clamp-2"
                      style={{
                        fontSize: 11,
                        fontWeight: 600,
                        color: '#e5e7eb'
                      }}
                    >
                      {pendingApproval.action}
                    </div>
                  </div>

                  {/* RISK */}
                  <div
                    className="rounded-md border border-red-900/80 bg-gradient-to-br from-slate-950/80 via-slate-950/95 to-red-950/70 px-3 py-2 shadow-[0_0_0_1px_rgba(15,23,42,1)] anim-terminal"
                    style={{
                      boxShadow:
                        '0 0 0 1px rgba(15,23,42,1), 0 18px 30px rgba(0,0,0,0.9)'
                    }}
                  >
                    <div className="flex items-center justify-between mb-1">
                      <span
                        style={{
                          fontSize: 10,
                          letterSpacing: '0.18em',
                          textTransform: 'uppercase',
                          color: 'rgba(248,113,113,0.9)'
                        }}
                      >
                        Risk Level
                      </span>
                      <span
                        style={{
                          fontSize: 9,
                          letterSpacing: '0.18em',
                          textTransform: 'uppercase',
                          color: 'rgba(248,250,252,0.75)'
                        }}
                      >
                        Tactical
                      </span>
                    </div>
                    <div className="flex items-center justify-between">
                      <span
                        style={{
                          fontSize: 13,
                          fontWeight: 700,
                          textTransform: 'uppercase',
                          letterSpacing: '0.18em',
                          color: '#fee2e2'
                        }}
                      >
                        {pendingApproval.risk}
                      </span>
                      <div className="flex items-center gap-0.5">
                        {Array.from({ length: 3 }).map((_, i) => (
                          <span
                            key={i}
                            className="inline-flex h-[10px] w-[14px] rounded-sm"
                            style={{
                              background:
                                i === 2
                                  ? 'linear-gradient(to top, #f97316, #facc15)'
                                  : 'linear-gradient(to top, #7f1d1d, #f87171)',
                              opacity: 0.6 + i * 0.15,
                              boxShadow:
                                i === 2
                                  ? '0 0 14px rgba(253,224,71,0.9)'
                                  : '0 0 10px rgba(248,113,113,0.85)'
                            }}
                          />
                        ))}
                      </div>
                    </div>
                  </div>

                  {/* COST */}
                  <div
                    className="rounded-md border border-emerald-800/90 bg-gradient-to-br from-slate-950/80 via-slate-950/95 to-emerald-950/80 px-3 py-2 shadow-[0_0_0_1px_rgba(15,23,42,1)] anim-cloud"
                    style={{
                      boxShadow:
                        '0 0 0 1px rgba(15,23,42,1), 0 18px 30px rgba(0,0,0,0.9)'
                    }}
                  >
                    <div className="flex items-center justify-between mb-1">
                      <span
                        style={{
                          fontSize: 10,
                          letterSpacing: '0.18em',
                          textTransform: 'uppercase',
                          color: 'rgba(52,211,153,0.9)'
                        }}
                      >
                        Est. Cost
                      </span>
                      <span
                        style={{
                          fontSize: 9,
                          letterSpacing: '0.18em',
                          textTransform: 'uppercase',
                          color: 'rgba(148,163,184,0.85)'
                        }}
                      >
                        Runtime
                      </span>
                    </div>
                    <div className="flex items-center justify-between">
                      <span
                        style={{
                          fontSize: 13,
                          fontWeight: 700,
                          letterSpacing: '0.12em',
                          color: '#bbf7d0'
                        }}
                      >
                        {pendingApproval.costEstimate}
                      </span>
                      <div className="relative flex items-center gap-1">
                        <div
                          className="h-[6px] w-[42px] rounded-full overflow-hidden bg-slate-900/80"
                          style={{
                            boxShadow: 'inset 0 0 0 1px rgba(15,23,42,1)'
                          }}
                        >
                          <div
                            className="h-full rounded-full anim-genome"
                            style={{
                              width: `${40 + intensity * 40}%`,
                              background:
                                'linear-gradient(to right, #22c55e, #bef264)',
                              boxShadow:
                                '0 0 10px rgba(22,163,74,0.9), 0 0 18px rgba(190,242,100,0.8)'
                            }}
                          />
                        </div>
                        <span
                          style={{
                            fontSize: 9,
                            letterSpacing: '0.16em',
                            textTransform: 'uppercase',
                            color: 'rgba(163,230,53,0.9)'
                          }}
                        >
                          Safe
                        </span>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Description panel */}
                <div
                  className="mb-4 rounded-lg border border-slate-800/90 bg-slate-950/80 px-4 py-3 anim-clean"
                  style={{
                    boxShadow:
                      '0 0 0 1px rgba(15,23,42,1), inset 0 0 40px rgba(15,23,42,0.9)'
                  }}
                >
                  <div className="flex items-center justify-between mb-2">
                    <div className="flex items-center gap-2">
                      <span
                        style={{
                          fontSize: 11,
                          letterSpacing: '0.18em',
                          textTransform: 'uppercase',
                          color: 'rgba(148,163,184,0.9)'
                        }}
                      >
                        Execution Details
                      </span>
                      <span
                        style={{
                          fontSize: 10,
                          letterSpacing: '0.18em',
                          textTransform: 'uppercase',
                          color: 'rgba(56,189,248,0.95)'
                        }}
                      >
                        Secure · Vaulted Token
                      </span>
                    </div>
                    <span
                      style={{
                        fontSize: 10,
                        letterSpacing: '0.22em',
                        textTransform: 'uppercase',
                        color: 'rgba(148,163,184,0.85)'
                      }}
                    >
                      ID · {pendingApproval.id}
                    </span>
                  </div>
                  <div
                    style={{
                      fontSize: 13,
                      lineHeight: 1.6,
                      color: '#e2e8f0'
                    }}
                  >
                    {pendingApproval.description}
                  </div>
                </div>

                {/* Decision context bar */}
                <div
                  className="mb-3 flex items-center justify-between gap-3 anim-royal"
                  style={{
                    fontSize: 11,
                    letterSpacing: '0.16em',
                    textTransform: 'uppercase',
                    color: 'rgba(148,163,184,0.95)'
                  }}
                >
                  <div className="flex items-center gap-2">
                    <span
                      className="inline-flex h-[9px] w-[9px] rounded-full"
                      style={{
                        background:
                          hoverDecision === 'approve'
                            ? 'radial-gradient(circle, #bbf7d0 0, #22c55e 50%, #15803d 100%)'
                            : hoverDecision === 'reject'
                            ? 'radial-gradient(circle, #fecaca 0, #f97316 50%, #b91c1c 100%)'
                            : 'radial-gradient(circle, #e5e7eb 0, #9ca3af 50%, #4b5563 100%)',
                        boxShadow:
                          hoverDecision === 'approve'
                            ? '0 0 14px rgba(22,163,74,0.9)'
                            : hoverDecision === 'reject'
                            ? '0 0 14px rgba(248,113,113,0.95)'
                            : '0 0 10px rgba(148,163,184,0.7)'
                      }}
                    />
                    <span>Owner must select an explicit outcome.</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span
                      style={{
                        color:
                          hoverDecision === 'approve'
                            ? 'rgba(34,197,94,0.9)'
                            : hoverDecision === 'reject'
                            ? 'rgba(248,113,113,0.9)'
                            : 'rgba(148,163,184,0.9)'
                      }}
                    >
                      {hoverDecision === 'approve'
                        ? 'Authorize immediate deploy.'
                        : hoverDecision === 'reject'
                        ? 'Suspend and hold execution.'
                        : 'Hover a decision to preview impact.'}
                    </span>
                  </div>
                </div>

                {/* Action buttons row */}
                <div className="relative flex gap-3 anim-nexus">
                  {/* Reject */}
                  <button
                    type="button"
                    onClick={() => handleDecision(false)}
                    disabled={processing}
                    onMouseEnter={() => setHoverDecision('reject')}
                    onMouseLeave={() => setHoverDecision(null)}
                    className="group relative flex-1 overflow-hidden rounded-md border border-red-700/80 bg-gradient-to-br from-slate-950 via-slate-950 to-red-950 px-0 py-0"
                    style={{
                      cursor: processing ? 'wait' : 'pointer',
                      boxShadow:
                        hoverDecision === 'reject'
                          ? '0 0 30px rgba(248,113,113,0.65)'
                          : '0 0 18px rgba(0,0,0,0.9)',
                      transform:
                        hoverDecision === 'reject' && !processing
                          ? 'translateY(-1px)'
                          : 'translateY(0)',
                      transition:
                        'box-shadow 180ms ease-out, transform 180ms ease-out'
                    }}
                  >
                    <div
                      className="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 anim-hologram"
                      aria-hidden="true"
                      style={{
                        backgroundImage:
                          'linear-gradient(120deg, transparent 0%, rgba(254,242,242,0.4) 40%, transparent 80%)',
                        mixBlendMode: 'screen',
                        transition: 'opacity 180ms ease-out'
                      }}
                    />
                    <div className="relative flex h-11 items-center justify-center gap-2 px-4">
                      <span
                        className="flex h-5 w-5 items-center justify-center rounded-full border border-red-400/80 bg-red-900/60 text-red-100"
                        style={{ boxShadow: '0 0 12px rgba(248,113,113,0.85)' }}
                      >
                        <X size={14} />
                      </span>
                      <span
                        style={{
                          fontSize: 12,
                          fontWeight: 500,
                          letterSpacing: '0.16em',
                          textTransform: 'uppercase',
                          color: '#fee2e2'
                        }}
                      >
                        Reject &amp; Suspend
                      </span>
                    </div>
                  </button>

                  {/* Approve */}
                  <button
                    type="button"
                    onClick={() => handleDecision(true)}
                    disabled={processing}
                    onMouseEnter={() => setHoverDecision('approve')}
                    onMouseLeave={() => setHoverDecision(null)}
                    className="group relative flex-1 overflow-hidden rounded-md border border-emerald-500/80 bg-gradient-to-r from-emerald-600 via-emerald-500 to-lime-400 px-0 py-0 anim-royal"
                    style={{
                      cursor: processing ? 'wait' : 'pointer',
                      boxShadow:
                        hoverDecision === 'approve'
                          ? '0 0 34px rgba(22,163,74,0.8)'
                          : '0 0 20px rgba(22,101,52,0.9)',
                      transform:
                        hoverDecision === 'approve' && !processing
                          ? 'translateY(-1px)'
                          : 'translateY(0)',
                      transition:
                        'box-shadow 180ms ease-out, transform 180ms ease-out'
                    }}
                  >
                    <div
                      className="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 anim-hologram"
                      aria-hidden="true"
                      style={{
                        backgroundImage:
                          'linear-gradient(120deg, transparent 0%, rgba(254,252,232,0.8) 40%, transparent 85%)',
                        mixBlendMode: 'screen',
                        transition: 'opacity 180ms ease-out'
                      }}
                    />
                    <div className="relative flex h-11 items-center justify-center gap-2 px-4">
                      <span
                        className="flex h-5 w-5 items-center justify-center rounded-full border border-emerald-100/90 bg-emerald-900/40 text-emerald-50"
                        style={{
                          boxShadow:
                            '0 0 12px rgba(22,163,74,0.9), 0 0 18px rgba(190,242,100,0.9)'
                        }}
                      >
                        {processing ? (
                          <span
                            className="inline-block h-3 w-3 rounded-full border-2 border-emerald-200 border-t-transparent animate-spin"
                            style={{ borderRadius: '999px' }}
                          />
                        ) : (
                          <Check size={14} />
                        )}
                      </span>
                      <span
                        style={{
                          fontSize: 12,
                          fontWeight: 600,
                          letterSpacing: '0.16em',
                          textTransform: 'uppercase',
                          color: '#ecfdf5'
                        }}
                      >
                        {processing ? 'Authorizing…' : 'Authorize Action'}
                      </span>
                    </div>
                  </button>
                </div>

                {/* Bottom meta strip */}
                <div
                  className="mt-1 flex items-center justify-between text-[10px] anim-retro"
                  style={{
                    letterSpacing: '0.16em',
                    textTransform: 'uppercase',
                    color: 'rgba(100,116,139,0.95)'
                  }}
                >
                  <div className="flex items-center gap-2">
                    <span>PromptHouse · Singularity Engine</span>
                    <span
                      style={{
                        width: 1,
                        height: 10,
                        background: 'rgba(51,65,85,0.9)'
                      }}
                    />
                    <span
                      style={{
                        color: 'rgba(148,163,184,0.95)'
                      }}
                    >
                      Kernel Endpoint · /api/deploy/vercel
                    </span>
                  </div>
                  <span
                    style={{
                      color: 'rgba(56,189,248,0.95)'
                    }}
                  >
                    UI Genome · Nexus · Terminal · Royal · Forge · Genome · Cloud ·
                    Hologram · Retro · Clean · Tactical
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div> 
    </div>
  );
};

