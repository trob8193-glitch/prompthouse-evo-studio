  layoutDynamicOverlap: {
    label: "🎨 CHAOS CREATIVE AGENT [ACTIVE]",
    subtitle: "Symmetry is boring. Overlapping dimensions injected.",
    description: "Multi-plane composition engine oscillating.",
    layoutClass: "genome hologram anim-genome anim-hologram",
    accent: "var(--accent-genome, #ff5cf7)",
