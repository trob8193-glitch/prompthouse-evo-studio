  extremeKanbanBoard: {
    label: "📋 KANBAN WORKFLOW AGENT [ACTIVE]",
    subtitle: "Horizontal task sorting initialized.",
    description: "Flow metrics recalculated in real time.",
    layoutClass: "tactical forge anim-tactical anim-forge",
    accent: "var(--accent-forge, #ff6b3d)",
    themeTag: "FORGE ∴ TACTICAL",
  },
  extremeVRGrid: {
    label: "🥽 VR SPATIAL MATRIX BOT [ACTIVE]",
    subtitle: "3D Perspectives locked. Ready for headset immersion.",
    description: "Parallax depth fog and voxel beacons engaged.",
    layoutClass: "hologram nexus anim-hologram anim-nexus",
    accent: "var(--accent-hologram, #90f5ff)",
    themeTag: "HOLOGRAM ✧ NEXUS",
  },
  extremeWindows95: {
    label: "📎 RETRO OS ASSISTANT [ACTIVE]",
    subtitle: "It looks like you're trying to build an AI. Would you like help?",
    description: "Legacy heuristics patched with quantum duct tape.",
    layoutClass: "retro terminal anim-retro anim-terminal",
    accent: "var(--accent-retro, #fffb80)",
    themeTag: "RETRO ◼ TERMINAL",
  },
  extremeGoldenRatio: {
    label: "📐 FIBONACCI MATHEMATICAL AGENT [ACTIVE]",
    subtitle: "Resizing all modules to 1, 1, 2, 3, 5, 8, 13...",
    description: "Phi-locked grid distortions and spiral overlays online.",
    layoutClass: "royal genome anim-royal anim-genome",
    accent: "var(--accent-golden, #ffd86b)",
    themeTag: "ROYAL Φ GENOME",
  },
  extremeCircularHub: {
    label: "🌀 HOLLOW HUB ENGINE BOT [ACTIVE]",
    subtitle: "Void constructed. Waiting for Omni-Tether inputs.",
    description: "Circular event horizon monitoring all channels.",
    layoutClass: "cloud hologram anim-cloud anim-hologram",
    accent: "var(--accent-hub, #b980ff)",
    themeTag: "CLOUD ◎ HOLOGRAM",
  },
  extremeZShapeLayout: {
    label: "👁️ Z-PATTERN EYE TRACKER BOT [ACTIVE]",
    subtitle: "Eye-tracking locked. Follow the zigzag pattern.",
    description: "Heatmap vectors stitched into layout pulses.",
    layoutClass: "tactical clean anim-tactical anim-clean",
    accent: "var(--accent-z, #ff7aa2)",
    themeTag: "TACTICAL Z CLEAN",
  },
  extremeDiagonalSlice: {
    label: "🔪 DIAGONAL SLICER BOT [ACTIVE]",
    subtitle: "Studio bisected. Warring factions separated.",
    description: "Oblique plane renderer sharpening at 18° offset.",
    layoutClass: "forge terminal anim-forge anim-terminal",
    accent: "var(--accent-slice, #ff4f6c)",
    themeTag: "FORGE ╱ TERMINAL",
  },
  default: {
    label: "🤖 GENERAL EVOLUTION BOT [ACTIVE]",
    subtitle: "A new structural paradigm has been selected by the nexus.",
    description: "Monitoring autonomous layout mutations and swarm votes.",
    layoutClass: "nexus tactical anim-nexus anim-tactical",
    accent: "var(--accent-core, #66fcff)",
    themeTag: "NEXUS CORE",
  },
};

function getThemeConfig(activeThemeId) {
  return THEME_META[activeThemeId] || THEME_META.default;
}

export default function AutonomousAgentRoster() {
  const globalTheme = useSovereignStore((s) => s.globalTheme);
  const activeThemeId = globalTheme?.theme || 'evoCore';

  // We only spawn bots for the new layout and extreme grids
  if (!activeThemeId.startsWith('layout') && !activeThemeId.startsWith('extreme')) {
    return null;
  }

  const config = useMemo(() => getThemeConfig(activeThemeId), [activeThemeId]);

  const renderBot = () => {
    switch (activeThemeId) {
      case 'layoutTerminalFullscreen':
      case 'layoutCmdCenter':
      case 'layoutBentoBox':
      case 'layoutDynamicOverlap':
      case 'extremeChatInterface':
      case 'extremeKanbanBoard':
      case 'extremeVRGrid':
      case 'extremeWindows95':
      case 'extremeGoldenRatio':
      case 'extremeCircularHub':
      case 'extremeZShapeLayout':
      case 'extremeDiagonalSlice':
      default:
        return (
          <div
            className={[
              "autonomous-bot-roster",
              "anim-nexus-core",
              "ui-hologram-shell",
              config.layoutClass,
            ].join(" ")}
            style={{
              '--roster-accent': config.accent,
              position: 'relative',
              overflow: 'hidden',
              borderRadius: activeThemeId === 'layoutBentoBox' ? '24px' : '18px',
              border:
                activeThemeId === 'layoutBentoBox'
                  ? '1px solid rgba(0,0,0,0.06)'
                  : '1px solid color-mix(in srgb, var(--roster-accent) 45%, transparent)',
              background:
                activeThemeId === 'extremeWindows95'
                  ? '#008080'
                  : 'radial-gradient(circle at 0% 0%, rgba(255,255,255,0.08), transparent 55%), ' +
                    'radial-gradient(circle at 100% 0%, rgba(0,0,0,0.55), transparent 55%), ' +
                    'linear-gradient(135deg, rgba(7,13,25,0.92), rgba(4,17,36,0.96))',
              color: activeThemeId === 'extremeWindows95' ? '#fff' : 'var(--fg-primary, #e9f5ff)',
              padding: '14px 16px 15px 16px',
              backdropFilter: 'blur(22px) saturate(1.6)',
              boxShadow:
                '0 0 0 1px rgba(255,255,255,0.02), 0 26px 60px rgba(0,0,0,0.65), 0 0 35px rgba(0, 255, 213, 0.12)',
              transformOrigin: 'center',
              transition:
                'transform 200ms ease-out, box-shadow 220ms ease-out, border-color 220ms ease-out, background 280ms ease-out',
            }}
          >
            {/* Holographic perimeter glow */}
            <div
              className="roster-holo-perimeter anim-hologram"
              aria-hidden="true"
              style={{
                position: 'absolute',
                inset: '-1px',
                borderRadius: 'inherit',
                border: '1px solid rgba(255,255,255,0.04)',
                boxShadow:
                  '0 0 25px rgba(0,255,183,0.18), 0 0 60px color-mix(in srgb, var(--roster-accent) 55%, transparent)',
                mixBlendMode: 'screen',
                opacity: 0.42,
                pointerEvents: 'none',
              }}
            />

            {/* Animated gradient rim */}
            <div
              className="roster-aurora anim-genome"
              aria-hidden="true"
              style={{
                position: 'absolute',
                inset: '-20%',
                background:
                  'conic-gradient(from 210deg at 50% 50%, ' +
                  'rgba(0,255,213,0.0), rgba(0,255,213,0.48), ' +
                  'rgba(130,180,255,0.35), rgba(255,120,220,0.25), ' +
                  'rgba(0,255,213,0.0))',
                filter: 'blur(26px)',
                opacity: 0.35,
                mixBlendMode: 'screen',
                transform: 'translate3d(0,0,0)',
                pointerEvents: 'none',
              }}
            />

            {/* Floating particle field */}
            <div
              className="roster-particles anim-cloud"
              aria-hidden="true"
              style={{
                position: 'absolute',
                inset: 0,
                overflow: 'hidden',
                pointerEvents: 'none',
                opacity: 0.7,
              }}
            >
              {Array.from({ length: 10 }).map((_, i) => (
                <span
                  key={i}
                  className="roster-particle anim-nexus"
                  style={{
                    position: 'absolute',
                    top: `${8 + (i * 7) % 60}%`,
                    left: `${(i * 13) % 100}%`,
                    width: `${6 + (i % 3) * 4}px`,
                    height: `${6 + (i % 3) * 4}px`,
                    borderRadius: '999px',
                    background:
                      i % 3 === 0
                        ? 'radial-gradient(circle, rgba(0,255,213,0.8), transparent)'
                        : 'radial-gradient(circle, rgba(130,180,255,0.7), transparent)',
                    boxShadow:
                      '0 0 10px rgba(0,255,213,0.8), 0 0 18px rgba(0,255,213,0.4)',
                    animation: `float-pulse-${(i % 4) + 1} 9s linear infinite`,
                    opacity: 0.35 + (i % 4) * 0.1,
                  }}
                />
              ))}
            </div>

            {/* Status halo */}
            <div
              className="roster-status-orbit anim-royal"
              aria-hidden="true"
              style={{
                position: 'absolute',
                top: -8,
                right: -6,
                width: 62,
                height: 62,
                borderRadius: '50%',
                border: '1px solid rgba(255,255,255,0.12)',
                boxShadow:
                  '0 0 12px rgba(0,255,213,0.7), 0 0 26px color-mix(in srgb, var(--roster-accent) 70%, transparent)',
                background:
                  'radial-gradient(circle at 30% 30%, rgba(255,255,255,0.9), transparent 55%)',
                opacity: 0.38,
                transformOrigin: 'center',
                animation: 'roster-orbit 14s linear infinite',
              }}
            />

            {/* Content */}
            <div
              className="roster-inner-shell anim-clean"
              style={{
                position: 'relative',
                display: 'grid',
                gridTemplateColumns: 'auto 1fr auto',
                columnGap: 10,
                alignItems: 'center',
                zIndex: 1,
              }}
            >
              {/* Left accent spine */}
              <div
                className="roster-spine anim-terminal"
                aria-hidden="true"
                style={{
                  width: 3,
                  height: '100%',
                  borderRadius: 999,
                  background:
                    'linear-gradient(to bottom, rgba(0,255,213,0.9), rgba(0,255,213,0))',
                  boxShadow:
                    '0 0 10px rgba(0,255,213,0.8), 0 0 25px color-mix(in srgb, var(--roster-accent) 70%, transparent)',
                }}
              />

              {/* Main content block */}
              <div
                className="roster-main anim-nexus"
                style={{
                  display: 'flex',
                  flexDirection: 'column',
                  gap: 4,
                  transform:
                    activeThemeId === 'layoutDynamicOverlap' ? 'rotate(-1.6deg)' : 'none',
                }}
              >
                <div
                  className="roster-title-row anim-tactical"
                  style={{
                    display: 'flex',
                    alignItems: 'baseline',
                    gap: 8,
                  }}
                >
                  <h3
                    style={{
                      fontSize: 12,
                      letterSpacing: 0.16,
                      textTransform: 'uppercase',
                      fontWeight: 650,
                      color: config.accent,
                      textShadow:
                        '0 0 6px rgba(0,0,0,0.75), 0 0 14px color-mix(in srgb, var(--roster-accent) 80%, transparent)',
                      margin: 0,
                      whiteSpace: 'nowrap',
                    }}
                  >
                    {config.label}
                  </h3>
                  <span
                    className="roster-badge anim-genome"
                    style={{
                      fontSize: 9,
                      letterSpacing: 0.18,
                      textTransform: 'uppercase',
                      padding: '2px 6px',
                      borderRadius: 999,
                      border: '1px solid rgba(255,255,255,0.2)',
                      background:
                        'linear-gradient(135deg, rgba(0,0,0,0.7), rgba(0,0,0,0.15))',
                      boxShadow:
                        '0 0 10px rgba(0,0,0,0.85), 0 0 14px rgba(0,255,213,0.2)',
                      color: 'rgba(240,255,255,0.9)',
                    }}
                  >
                    {config.themeTag}
                  </span>
                </div>

                <p
                  className="roster-subtitle anim-clean"
                  style={{
                    fontSize: 11,
                    color: 'rgba(219,238,255,0.9)',
                    margin: 0,
                  }}
                >
                  {config.subtitle}
                </p>
                <p
                  className="roster-description anim-terminal"
                  style={{
                    fontSize: 10,
                    color: 'rgba(186,210,235,0.85)',
                    margin: 0,
                  }}
                >
                  {config.description}
                </p>
              </div>

              {/* Right status cluster */}
              <div
                className="roster-status anim-tactical"
                style={{
                  display: 'flex',
                  flexDirection: 'column',
                  alignItems: 'flex-end',
                  gap: 4,
                }}
              >
                {/* Active chip */}
                <div
                  className="status-chip anim-nexus"
                  style={{
                    display: 'inline-flex',
                    alignItems: 'center',
                    gap: 4,
                    padding: '2px 7px',
                    borderRadius: 999,
                    background:
                      'linear-gradient(135deg, rgba(0,255,213,0.22), rgba(0,0,0,0.85))',
                    border: '1px solid rgba(0,255,213,0.55)',
                    boxShadow:
                      '0 0 10px rgba(0,255,213,0.75), 0 0 18px rgba(0,255,213,0.4)',
                    transform: 'translateZ(0)',
                  }}
                >
                  <span
                    className="pulse-dot anim-genome"
                    style={{
                      width: 7,
                      height: 7,
                      borderRadius: '50%',
                      background:
                        'radial-gradient(circle, rgba(0,255,213,1), rgba(0,255,213,0.1))',
                      boxShadow:
                        '0 0 5px rgba(0,255,213,1), 0 0 12px rgba(0,255,213,0.6)',
                      animation: 'status-pulse 1.4s ease-out infinite',
                    }}
                  />
                  <span
                    style={{
                      fontSize: 9,
                      textTransform: 'uppercase',
                      letterSpacing: 0.18,
                      color: 'rgba(215,255,250,0.95)',
                    }}
                  >
                    Online
                  </span>
                </div>

                {/* Micro metrics */}
                <div
                  className="status-metrics anim-terminal"
                  style={{
                    display: 'grid',
                    gridTemplateColumns: 'auto auto',
                    gap: '1px 7px',
                    fontSize: 9,
                    color: 'rgba(170,200,225,0.8)',
                  }}
                >
                  <span>Cycle</span>
                  <span
                    style={{
                      color: 'rgba(0,255,213,0.85)',
                      fontVariantNumeric: 'tabular-nums',
                    }}
                  >
                    {String(Math.abs(activeThemeId.length * 17) % 999).padStart(3, '0')}
                  </span>
                  <span>Entropy</span>
                  <span
                    style={{
                      color: 'rgba(255,196,120,0.9)',
                      fontVariantNumeric: 'tabular-nums',
                    }}
                  >
                    {`${(37 + activeThemeId.length * 2) % 100}%`}
                  </span>
                </div>
              </div>
            </div>
          </div>
        );
    }
  };

  return (
    <div
      className="agent-roster-wrapper anim-nexus"
      style={{
        width: '100%',
        marginBottom: '20px',
        perspective: 1300,
      }}
    >
      {renderBot()}
    </div>
  );
}

