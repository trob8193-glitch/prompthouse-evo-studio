import React, { useMemo } from 'react';
import { useSovereignStore } from "../store";

const THEME_META = {
  layoutTerminalFullscreen: {
    label: "👻 GHOST TERMINAL BOT [ACTIVE]",
    subtitle: "Intelligence Core: Root Overwrite Mode.",
    description: "Ready to deploy untethered commands.",
    layoutClass: "terminal nexus anim-terminal anim-nexus",
    accent: "var(--accent-terminal, #00ff9f)",
    themeTag: "TERMINAL ∆ NEXUS",
  },
  layoutCmdCenter: {
    label: "📊 OMNI-DATA AGENT [ACTIVE]",
    subtitle: "Analyzing 12,000 temporal matrices per second.",
    description: "Warning: Extreme data density enabled.",
    layoutClass: "tactical forge anim-tactical anim-forge",
    accent: "var(--accent-tactical, #3af2ff)",
    themeTag: "TACTICAL ∑ FORGE",
  },
  layoutBentoBox: {
    label: "🍏 AESTHETIC UI COPILOT [ACTIVE]",
    subtitle: "Your studio's margins have been perfectly mathematically calculated.",
    description: "Every module snapped to golden macro-units.",
    layoutClass: "royal clean anim-royal anim-clean",
    accent: "var(--accent-royal, #ffb347)",
