import React from 'react';
import { Canvas, useLoader } from '@react-three/fiber';

const neonGradient = `linear-gradient(90deg, rgba(87,242,135,1) 0%, rgba(228,123,228,1) 100%)`;

export default function ScreenTemplate({ title, subtitle, children }) {
  return (
    <div className="screen-template" style={{ animation: 'fadeIn 0.3s ease-out', background: neonGradient }}>
      <header className="screen-header">
        <h1 style={{
          fontSize: 32,
          fontWeight: 900,
          color: '#f8fafc',
          margin: 0,
          letterSpacing: '-0.8px',
          background: 'linear-gradient(to right, rgba(87,242,135,1), rgba(228,123,228,1))',
          WebkitBackgroundClip: 'text',
          WebkitTextFillColor: 'transparent'
        }}>
          {title}
        </h1>
        {subtitle && (
          <p style={{ color: '#64748b', fontSize: 15, marginTop: 6, fontWeight: 500 }}>
            {subtitle}
          </p>
        )}
      </header>

      <div className="screen-content">
        {children}
      </div>

      <Canvas camera={{ position: [0, 0, 2], fov: 70 }}>
        <ambientLight />
        <pointLight position={[10, 10, 10]} color="#ffffff" intensity={0.5} />
        <mesh position={[0, 0, -2]}>
          <boxGeometry args={[2, 2, 2]} />
          <meshBasicMaterial color="#ff6f61" wireframe={true} opacity={0.8} transparent={true} />
        </mesh>
      </Canvas>

      <div className="status-indicator pulse-effect">
        <span>Status: Online</span>
      </div>

      <div className="dynamic-gradient" style={{
        backgroundImage: `linear-gradient(45deg, rgba(255,0,0,0.3), rgba(0,255,0,0.3))`,
        animation: 'gradient 10s ease infinite alternate',
        position: 'absolute',
        top: 0,
        left: 0,
        width: '100%',
        height: '100%'
      }} />
    </div>
  );
}

