import React, { useRef, Suspense, useMemo } from 'react';
import { Canvas, useFrame, useLoader } from '@react-three/fiber';
import { TextureLoader, SRGBColorSpace, DoubleSide, AdditiveBlending, Color } from 'three';

const HoloOrbitParticles = () => {
  const groupRef = useRef();
  const particles = useMemo(() => {
    const arr = [];
    const layers = 4;
    const perLayer = 40;
    for (let l = 0; l < layers; l++) {
      const radius = 1.1 + l * 0.06;
      for (let i = 0; i < perLayer; i++) {
        const angle = (i / perLayer) * Math.PI * 2;
        const tilt = (l / layers) * 0.7 - 0.35;
        arr.push({
          radius,
          angle,
          tilt,
          speed: 0.15 + Math.random() * 0.25 + l * 0.05,
          size: 0.008 + Math.random() * 0.018,
          seed: Math.random() * 100,
        });
      }
    }
    return arr;
  }, []);

  useFrame((state) => {
    if (!groupRef.current) return;
    const t = state.clock.elapsedTime;
    groupRef.current.rotation.y = t * 0.12;
    groupRef.current.rotation.x = Math.sin(t * 0.25) * 0.25;
  });

  return (
    <group ref={groupRef}>
      {particles.map((p, idx) => {
        const t = idx * 0.01;
        const phase = t + p.seed;
        const y = Math.sin(phase + p.tilt) * 0.15;
        const x = Math.cos(phase) * p.radius;
        const z = Math.sin(phase) * p.radius;
        return (
          <mesh key={idx} position={[x, y, z]} scale={p.size}>
            <sphereGeometry args={[1, 8, 8]} />
            <meshBasicMaterial
              color={idx % 3 === 0 ? '#22d3ee' : idx % 3 === 1 ? '#a855f7' : '#22c55e'}
              transparent
              opacity={0.55}
              depthWrite={false}
              blending={AdditiveBlending}
            />
          </mesh>
        );
      })}
    </group>
  );
};

const TigerSphere = () => {
  const sphereRef = useRef();
  const glowRef = useRef();
  const innerGlowRef = useRef();
  const scanRef = useRef();

  const colorMap = useLoader(TextureLoader, '/bots/sovereignty_360.png');
  colorMap.colorSpace = SRGBColorSpace;
  colorMap.repeat.x = 0.5;
  colorMap.offset.x = 0.25;

  useFrame((state) => {
    const t = state.clock.elapsedTime;
    if (sphereRef.current) {
      sphereRef.current.rotation.y -= 0.0045;
      sphereRef.current.rotation.x = Math.sin(t * 0.4) * 0.2;
      sphereRef.current.rotation.z = Math.cos(t * 0.15) * 0.06;
      const wobble = 1 + Math.sin(t * 1.1) * 0.003;
      sphereRef.current.scale.setScalar(wobble);
    }

    if (glowRef.current) {
      const pulse = 1 + Math.sin(t * 2.2) * 0.04;
      glowRef.current.scale.setScalar(pulse);
      glowRef.current.rotation.y = t * 0.08;
    }

    if (innerGlowRef.current) {
      const pulse = 0.98 + Math.sin(t * 3.4) * 0.04;
      innerGlowRef.current.scale.setScalar(pulse);
      innerGlowRef.current.rotation.y = -t * 0.12;
    }

    if (scanRef.current) {
      const scanY = ((t * 0.35) % 2) - 1;
      scanRef.current.position.y = scanY * 0.9;
      const fade = 0.12 + (1 - Math.abs(scanY)) * 0.35;
      scanRef.current.material.opacity = fade;
    }
  });

  return (
    <group>
      {/* OUTER NEXUS GLOW SHELL */}
      <mesh ref={glowRef} scale={1.12}>
        <sphereGeometry args={[1, 64, 64, Math.PI / 2, Math.PI]} />
        <meshBasicMaterial
          color="#a855f7"
          transparent
          opacity={0.18}
          side={DoubleSide}
          blending={AdditiveBlending}
        />
      </mesh>

      {/* INNER GENOME CORE GLOW */}
      <mesh ref={innerGlowRef} scale={0.98}>
        <sphereGeometry args={[1, 64, 64, Math.PI / 2, Math.PI]} />
        <meshBasicMaterial
          color="#22c55e"
          transparent
          opacity={0.12}
          side={DoubleSide}
          blending={AdditiveBlending}
        />
      </mesh>

      {/* MAIN TIGER SPHERE */}
      <mesh ref={sphereRef}>
        <sphereGeometry args={[1, 128, 128, Math.PI / 2, Math.PI]} />
        <meshStandardMaterial
          map={colorMap}
          bumpMap={colorMap}
          bumpScale={0.09}
          emissive={new Color('#f97316')}
          emissiveIntensity={0.08}
          roughness={0.9}
          metalness={0.15}
          transparent
          side={DoubleSide}
        />
      </mesh>

      {/* WIREFRAME OVERLAY SPHERE - TACTICAL GRID */}
      <mesh>
        <sphereGeometry args={[1.005, 42, 42, Math.PI / 2, Math.PI]} />
        <meshBasicMaterial
          color="#c084fc"
          wireframe
          transparent
          opacity={0.09}
          side={DoubleSide}
        />
      </mesh>

      {/* HOLOGRAPHIC SCANLINE (TERMINAL / HOLOGRAM FUSION) */}
      <mesh ref={scanRef} rotation={[0, 0, 0]}>
        <cylinderGeometry args={[0.05, 0.05, 2.1, 32, 1, true]} />
        <meshBasicMaterial
          color="#22d3ee"
          transparent
          opacity={0.22}
          side={DoubleSide}
          blending={AdditiveBlending}
        />
      </mesh>

      {/* ORBITAL PARTICLE HALOS */}
      <HoloOrbitParticles />
    </group>
  );
};

const HoloTigerFiber3D = ({ size = 200 }) => {
  return (
    <div
      className={[
        'pointer-events-none',
        'relative',
        'anim-nexus',
        'anim-terminal',
        'anim-hologram',
      ].join(' ')}
      style={{
        position: 'absolute',
        top: 0,
        left: 0,
        width: size,
        height: size,
        zIndex: 30,
        filter:
          'drop-shadow(0 0 24px rgba(168,85,247,0.9)) drop-shadow(0 0 14px rgba(56,189,248,0.8)) drop-shadow(0 0 10px rgba(74,222,128,0.7))',
        transition: 'transform 260ms ease-out, filter 260ms ease-out',
      }}
    >
      {/* HOLOGRAPHIC OVERLAY RINGS */}
      <div
        className="absolute inset-0 pointer-events-none mix-blend-screen anim-royal"
        style={{
          borderRadius: '999px',
          border: '1px solid rgba(129,140,248,0.45)',
          boxShadow:
            '0 0 22px rgba(129,140,248,0.65), 0 0 40px rgba(168,85,247,0.55), inset 0 0 20px rgba(34,211,238,0.35)',
          maskImage:
            'radial-gradient(circle at 30% 0%, transparent 0, transparent 40%, black 60%, black 100%)',
          animation: 'pulse-hologram 2.6s ease-in-out infinite alternate',
        }}
      />
      <div
        className="absolute inset-3 pointer-events-none anim-cloud"
        style={{
          borderRadius: '999px',
          border: '1px dashed rgba(52,211,153,0.35)',
          opacity: 0.85,
          filter: 'blur(0.4px)',
        }}
      />

      {/* RETRO TERMINAL CORNER ACCENTS */}
      <div
        className="absolute anim-retro"
        style={{
          inset: '12%',
          borderRadius: '24px',
          border: '1px solid rgba(15,23,42,0.0)',
          boxShadow:
            '0 0 0 1px rgba(148,163,184,0.16), 0 0 32px rgba(15,23,42,0.75)',
          mixBlendMode: 'soft-light',
        }}
      />

      <Canvas
        camera={{ position: [0, 0, 2.7], fov: 42 }}
        gl={{ alpha: true, antialias: true, preserveDrawingBuffer: false }}
        style={{
          width: '100%',
          height: '100%',
          background:
            'radial-gradient(circle at 20% 0%, rgba(56,189,248,0.12), transparent 55%), radial-gradient(circle at 80% 100%, rgba(168,85,247,0.18), transparent 60%)',
        }}
        dpr={[1, 2]}
      >
        {/* CLOUD / CLEAN LUMINOSITY */}
        <color attach="background" args={['transparent']} />

        {/* AMBIENT FOG-LIKE LIGHT */}
        <ambientLight intensity={0.45} color="#e5e7eb" />

        {/* KEY LIGHTS - FUSED THEMES */}
        <directionalLight
          position={[3.5, 4.4, 3]}
          intensity={3}
          color="#ffffff"
        />
        <pointLight
          position={[-4.2, 0.3, 2.6]}
          intensity={2}
          color="#a855f7"
          distance={11}
        />
        <pointLight
          position={[0.3, -3.2, -2.2]}
          intensity={1.6}
          color="#22c55e"
          distance={11}
        />
        <pointLight
          position={[0.2, 3.5, -1.2]}
          intensity={1.1}
          color="#f97316"
          distance={12}
        />
        <spotLight
          position={[-1.2, 1.8, 3.2]}
          angle={0.6}
          penumbra={0.4}
          intensity={1.4}
          color="#38bdf8"
        />

        <Suspense fallback={null}>
          <TigerSphere />
        </Suspense>
      </Canvas>
    </div>
  );
};

export default HoloTigerFiber3D;

