{
  "openapi": "3.1.0",
  "info": {
    "title": "PH Evo Studio TriBrain Gateway",
    "version": "1.0.0",
    "description": "GPT Action schema for PH Evo Studio Operator. Replace YOUR_NGROK_URL with the public HTTPS tunnel exposing local port 3001."
  },
  "servers": [
    {
      "url": "https://halloween-import-bufing-nevertheless.trycloudflare.com",
      "description": "Local PromptBridge (Via Cloudflare Tunnel)"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Check whether the PH Evo Studio PromptBridge server is online.",
        "responses": {
          "200": {
            "description": "Server health response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "service": { "type": "string" },
                    "timestamp": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tribrain/status": {
      "get": {
        "operationId": "getTriBrainStatus",
        "summary": "Get PH Evo Studio TriBrain status, enabled brains, capability state, and fallback policy.",
        "responses": {
          "200": {
            "description": "TriBrain status returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericResponse" }
              }
            }
          }
        }
      }
    },
    "/api/tribrain/contract": {
      "get": {
        "operationId": "getTriBrainContract",
        "summary": "Get TriBrain brain IDs, ability classes, and risk levels.",
        "responses": {
          "200": {
            "description": "TriBrain contract returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericResponse" }
              }
            }
          }
        }
      }
    },
    "/api/tribrain/route": {
      "post": {
        "operationId": "routeTriBrainCommand",
        "summary": "Route a command through the TriBrain router and permission policy.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "intent": { "type": "string", "description": "Shortcut intent used when command is omitted." },
                  "command": { "$ref": "#/components/schemas/TriBrainCommand" },
                  "approvals": {
                    "type": "array",
                    "items": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "TriBrain routing plan returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericResponse" }
              }
            }
          }
        }
      }
    },
    "/api/tribrain/final-response": {
      "post": {
        "operationId": "formTriBrainFinalResponse",
        "summary": "Form a proof-aware final response from one or more brain outputs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "$ref": "#/components/schemas/TriBrainCommand" },
                  "responses": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/TriBrainResponse" }
                  },
                  "approvals": {
                    "type": "array",
                    "items": { "type": "object" }
                  }
                },
                "required": ["responses"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Final response returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericResponse" }
              }
            }
          }
        }
      }
    },
    "/api/tribrain/execute-verification": {
      "post": {
        "operationId": "executeRepoVerification",
        "summary": "Execute allowlisted verification commands (read-only) inside the Studio securely.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string" },
                  "approvals": {
                    "type": "array",
                    "items": { "type": "object" }
                  }
                },
                "required": ["command"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proof Ledger receipt containing stdout, stderr, and execution metadata.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericResponse" }
              }
            }
          }
        }
      }
    },
    "/api/tribrain/evo-layer/push": {
      "post": {
        "operationId": "pushToEvoLayer",
        "summary": "Push an approved command package to the Evo Layer.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tenantId",
                  "source",
                  "targetLayer",
                  "intent",
                  "riskLevel",
                  "payload",
                  "proofRequired"
                ],
                "properties": {
                  "tenantId": { "type": "string" },
                  "ownerUserId": { "type": "string" },
                  "source": { "type": "string", "enum": ["ph_evo_studio_trainer", "studio_gateway", "operator_console"] },
                  "targetLayer": { "type": "string", "enum": ["evo_layer"] },
                  "intent": { "type": "string", "enum": ["implement", "verify", "audit", "train", "report", "push"] },
                  "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
                  "requiresApproval": { "type": "boolean", "default": true },
                  "approvalRef": { "type": "string", "description": "Server-side approval reference. Never expose raw secrets." },
                  "payload": { "type": "object", "additionalProperties": true },
                  "proofRequired": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evo Layer accepted, rejected, or completed the command package.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["truthLabel", "status", "receipt"],
                  "properties": {
                    "truthLabel": { "type": "string", "enum": ["VERIFIED", "ACCEPTED", "BLOCKED", "FAILED", "NEEDS_APPROVAL"] },
                    "status": { "type": "string" },
                    "evoCommandId": { "type": "string" },
                    "receipt": {
                      "type": "object",
                      "properties": {
                        "receiptId": { "type": "string" },
                        "timestamp": { "type": "string" },
                        "tenantId": { "type": "string" },
                        "source": { "type": "string" },
                        "targetLayer": { "type": "string" },
                        "riskLevel": { "type": "string" },
                        "proofPath": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/platform-sentinel/status": {
      "get": {
        "operationId": "getPlatformSentinelStatus",
        "summary": "Get Platform Sentinel readiness status without heavy command execution.",
        "responses": {
          "200": {
            "description": "Platform Sentinel status returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericResponse" }
              }
            }
          }
        }
      }
    },
    "/api/platform-sentinel/repair-queue": {
      "get": {
        "operationId": "getPlatformRepairQueue",
        "summary": "Get pending Platform Sentinel repair queue.",
        "responses": {
          "200": {
            "description": "Repair queue returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericResponse" }
              }
            }
          }
        }
      }
    },
    "/api/platform-sentinel/receipts": {
      "get": {
        "operationId": "getPlatformReceipts",
        "summary": "Get recent Platform Sentinel proof receipts.",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10, "minimum": 1, "maximum": 50 }, "required": false }
        ],
        "responses": {
          "200": {
            "description": "Proof receipts returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GenericResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" }
        },
        "additionalProperties": true
      },
      "TriBrainCommand": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "tenantId": { "type": "string" },
          "userId": { "type": "string" },
          "sourceBrain": { "type": "string", "enum": ["studio_brain", "chatgpt_operator_brain", "ide_agent_brain"] },
          "targetBrain": { "type": "string" },
          "intent": { "type": "string" },
          "abilityClass": { "type": "string", "enum": ["summarize", "audit", "plan", "implement", "verify", "report", "remember", "escalate"] },
          "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "requiresApproval": { "type": "boolean" },
          "localAllowed": { "type": "boolean" },
          "fallbackAllowed": { "type": "boolean" },
          "mode": { "type": "string" },
          "payload": { "type": "object", "additionalProperties": true },
          "proofRequired": { "type": "boolean" }
        },
        "required": ["intent", "abilityClass"]
      },
      "TriBrainResponse": {
        "type": "object",
        "properties": {
          "commandId": { "type": "string" },
          "respondingBrain": { "type": "string" },
          "truthState": { "type": "string" },
          "status": { "type": "string" },
          "summary": { "type": "string" },
          "findings": { "type": "array", "items": { "type": "object" } },
          "evidence": { "type": "object", "additionalProperties": true },
          "nextActions": { "type": "array", "items": { "type": "string" } },
          "requiresUserDecision": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  }
}
