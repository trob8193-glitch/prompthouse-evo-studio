    "watchdog:middleend": "node src/core/daemons/watchdogs/MiddleendWatchdog.mjs",
    "watchdog:bridgeend": "node src/core/daemons/watchdogs/BridgeendWatchdog.mjs",
    "watchdog:backend": "node src/core/daemons/watchdogs/BackendWatchdog.mjs",
