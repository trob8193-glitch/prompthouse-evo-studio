    "singularity": "node src/core/daemons/singularity/SingularityCore.mjs",
    "crucible": "node src/core/daemons/crucible/CrucibleDaemon.mjs",
    "convergence:daemon": "node src/core/daemons/convergence/ConvergenceDaemon.mjs",
    "crucible:sweep": "node scripts/crucible-full-sweep.mjs",
    "audit:platform": "node scripts/audit-platform-readiness.mjs",
    "audit:platform:daemon": "node scripts/audit-platform-daemon.mjs",
